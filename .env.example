# Read by `docker-compose.yml` for the `api` service. Copy to `.env` in this
# same directory and fill in real values — this file is not for `pnpm dev`,
# which reads apps/api/.env instead (see apps/api/.env.example).

# Redis password. Compose starts Redis with `--requirepass` and builds the
# API's REDIS_URL from this, so the two cannot drift apart. Change it for any
# deployment where the port is reachable by anything other than this machine:
# what lives in there is the advisory locks that keep two workers off the same
# money, the queue that drives settlement, and the windows that decide whether
# an alert reaches a human.
REDIS_PASSWORD=tutak_dev_password

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SMS delivery. The API refuses to boot without this in production, and this
# compose file always sets NODE_ENV=production — leaving it blank means the
# api container will not start. See apps/api/.env.example for provider notes.
# Which carrier integration to use: `http` posts the rendered message text,
# `viva` drives the Armenian Viva Business Hub, which sends a pre-registered
# template plus its tag values and cannot send free text at all.
SMS_DRIVER=http
# `viva`: the API base URL, https://businesshubapi.viva.am/api/v1
SMS_ENDPOINT=
SMS_AUTH_SCHEME=basic
# `viva`: the partner username (an e-mail address) and password.
SMS_USERNAME=
SMS_TOKEN=
# `viva`: must match a name registered under Templates/Sender name.
SMS_SENDER=TuTak
SMS_ENCODING=form
# `viva` only. Issued by Viva; the template is registered in their profile
# under Templates/Text and must contain one tag, which receives the code.
SMS_VIVA_CLIENT_ID=
SMS_VIVA_CLIENT_SECRET=
SMS_VIVA_TEMPLATE_NAME=
# Unicode. On unless set to 0 — Armenian does not fit GSM-7, and a code
# inside a message the customer cannot read is no use.
SMS_VIVA_SEND_UTF=1

# Where an operator is told that money is at risk (reconciliation drift, a
# dead-lettered outbox event, a background job that stopped working). Any
# endpoint accepting a JSON POST; Slack-style webhooks render the `text`
# field. Blank means those events are logged and nobody is told.
ALERT_WEBHOOK_URL=

# Two-person rule on payouts (see apps/api/.env.example). Leave true unless
# your operation genuinely has a single finance operator.
PAYOUT_DUAL_CONTROL=true

# Prometheus scrape token. Unset disables /metrics entirely (it never falls
# back to open — those numbers are the business).
METRICS_TOKEN=
