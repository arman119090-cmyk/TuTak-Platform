# Read by `docker-compose.yml` for the `api` service. Copy to `.env` in this
# same directory and fill in real values — this file is not for `pnpm dev`,
# which reads apps/api/.env instead (see apps/api/.env.example).

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SMS delivery. The API refuses to boot without this in production, and this
# compose file always sets NODE_ENV=production — leaving it blank means the
# api container will not start. See apps/api/.env.example for provider notes.
SMS_ENDPOINT=
SMS_AUTH_SCHEME=basic
SMS_USERNAME=
SMS_TOKEN=
SMS_SENDER=TuTak
SMS_ENCODING=form

# Where an operator is told that money is at risk (reconciliation drift, a
# dead-lettered outbox event, a background job that stopped working). Any
# endpoint accepting a JSON POST; Slack-style webhooks render the `text`
# field. Blank means those events are logged and nobody is told.
ALERT_WEBHOOK_URL=

# Two-person rule on payouts (see apps/api/.env.example). Leave true unless
# your operation genuinely has a single finance operator.
PAYOUT_DUAL_CONTROL=true

# Prometheus scrape token. Unset disables /metrics entirely (it never falls
# back to open — those numbers are the business).
METRICS_TOKEN=
