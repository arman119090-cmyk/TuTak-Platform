# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local
!.env.example

# Expo / React Native
apps/mobile/.expo/
apps/mobile/.expo-shared/
apps/mobile/ios/
apps/mobile/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Testing / coverage
coverage/

# Prisma
apps/api/generated/

# Misc
*.pem
.eslintcache

# Generated preview harness bundle
tools/preview/mobile/bundle.js

# Redis snapshot, written where redis-server happens to be started
dump.rdb

# Playwright session state and artifacts from the e2e suite.
tests/e2e/.auth/
test-results/
playwright-report/

# Local database dumps. Never committed — a dump carries every phone
# number and password hash on the platform.
backups/

# Objects written by the local-disk MediaStorage driver
# (MEDIA_STORAGE_LOCAL_ROOT, development only — see
# apps/api/src/infrastructure/media/media-storage.module.ts). These are real
# uploaded partner logos and customer avatars: developer-machine data that
# does not belong in the repository, and a directory production is refused
# permission to use at all.
apps/api/.media-storage/

# Viva gateway: anything holding the IPsec PSK or the gateway secret.
infra/viva-gateway/**/*.secret
infra/viva-gateway/**/viva-secret.conf
infra/viva-gateway/**/gateway.env
