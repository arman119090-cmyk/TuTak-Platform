NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Sentry — all optional. Leave unset locally; Sentry stays off with no DSN.
# See docs/SENTRY_SETUP.md for the full list, including CI/build-time-only
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN used for source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Non-production only — required in addition to NODE_ENV!=production to
# enable GET /api/internal/sentry-verify.
SENTRY_VERIFY_ENABLED=
