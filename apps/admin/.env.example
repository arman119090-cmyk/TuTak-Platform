NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Sentry — all optional. Leave unset locally; Sentry stays off with no DSN.
# See docs/SENTRY_SETUP.md for the full list, including CI/build-time-only
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN used for source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Non-production only. All three are runtime variables (never build args)
# and all three must be set for POST /api/internal/sentry-verify to answer
# anything but 404. APP_ENV must be exactly development, staging or preview.
# SENTRY_VERIFY_TOKEN is a SECRET — generate one with `openssl rand -hex 32`,
# put it in the deployment's secret storage, and never in this file.
APP_ENV=
SENTRY_VERIFY_ENABLED=
SENTRY_VERIFY_TOKEN=
