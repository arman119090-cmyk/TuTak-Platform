NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://tutak:tutak_dev_password@localhost:5432/tutak?schema=public
REDIS_URL=redis://localhost:6379

# Recurring work (settlement, bonus promotion and expiry, EV cleanup, nightly
# reconciliation) runs on a BullMQ worker. Leave SWEEPS_ENABLED on: with it
# off, nothing settles and no customer's points ever become spendable. Set
# QUEUE_PREFIX per environment when several share one Redis, or staging will
# drain production's jobs.
SWEEPS_ENABLED=true
QUEUE_PREFIX=tutak

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=30d

BONUS_PENDING_HOURS=48
BONUS_EXPIRY_MONTHS=12
BONUS_RESERVATION_HOLD_SECONDS=300
REFERRAL_REWARD_AMOUNT=1000

# Bootstrap credential for the seeded super-admin. Required by `prisma:seed`,
# minimum 12 characters. The account is created with mustChangePassword set,
# so this password can log in and rotate itself and do nothing else.
SEED_ADMIN_PASSWORD=

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SMS delivery. Required in production — the API refuses to boot without it,
# because a deployment that silently logs verification codes looks healthy
# while every user who needs one is locked out.
#   Twilio:  endpoint=https://api.twilio.com/2010-04-01/Accounts/<SID>/Messages.json
#            auth=basic, username=<SID>, token=<auth token>, encoding=form
#   Others:  auth=bearer, token=<api key>, encoding=json
SMS_ENDPOINT=
SMS_AUTH_SCHEME=basic
SMS_USERNAME=
SMS_TOKEN=
SMS_SENDER=TuTak
SMS_ENCODING=form

# Future OCPI / FastCharge roaming credentials (left blank until partner is connected)
OCPI_PARTY_ID=TTK
OCPI_COUNTRY_CODE=AM
OCPI_TOKEN=
OCPI_BASE_URL=

# Phase 4 of docs/FINANCIAL_CORE_DESIGN.md. Mirrors QR redemptions into the
# double-entry ledger alongside the existing path, which stays authoritative.
# Additive and never fatal: a mirror failure is logged, not surfaced.
#
# Leave off until you are ready to start the dual-write period, and only make
# the ledger the source of truth after reconciliation has run clean across a
# full settlement cycle.
FEATURE_QR_LEDGER_MIRROR=false

# Push notifications (Expo). Off by default so local development needs no
# Expo project; production refuses to boot without it — see PushModule.
PUSH_ENABLED=false
PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
# Only needed once the Expo project turns on enhanced security.
PUSH_ACCESS_TOKEN=

# Distributed tracing (OpenTelemetry). Off unless an endpoint is set —
# unlike SMS and push, a missing collector does not stop the process: an
# observability gap is visible to the operator, an outage is visible to
# every customer.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=tutak-api
OTEL_DEBUG=false

# Where an operator is told that money is at risk. A Slack/Mattermost/Discord
# incoming webhook, or anything that accepts a JSON POST. Three events reach
# it: reconciliation found a discrepancy, an outbox event gave up, a
# background job stopped working. Without it those are logged and nothing
# more — the API still boots, but nobody is told. Set it before taking real
# money.
ALERT_WEBHOOK_URL=

# Two-person rule on payouts. On unless explicitly set to false: confirming a
# payout must be done by someone other than the admin who requested it, so a
# single compromised account cannot move a partner's money out and mark the
# transfer settled. Set to false only if your finance process genuinely has
# one person — with one operator the rule cannot be satisfied and every payout
# would be stuck at REQUESTED.
PAYOUT_DUAL_CONTROL=true

# Prometheus scrape token. The /metrics endpoint serves the operating figures
# of the business — revenue per hour, outstanding liability, how much is in
# clearing — so it is gated on a shared bearer token and refuses outright when
# this is unset rather than falling back to open. Generate with
# `openssl rand -hex 32` and put it in the scraper's config as a bearer token.
METRICS_TOKEN=

# Ceiling on a single manual bonus adjustment, in points. A goodwill credit is
# normally a few thousand; a million is far beyond any plausible correction,
# which makes it a useful place to stop. It exists because points are a
# liability the business owes, and this is the only path where a
# caller-supplied number becomes points with nothing else bounding it — one
# fat-fingered extra three zeros, or one stolen admin session, and the balance
# sheet has a hole in it. Raise it deliberately if a larger correction is
# genuinely needed.
BONUS_MANUAL_ADJUSTMENT_MAX=1000000
