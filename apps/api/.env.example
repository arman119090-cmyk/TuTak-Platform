NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://tutak:tutak_dev_password@localhost:5432/tutak?schema=public
# Optional. Unset, Prisma sizes its own pool (num_cpus * 2 + 1 per process),
# which is per-process and machine-dependent — see docs/DEPLOYMENT.md for the
# arithmetic a horizontally scaled deployment has to do instead.
DATABASE_CONNECTION_LIMIT=
DATABASE_POOL_TIMEOUT=
# The password goes after the colon, with no username: `redis://:PASSWORD@host:6379`.
# docker-compose.yml starts Redis with `--requirepass` and this default, so an
# unauthenticated URL will be refused. Set REDIS_PASSWORD in your .env to change
# both at once. Redis holds the advisory locks that keep two workers off the
# same money and the queue that drives settlement — it is not a cache here.
REDIS_URL=redis://:tutak_dev_password@localhost:6379

# Recurring work (settlement, bonus promotion and expiry, EV cleanup, nightly
# reconciliation) runs on a BullMQ worker. Leave SWEEPS_ENABLED on: with it
# off, nothing settles and no customer's points ever become spendable. Set
# QUEUE_PREFIX per environment when several share one Redis, or staging will
# drain production's jobs.
SWEEPS_ENABLED=true
QUEUE_PREFIX=tutak

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=30d

BONUS_PENDING_HOURS=48
BONUS_EXPIRY_MONTHS=12
BONUS_RESERVATION_HOLD_SECONDS=300
REFERRAL_REWARD_AMOUNT=1000

# Bootstrap credential for the seeded super-admin. Required by `prisma:seed`,
# minimum 12 characters. The account is created with mustChangePassword set,
# so this password can log in and rotate itself and do nothing else.
SEED_ADMIN_PASSWORD=

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Left unset by default: req.ip is the real TCP peer address, which a client
# cannot spoof, and every rate limit (login, OTP, password reset) keys on it
# correctly. Set this ONLY if a real reverse proxy/load balancer sits in
# front of this process and strips any inbound X-Forwarded-For before
# appending its own — then name that proxy specifically: an IP, a CIDR
# subnet, a comma-separated list, or one of Express's named subnets
# (loopback, linklocal, uniquelocal). Never set this to a bare hop count
# ("1") — that trusts whichever address is topologically closest rather than
# a specific, known proxy, which is exactly as spoofable as trusting nothing
# when no such proxy actually exists in front of this deployment.
# Which deployment this is. NODE_ENV stays `production` for anything
# deployed; APP_ENV says whether that deployment is staging or production.
APP_ENV=development

# Where req.ip comes from: `socket` (default, unspoofable, but identical for
# every caller behind a load balancer) or `xff-depth`. For xff-depth the hop
# count must be measured against the live deployment — see
# docs/RENDER_STAGING_RU.md. Express counts the socket as hop 1, so a service
# behind exactly one appending balancer uses 1.
CLIENT_IP_STRATEGY=
CLIENT_IP_TRUSTED_HOPS=

# Platform-wide SMS ceilings, across every flow. Sending fails closed if
# Redis cannot be reached, so these bound the carrier bill absolutely.
SMS_GLOBAL_MAX_PER_HOUR=500
SMS_GLOBAL_MAX_PER_DAY=5000

TRUST_PROXY=

# SMS delivery. Required in production — the API refuses to boot without it,
# because a deployment that silently logs verification codes looks healthy
# while every user who needs one is locked out.
#   Twilio:  endpoint=https://api.twilio.com/2010-04-01/Accounts/<SID>/Messages.json
#            auth=basic, username=<SID>, token=<auth token>, encoding=form
#   Others:  auth=bearer, token=<api key>, encoding=json
SMS_ENDPOINT=

# ── Viva Business Hub (Armenia) ─────────────────────────────────────────
#
# Turned on by SMS_DRIVER=viva and by nothing else: with the driver unset,
# every value below is inert and no message reaches a carrier. That is what
# keeps a development machine and a test run from sending a real SMS.
#
# The sender name and the template must already exist in the Viva profile
# (Templates/Sender name and Templates/Text). Both values below are the ones
# a delivered message was sent with — do not change them without agreeing a
# new template with Viva first.
#
# The password and the client secret are secrets. They belong in the
# deployment's variable store, never in this file, a commit or a log.
VIVA_API_BASE_URL=https://businesshubapi.viva.am/api/v1
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_USERNAME=
VIVA_PASSWORD=
VIVA_SENDER_NAME=Tu-Tak
VIVA_OTP_TEMPLATE_NAME=Tu-Tak2

# Optional, and both already correct for the approved template:
#   SMS_VIVA_NUMBER_FORMAT   national | msisdn | e164   (default: national —
#                            the eight-digit local form Viva delivered to)
#   SMS_VIVA_SEND_UTF        1 to request Unicode       (default: off, which
#                            is what the approved template was sent with)
#   SMS_VIVA_TOKEN_PLACEMENT bearer | header:<N> | body:<f> | query:<p>
#   SMS_VIVA_GATEWAY_SECRET  set only when VIVA_API_BASE_URL points at the
#                            Contabo gateway rather than at Viva directly
SMS_AUTH_SCHEME=basic
SMS_USERNAME=
SMS_TOKEN=
SMS_SENDER=TuTak
SMS_ENCODING=form

# Future OCPI roaming credentials (left blank until partner is connected)
OCPI_PARTY_ID=TTK
OCPI_COUNTRY_CODE=AM
OCPI_TOKEN=
OCPI_BASE_URL=

# Phase 4 of docs/FINANCIAL_CORE_DESIGN.md. Mirrors QR redemptions into the
# double-entry ledger alongside the existing path, which stays authoritative.
# Additive and never fatal: a mirror failure is logged, not surfaced.
#
# Leave off until you are ready to start the dual-write period, and only make
# the ledger the source of truth after reconciliation has run clean across a
# full settlement cycle.
FEATURE_QR_LEDGER_MIRROR=false

# The legacy card-payment/PSP subsystem (PaymentsModule: /payments,
# /refunds). The canonical TuTak model never charges the customer's card —
# the customer pays the partner directly, outside TuTak — so canonical
# production has no acquirer relationship and does not need this to boot.
#
# Off by default: when off, /payments and /refunds simply do not exist as
# routes. Turning it on in production still goes through PaymentsModule's
# own guard, which refuses to boot without a real PSP adapter (or
# DEMO_MODE=true).
CARD_PAYMENTS_ENABLED=false

# The in-TuTak payment route (PaymentRoute.TUTAK_PSP): the customer pays
# inside TuTak through a licensed provider, TuTak owes the partner the net
# amount, and that is paid out against a settlement document.
#
# A separate flag from CARD_PAYMENTS_ENABLED above, deliberately: that one
# governs the legacy acquirer surface the canonical model never used, and
# this one governs a route that changes who owes whom. Off in production
# until Arman decides otherwise (15.09.2026) — the Idram integration is
# written against published documentation and has never run against the
# real provider.
TUTAK_PSP_ENABLED=false
IDRAM_MERCHANT_ID=
IDRAM_SECRET_KEY=

# Returning money for a purchase the provider collected.
#
# Off until Idram's refund/reversal API is confirmed to exist. Arman's
# decision of 15.09.2026 rules out both workarounds by name: no routine
# manual bank refund (it leaves no provider record tying the return to the
# original payment), and no refunding in bonus points (the customer paid
# real money). Turning this on is not sufficient by itself — the adapter's
# own `capabilities.refund` must also be true, so a flag cannot conjure an
# API that does not exist.
PSP_REFUNDS_ENABLED=false

# How long an unanswered payment attempt may sit before the platform stops
# presenting its bill as payable, and how often it is escalated after that.
#
# Neither number ever decides anything. Passing the stale threshold moves an
# attempt to EXPIRED, which still means "the provider may hold the money" —
# the purchase stays blocked and a new payment is still refused. Only the
# provider's own answer, or two people reading its statement, resolves one.
# Time makes it louder; it never makes it safe.
PSP_STALE_AFTER_MS=1800000
PSP_ESCALATE_EVERY_MS=3600000
# Per-provider overrides, keyed by the adapter's name:
#   PSP_TIMEOUT_POLICY='{"idram":{"staleAfterMs":900000}}'
PSP_TIMEOUT_POLICY=

# Push notifications (Expo). Off by default so local development needs no
# Expo project; production refuses to boot without it — see PushModule.
PUSH_ENABLED=false
PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
# Only needed once the Expo project turns on enhanced security.
PUSH_ACCESS_TOKEN=

# Distributed tracing (OpenTelemetry). Off unless an endpoint is set —
# unlike SMS and push, a missing collector does not stop the process: an
# observability gap is visible to the operator, an outage is visible to
# every customer.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=tutak-api
OTEL_DEBUG=false

# Error monitoring (Sentry). Off unless a DSN is set — same posture as OTel
# above. Complements tracing and the alert webhook, never replaces them; see
# docs/SENTRY_SETUP.md. GIT_COMMIT_SHA is the release tag shared with the
# other three apps — CI sets it; GITHUB_SHA is used as a fallback.
SENTRY_DSN=
GIT_COMMIT_SHA=

# Where an operator is told that money is at risk. A Slack/Mattermost/Discord
# incoming webhook, or anything that accepts a JSON POST. Three events reach
# it: reconciliation found a discrepancy, an outbox event gave up, a
# background job stopped working. Without it those are logged and nothing
# more — the API still boots, but nobody is told. Set it before taking real
# money.
ALERT_WEBHOOK_URL=

# Two-person rule on payouts. On unless explicitly set to false: confirming a
# payout must be done by someone other than the admin who requested it, so a
# single compromised account cannot move a partner's money out and mark the
# transfer settled. Set to false only if your finance process genuinely has
# one person — with one operator the rule cannot be satisfied and every payout
# would be stuck at REQUESTED.
PAYOUT_DUAL_CONTROL=true

# Prometheus scrape token. The /metrics endpoint serves the operating figures
# of the business — revenue per hour, outstanding liability, how much is in
# clearing — so it is gated on a shared bearer token and refuses outright when
# this is unset rather than falling back to open. Generate with
# `openssl rand -hex 32` and put it in the scraper's config as a bearer token.
METRICS_TOKEN=

# Ceiling on a single manual bonus adjustment, in points. A goodwill credit is
# normally a few thousand; a million is far beyond any plausible correction,
# which makes it a useful place to stop. It exists because points are a
# liability the business owes, and this is the only path where a
# caller-supplied number becomes points with nothing else bounding it — one
# fat-fingered extra three zeros, or one stolen admin session, and the balance
# sheet has a hole in it. Raise it deliberately if a larger correction is
# genuinely needed.
BONUS_MANUAL_ADJUSTMENT_MAX=1000000

# ---------------------------------------------------------------------------
# Everything else configuration.ts reads (defaults apply when unset).
# Listed so a search of this file finds every name the API understands;
# the meaning and validation of each live next to its use in
# src/config/configuration.ts. Generated by the 2026-09-19 project audit.
# ---------------------------------------------------------------------------
# ACCOUNT_DELETION_GRACE_DAYS=  # default: '30'
# CUSTOMER_PREPAID_TOPUP_ENABLED=
# DEFERRED_BONUS_REQUIRED_TURNOVER=  # default: '54000'
# DEFERRED_BONUS_WINDOW_MONTHS=  # default: '3'
# DEMO_MODE=
# IDRAM_FORM_ACTION=  # default: ''
# IDRAM_LANGUAGE=  # default: 'AM'
# JWT_ACCESS_SECRET_PREVIOUS=  # default: ''
# MEDIA_PUBLIC_BASE_URL=  # default: `http://localhost:${process.env.PORT ?? '4000'}`
# MEDIA_SIGNED_URL_TTL_SECONDS=  # default: '43200'
# MEDIA_STORAGE_DRIVER=
# MEDIA_STORAGE_LOCAL_ROOT=  # default: '.media-storage'
# MEDIA_STORAGE_S3_ACCESS_KEY_ID=  # default: ''
# MEDIA_STORAGE_S3_BUCKET=  # default: ''
# MEDIA_STORAGE_S3_ENDPOINT=  # default: ''
# MEDIA_STORAGE_S3_FORCE_PATH_STYLE=
# MEDIA_STORAGE_S3_REGION=  # default: 'us-east-1'
# MEDIA_STORAGE_S3_SECRET_ACCESS_KEY=  # default: ''
# PURCHASE_INTENT_TIMEOUT_SECONDS=  # default: '180'
# PURCHASE_POOL_DEFERRED_BPS=  # default: '3000'
# PURCHASE_POOL_GREEN_BPS=  # default: '2000'
# PURCHASE_POOL_REFERRER_L1_BPS=  # default: '1000'
# PURCHASE_POOL_REFERRER_L2_BPS=  # default: '500'
# PURCHASE_POOL_REFERRER_L3_BPS=  # default: '500'
# PURCHASE_POOL_TUTAK_BPS=  # default: '3000'
# REFERRAL_CHALLENGE_QUALIFICATION_AMOUNT=  # default: '10000'
# REFERRAL_CHALLENGE_REWARD_AMOUNT=  # default: '1000'
# REFERRAL_CHALLENGE_SLOT_LIMIT=  # default: '3'
# RETENTION_CHALLENGE_DAYS=  # default: '30'
# RETENTION_IDEMPOTENCY_DAYS=  # default: '180'
# RETENTION_NOTIFICATION_DAYS=  # default: '90'
# RETENTION_OUTBOX_DAYS=  # default: '90'
# RETENTION_QR_CODE_DAYS=  # default: '90'
# RETENTION_SESSION_DAYS=  # default: '90'
# SMS_DRIVER=
# SMS_VIVA_CLIENT_ID=
# SMS_VIVA_CLIENT_SECRET=
# SMS_VIVA_GATEWAY_SECRET=  # default: ''
# SMS_VIVA_NUMBER_FORMAT=  # default: 'national'
# SMS_VIVA_SEND_UTF=
# SMS_VIVA_TEMPLATE_NAME=
# SMS_VIVA_TOKEN_PLACEMENT=  # default: 'bearer'

# ---------------------------------------------------------------------------
# Limited-pilot readiness (PR #58): human alert channel and OTP ceilings.
# ---------------------------------------------------------------------------
# Telegram alert channel — delivered only on a 2xx with ok:true. Either this
# pair or ALERT_WEBHOOK_URL (or both); TUTAK_PSP_ENABLED=true requires at
# least one channel. The token is never logged.
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# Serve /legal/privacy and /legal/account-deletion from apps/api/public/legal.
# Off (404) until the pages are final.
# LEGAL_PAGES_ENABLED=false
# Per-IP OTP ceilings, overridable without a deploy; capped at 10× default.
# OTP_IP_ISSUANCE_PER_HOUR=
# OTP_IP_VERIFICATION_PER_HOUR=
