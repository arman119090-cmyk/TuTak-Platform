// TuTak Platform — Production Data Model
// Design principles:
//  - No duplicated business data: materialized balances on Wallet are a
//    read-optimized cache over the append-only BonusLedgerEntry log, always
//    rewritten inside the same DB transaction as the ledger write.
//  - Money uses Decimal, never Float.
//  - Every state-changing action produces an AuditLog row.
//  - Soft delete (deletedAt) on identity-bearing tables so history stays intact.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity, RBAC, Sessions
// ─────────────────────────────────────────────────────────────────────────

enum RoleName {
  CUSTOMER
  /// Cashier tier, in the sense of docs/CORE_ARCHITECTURE_MIGRATION_2026-08.md
  /// §3 — minimal operational access, cannot touch commercial configuration.
  PARTNER_STAFF
  /// New tier between STAFF and OWNER: broader day-to-day operational access
  /// (issuing, EV station operation, analytics) but — like STAFF — no
  /// PARTNER_MANAGE, so no route to the negotiated rate or the bonus-payment
  /// cap. Only PARTNER_OWNER can touch those.
  PARTNER_MANAGER
  PARTNER_OWNER
  ADMIN
  SUPER_ADMIN
}

enum PermissionName {
  WALLET_READ
  WALLET_WRITE
  BONUS_RULE_MANAGE
  PARTNER_MANAGE
  PARTNER_TRANSACTIONS_READ
  USER_MANAGE
  ADMIN_AUDIT_READ
  EV_STATION_MANAGE
  QR_ISSUE
  QR_REDEEM
  ANALYTICS_READ
  /// Issue refunds against captured payments. Separate from PARTNER_MANAGE
  /// on purpose: managing a partner's details and moving money back out of
  /// their balance are different levels of trust.
  PAYMENT_REFUND
  /// Request, confirm and fail payouts to partner bank accounts.
  PAYOUT_MANAGE
  /// Read the double-entry ledger and reconciliation results. Read-only, but
  /// it exposes every account on the platform, so it is not given out with
  /// ordinary analytics access.
  LEDGER_READ
  /// Confirm or reject a PurchaseIntent on behalf of a partner. Deliberately
  /// separate from PARTNER_MANAGE: every tier of staff (owner, manager,
  /// cashier) does this as their ordinary job, while only PARTNER_MANAGE
  /// reaches the negotiated rate and the bonus-payment cap.
  PURCHASE_INTENT_CONFIRM
  /// Start and inspect provider payments, and read their state. Held by the
  /// customer's own routes implicitly (ownership is checked in the service);
  /// this one is for staff and admin surfaces.
  PSP_READ
  /// Resolve a payment nobody can account for: propose or confirm a manual
  /// reconciliation. Finance only — the two halves are separate acts by
  /// separate people, and this permission gates both.
  PSP_RECONCILE
  /// Draft, ready, approve and record transfers on a partner settlement.
  SETTLEMENT_MANAGE
  /// Read a settlement and its itemisation. A partner holds this for their
  /// own settlements; finance holds it for everyone's.
  SETTLEMENT_READ
  /// Propose a change to a partner's commercial terms.
  CONTRIBUTION_RULE_PROPOSE
  /// Approve or reject somebody else's proposal. Deliberately a different
  /// permission from proposing, so "two people" can be enforced by role and
  /// not only by comparing user ids.
  CONTRIBUTION_RULE_APPROVE
  /// Record that the acquirer actually settled money into the bank.
  ACQUIRER_SETTLEMENT_MANAGE
  /// Read the liquidity position: cash, receivables, payables, exposure.
  TREASURY_READ
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  userRoles   UserRole[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        PermissionName   @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A user's role, optionally scoped to a partner (e.g. PARTNER_STAFF at partner X).
/// Global roles (CUSTOMER, ADMIN, SUPER_ADMIN) leave partnerId null.
model UserRole {
  id          String   @id @default(uuid())
  userId      String
  roleId      String
  partnerId   String?
  /// Fuel-station branches task: an explicit, owner/admin-granted exception
  /// to branch scoping — this role holder may act at every branch of
  /// `partnerId`, the same reach `PARTNER_OWNER` always has, without being
  /// the owner. Meaningless (and always false) for a role with no
  /// `partnerId`, and for `PARTNER_OWNER` itself, which already has this
  /// reach unconditionally — see `hasBranchScope`. Defaults false so every
  /// existing row — every role granted before branch scoping existed — is
  /// *not* silently promoted to all-branch access; see the migration doc
  /// for why an unassigned `PARTNER_STAFF`/`PARTNER_MANAGER` instead lands
  /// in a restricted "no branch yet" state.
  allBranches Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  partner     Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, roleId, partnerId])
  @@index([userId])
  @@map("user_roles")
}

model User {
  id                 String    @id @default(uuid())
  phone              String    @unique
  email              String?   @unique
  passwordHash       String
  firstName          String
  lastName           String
  locale             String    @default("hy")
  isPhoneVerified    Boolean   @default(false)
  isActive           Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  /// Set when a credential was issued by someone other than the account
  /// owner (seeding, an operator reset). Login succeeds but every other
  /// route is refused until the password is changed, so a bootstrap
  /// credential can never become a working one.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// When the customer asked to be deleted. Access ends at this instant —
  /// every auth path already refuses on it. The personal data survives until
  /// `anonymizedAt`, because a refund or a chargeback can still arrive
  /// against a payment made before this moment and has to post somewhere.
  deletedAt          DateTime?
  /// When the personal fields were actually scrubbed. Set by the
  /// `account.anonymize-deleted` sweep once the grace window has elapsed;
  /// the row itself is never removed, because the ledger postings and audit
  /// entries that reference it must not be.
  anonymizedAt       DateTime?

  /// The customer's current avatar, or null. Optional forever — spec §1.2:
  /// initials/the neutral mark remain the fallback everywhere, and every
  /// account that predates the media migration keeps working untouched.
  avatarAssetId                      String?
  /// Spec §1.4 / §3.3: whether this person agreed to their avatar being
  /// rendered in their *direct* referrer's Level-1 list. Default false, and
  /// it controls nothing else — no Level-2/3 surface, no partner-facing
  /// list, and no admin response ever reads it as permission to expose an
  /// avatar.
  avatarConsentReferralList          Boolean @default(false)
  /// 2026-08-26: whether this customer opted in to seeing nearby partners
  /// ranked by their own purchase history (which categories they actually
  /// spend in, computed on demand from `Transaction` — nothing new is
  /// collected or stored here beyond this one flag). Default false: this is
  /// behavioural personalisation, not just a display preference, and it
  /// stays off until the customer actively turns it on — same consent
  /// posture as `avatarConsentReferralList` above. Toggling takes effect on
  /// the very next `GET /partners/nearby` call; nothing caches the decision.
  personalizedRecommendationsConsent Boolean @default(false)

  roles                     UserRole[]
  wallet                    Wallet?
  devices                   Device[]
  refreshTokens             RefreshToken[]
  transactions              Transaction[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  issuedQrCodes             QrCode[]                       @relation("QrIssuedBy")
  partnerMembership         PartnerMembership[]
  referralCode              ReferralCode?
  referralsMade             ReferralInvite[]               @relation("Referrer")
  referredBy                ReferralInvite?                @relation("Referee")
  deferredBonusLots         DeferredBonusLot[]
  challengesReferred        ReferralChallengeParticipant[] @relation("ChallengeReferrer")
  challengeParticipation    ReferralChallengeParticipant?  @relation("ChallengeReferee")
  purchaseIntentsAsCustomer PurchaseIntent[]               @relation("PurchaseIntentCustomer")
  claimedCheckouts          PartnerCheckout[]              @relation("PartnerCheckoutClaimedBy")
  purchaseIntentsConfirmed  PurchaseIntent[]               @relation("PurchaseIntentConfirmedBy")
  purchaseIntentsRejected   PurchaseIntent[]               @relation("PurchaseIntentRejectedBy")
  refundRequestsMade        PurchaseIntentRefundRequest[]  @relation("RefundRequestRequestedBy")
  refundRequestsDecided     PurchaseIntentRefundRequest[]  @relation("RefundRequestDecidedBy")
  branchStaffAssignments    PartnerBranchStaffAssignment[]
  branchStaffAssigned       PartnerBranchStaffAssignment[] @relation("BranchStaffAssignedBy")
  branchStaffDeactivated    PartnerBranchStaffAssignment[] @relation("BranchStaffDeactivatedBy")
  branchQrCodesIssued       PartnerBranchQrCode[]          @relation("BranchQrIssuedBy")
  branchQrCodesRevoked      PartnerBranchQrCode[]          @relation("BranchQrRevokedBy")
  evSessions                EvSession[]
  evReservations            EvReservation[]
  roamingCustomerLinks      RoamingCustomerLink[]
  fraudSignals              FraudSignal[]
  passwordResets            PasswordResetToken[]
  phoneVerifications        PhoneVerificationToken[]
  payments                  Payment[]
  legalConsents             LegalConsentRecord[]
  balanceTopUps             BalanceTopUp[]

  avatarAsset         MediaAsset?  @relation("UserAvatarAsset", fields: [avatarAssetId], references: [id])
  mediaAssets         MediaAsset[] @relation("MediaAssetSubjectUser")
  mediaAssetsUploaded MediaAsset[] @relation("MediaAssetUploader")
  mediaAssetsApproved MediaAsset[] @relation("MediaAssetApprover")

  partnerEmployeeCodes PartnerEmployee[]

  @@index([createdAt])
  /// The anonymisation sweep asks for "deleted, not yet scrubbed", which is a
  /// vanishing fraction of the table and would otherwise scan all of it every
  /// hour.
  @@index([deletedAt, anonymizedAt])
  @@map("users")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model Device {
  id         String         @id @default(uuid())
  userId     String
  deviceId   String
  platform   DevicePlatform
  deviceName String?
  pushToken  String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("devices")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  deviceId          String
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// A single-use phone-ownership challenge.
///
/// Same shape and same reasoning as PasswordResetToken: only the hash is
/// stored, attempts are counted, and the row is consumed on use. Kept as a
/// separate table because the two have different lifetimes and different
/// abuse profiles — a verification code is issued to someone who has just
/// registered, a reset code to someone who may not control the account.
model PhoneVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("phone_verification_tokens")
}

/// A single-use password reset challenge.
///
/// Only the hash is stored, exactly as for refresh tokens: a database dump
/// must not hand the attacker a working reset for every pending request.
/// Rows are consumed on use and swept once expired.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  /// SHA-256 of the code delivered to the user. Never the code itself.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum AuthOtpPurpose {
  REGISTER
  LOGIN
}

/// A single-use OTP challenge for phone-first auth.
///
/// Keyed by phone, not userId — unlike PhoneVerificationToken and
/// PasswordResetToken, this has to work for REGISTER before any User row
/// exists. LOGIN reuses the same table rather than a second one because the
/// challenge/consume/rate-limit shape is identical either way; `purpose`
/// keeps a REGISTER code from being replayable as a LOGIN code and vice
/// versa on the same number.
model AuthOtpToken {
  id         String         @id @default(uuid())
  phone      String
  purpose    AuthOtpPurpose
  /// SHA-256 of the code delivered to the user. Never the code itself.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int            @default(0)
  createdAt  DateTime       @default(now())

  @@index([phone, purpose, consumedAt])
  @@index([expiresAt])
  @@map("auth_otp_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Wallet & Bonus Engine (event-sourced ledger with FIFO-expiring lots)
// ─────────────────────────────────────────────────────────────────────────

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  // Materialized, read-optimized cache — always recomputed transactionally
  // alongside the ledger/lot writes that back it. Source of truth is
  // BonusLot + BonusReservation + BonusLedgerEntry below.
  availableBonus Decimal  @default(0) @db.Decimal(18, 4)
  pendingBonus   Decimal  @default(0) @db.Decimal(18, 4)
  reservedBonus  Decimal  @default(0) @db.Decimal(18, 4)
  lifetimeEarned Decimal  @default(0) @db.Decimal(18, 4)
  lifetimeSpent  Decimal  @default(0) @db.Decimal(18, 4)
  version        Int      @default(0) // optimistic locking
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Restrict, not Cascade: a hard `user.delete()` must never be able to
  // silently wipe the append-only ledger of record underneath it. Account
  // deletion in this codebase is anonymization (`AccountDeletionService`),
  // which never issues a hard delete — no code path relies on this cascade
  // today, so this only closes a landmine for whatever deletes a user next
  // (independent audit, GitHub issue #28).
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  lots          BonusLot[]
  reservations  BonusReservation[]
  ledgerEntries BonusLedgerEntry[]

  @@map("wallets")
}

enum BonusLotStatus {
  PENDING
  AVAILABLE
  EXPIRED
  CONSUMED
}

/// Ledger entry kinds.
///
/// Split into two families, and the distinction is load-bearing:
///
///  * VALUE entries change how many points the wallet holds in total
///    (ACCRUAL_*, REDEMPTION_*, EXPIRY, REVERSAL). Their signed sum is the
///    wallet's outstanding balance.
///  * TRANSFER entries move points between buckets without changing the
///    total (RESERVE_HOLD, RESERVE_RELEASE, PENDING_PROMOTION).
///
/// Before this split, reserving and settling both wrote a REDEMPTION_*
/// DEBIT for the same spend, so summing debits double-counted every
/// redemption and the ledger could not reproduce the balance.
enum BonusEntryType {
  ACCRUAL_PURCHASE
  ACCRUAL_REFERRAL
  ACCRUAL_PROMOTION
  ACCRUAL_MANUAL_ADJUSTMENT
  /// A DeferredBonusLot unlocking into real, spendable points — kept distinct
  /// from ACCRUAL_PURCHASE so a wallet's history can tell "earned now" from
  /// "earned months ago, released today".
  ACCRUAL_DEFERRED
  REDEMPTION_QR_PAYMENT
  REDEMPTION_EV_CHARGING
  /// Bonus spent settling a confirmed PurchaseIntent — spec §7.
  REDEMPTION_PARTNER_PURCHASE
  EXPIRY
  REVERSAL
  RESERVE_HOLD
  RESERVE_RELEASE
  PENDING_PROMOTION
}

/// A discrete batch of bonus points accrued together, expiring together.
/// FIFO consumption against lots is what lets us expire the *oldest*
/// points first and gives an accurate "expiring soon" view.
model BonusLot {
  id                  String         @id @default(uuid())
  walletId            String
  type                BonusEntryType
  status              BonusLotStatus @default(PENDING)
  originalAmount      Decimal        @db.Decimal(18, 4)
  remainingAmount     Decimal        @db.Decimal(18, 4)
  sourceTransactionId String?
  availableAt         DateTime // when PENDING -> AVAILABLE (cooling-off window)
  expiresAt           DateTime
  createdAt           DateTime       @default(now())

  wallet      Wallet                       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  allocations BonusReservationAllocation[]

  @@index([walletId, status])
  @@index([expiresAt])
  @@index([sourceTransactionId])
  @@map("bonus_lots")
}

enum BonusReservationStatus {
  ACTIVE
  SETTLED
  RELEASED
  EXPIRED
}

/// A hold against AVAILABLE lots, placed while a QR payment / EV session is
/// in flight, so the same points can never be double-spent concurrently.
model BonusReservation {
  id                  String                 @id @default(uuid())
  walletId            String
  amount              Decimal                @db.Decimal(18, 4)
  status              BonusReservationStatus @default(ACTIVE)
  reasonTransactionId String?
  expiresAt           DateTime
  settledAt           DateTime?
  releasedAt          DateTime?
  createdAt           DateTime               @default(now())

  wallet      Wallet                       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  allocations BonusReservationAllocation[]

  @@index([walletId, status])
  @@index([status, expiresAt])
  @@map("bonus_reservations")
}

/// Join table recording exactly which lots (and how much of each) back a
/// given reservation, so releasing/settling can credit/debit the right lots.
model BonusReservationAllocation {
  id            String  @id @default(uuid())
  reservationId String
  lotId         String
  amount        Decimal @db.Decimal(18, 4)

  reservation BonusReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  lot         BonusLot         @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([reservationId, lotId])
  @@map("bonus_reservation_allocations")
}

/// Direction of an entry's effect on the wallet's *total* holdings.
/// NEUTRAL is used by TRANSFER entries, which relocate points between
/// buckets without creating or destroying any.
enum LedgerDirection {
  CREDIT
  DEBIT
  NEUTRAL
}

/// Append-only, immutable log of every bonus movement. Never updated or
/// deleted — this is the ledger of record.
///
/// The three *Delta columns make the ledger replayable: for any wallet the
/// cumulative sum of each delta equals the corresponding column on Wallet.
/// That property is asserted after every money operation in the test suite,
/// so a change that breaks reconstruction fails CI rather than silently
/// corrupting reporting.
model BonusLedgerEntry {
  id        String          @id @default(uuid())
  walletId  String
  type      BonusEntryType
  direction LedgerDirection
  /// Absolute magnitude of the movement; never negative.
  amount    Decimal         @db.Decimal(18, 4)

  /// Signed effect of this entry on each wallet bucket.
  /// Invariant: availableDelta + pendingDelta + reservedDelta
  ///            == +amount (CREDIT) | -amount (DEBIT) | 0 (NEUTRAL)
  availableDelta Decimal @default(0) @db.Decimal(18, 4)
  pendingDelta   Decimal @default(0) @db.Decimal(18, 4)
  reservedDelta  Decimal @default(0) @db.Decimal(18, 4)

  /// Total outstanding points (available + pending + reserved) after this
  /// entry was applied. One meaning, everywhere — previously this column
  /// meant "available + pending" in accruals and "available" elsewhere.
  balanceAfter Decimal @db.Decimal(18, 4)

  relatedLotId         String?
  relatedReservationId String?
  sourceTransactionId  String?
  metadata             Json?
  createdAt            DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([sourceTransactionId])
  @@index([relatedReservationId])
  @@map("bonus_ledger_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Transactions (single source of truth for "what happened commercially")
// ─────────────────────────────────────────────────────────────────────────

enum TransactionType {
  QR_PAYMENT
  EV_CHARGING
  BONUS_ACCRUAL
  BONUS_REDEMPTION
  REFERRAL_REWARD
  REFUND
  MANUAL_ADJUSTMENT
  /// A confirmed PurchaseIntent — spec §7. Distinct from QR_PAYMENT: the
  /// latter settles instantly on scan, this one only becomes COMPLETED after
  /// partner staff confirm it.
  PARTNER_PURCHASE
}

enum TransactionStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  REVERSED
  FLAGGED
}

enum Currency {
  AMD
  BONUS_POINT
}

model Transaction {
  id                 String            @id @default(uuid())
  userId             String
  partnerId          String?
  /// Which branch of `partnerId` this operation happened at, so that
  /// branch-scoped staff can be filtered in the database rather than
  /// after the fact. Written only where a branch is actually known — a
  /// `PurchaseIntent` settlement carries the intent's branch forward.
  ///
  /// Null for every row written before this column, and for every path
  /// that has no branch to record: legacy partner-wide QR, EV charging
  /// sessions, CDR reconciliation and roaming. A caller restricted to
  /// specific branches does not see null rows — see `branchFilterFor`.
  partnerBranchId    String?
  type               TransactionType
  status             TransactionStatus @default(INITIATED)
  amount             Decimal           @db.Decimal(18, 4)
  currency           Currency          @default(AMD)
  bonusAppliedAmount Decimal           @default(0) @db.Decimal(18, 4)
  bonusEarnedAmount  Decimal           @default(0) @db.Decimal(18, 4)
  description        String?
  /// Scoped to the owning user, not global. A globally-unique key let one
  /// account replay another account's key and receive that account's
  /// transaction back, and let an attacker squat a key to turn a victim's
  /// future payment into a silent no-op.
  idempotencyKey     String?
  metadata           Json?
  /// Spec §2.2 — the same immutable brand snapshot `PurchaseIntent` carries,
  /// on the customer-facing record itself. Written at creation for every
  /// transaction that has a partner (purchase settlement, QR redemption, an
  /// EV session becoming a customer operation); a refund/reversal copies the
  /// snapshot of the operation it reverses rather than re-reading the
  /// partner's brand as it stands today.
  ///
  /// Null on every row written before this migration, and on any transaction
  /// with no partner at all (a manual adjustment, an expiry). Nothing
  /// financial depends on these two columns: they are display-only.
  brandDisplayName   String?
  brandLogoAssetId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  partner        Partner?       @relation(fields: [partnerId], references: [id])
  branch         PartnerBranch? @relation(fields: [partnerBranchId], references: [id], onDelete: SetNull)
  brandLogoAsset MediaAsset?    @relation("TransactionBrandLogo", fields: [brandLogoAssetId], references: [id])
  qrCode         QrCode?
  evSession      EvSession?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([partnerId, createdAt])
  @@index([partnerBranchId, createdAt])
  @@index([type, status])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────
// QR Payments
// ─────────────────────────────────────────────────────────────────────────

enum QrCodeType {
  STATIC_MERCHANT
  DYNAMIC_INVOICE
  USER_PAY_TOKEN
}

enum QrCodeStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  VOID
}

model QrCode {
  id                    String       @id @default(uuid())
  type                  QrCodeType
  status                QrCodeStatus @default(ACTIVE)
  token                 String       @unique
  issuedByUserId        String?
  partnerId             String?
  amount                Decimal?     @db.Decimal(18, 4)
  expiresAt             DateTime
  redeemedTransactionId String?      @unique
  createdAt             DateTime     @default(now())

  issuedBy            User?        @relation("QrIssuedBy", fields: [issuedByUserId], references: [id])
  partner             Partner?     @relation(fields: [partnerId], references: [id])
  redeemedTransaction Transaction? @relation(fields: [redeemedTransactionId], references: [id])

  @@index([status, expiresAt])
  @@map("qr_codes")
}

enum PurchaseIntentStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  REJECTED
  EXPIRED
  /// The customer withdrew the purchase themselves, before any member of
  /// staff acted on it. Deliberately its own state rather than folded into
  /// `REJECTED`: a partner reading its own queue must be able to tell a
  /// purchase its cashier turned down from one the customer walked away
  /// from, and `rejectionReason`/`confirmedByUserId` describe a staff
  /// decision that never happened here.
  CANCELLED
}

/// Spec §7-9: the new standard purchase flow. Customer scans a partner/branch
/// QR, enters the gross amount and how much of it to pay with bonus, and a
/// member of partner staff confirms or rejects within `expiresAt`. Additive
/// alongside `QrCode`/`redeem()` — see
/// docs/CORE_ARCHITECTURE_MIGRATION_2026-08.md §3 for why the older,
/// synchronous flow is left running rather than replaced tonight.
///
/// Everything below `negotiatedRateBps` is the commercial snapshot spec §8
/// asks for: captured once at creation, read-only afterwards, so a later
/// change to the partner's rate or cap can never alter a live or historical
/// intent.
model PurchaseIntent {
  id              String               @id @default(uuid())
  customerId      String
  partnerId       String
  partnerBranchId String?
  status          PurchaseIntentStatus @default(AWAITING_CONFIRMATION)

  /// The four digits the customer reads out at the till, so a cashier can
  /// find this exact purchase without scanning anything or typing a uuid.
  ///
  /// A disambiguator, not a secret: finding a purchase by code still
  /// requires staff authentication, the partner scope, and the branch
  /// scope, exactly as the queue does. Uniqueness is enforced by the
  /// database, not by this application — a partial unique index over
  /// (`partnerId`, `confirmationCode`) restricted to
  /// `AWAITING_CONFIRMATION` rows, so a code belongs to one live purchase
  /// per business at a time and returns to the pool the moment that
  /// purchase reaches any terminal state. Prisma cannot express a partial
  /// unique index, so it lives in the migration alongside the two the
  /// branch-staff tables already use.
  ///
  /// `Char(4)` rather than an Int: 0042 is a different code from 42 on a
  /// printed slip and in a spoken sentence, and an integer column cannot
  /// keep the leading zeros that half of all codes need.
  /// Null on every row created before this column existed.
  confirmationCode String? @db.Char(4)

  grossAmount              Decimal @db.Decimal(18, 4)
  bonusAmountRequested     Decimal @default(0) @db.Decimal(18, 4)
  /// What the customer still has to hand over *outside* TuTak — at the till
  /// in cash or by card, or through the provider on a `TUTAK_PSP` purchase.
  /// Stored rather than derived so the figure the customer saw at scan time
  /// is exactly what is on record. Since 20.09.2026 the identity is
  ///
  ///     grossAmount = bonusAmountRequested + prepaidAmountApplied + ordinaryPaymentRemainder
  ///
  /// enforced by `purchase_intents_funding_sums_to_gross`. Every row created
  /// before then has `prepaidAmountApplied = 0`, so the old reading
  /// (`gross - bonus`) is still exactly true for it. Nothing is reinterpreted.
  ordinaryPaymentRemainder Decimal @db.Decimal(18, 4)
  /// The part of the price the customer pays from their own stored money
  /// (`CUSTOMER_PREPAID_BALANCE`) — the second TuTak-side funding component
  /// next to bonus. Held at creation (`prepaidHoldTransactionId`), turned
  /// into a `PARTNER_PAYABLE` credit at confirmation, released on every
  /// other exit. Zero on every purchase that does not use it, historical
  /// rows included. Never a third route: `paymentRoute` still says only how
  /// `ordinaryPaymentRemainder` is collected.
  prepaidAmountApplied     Decimal @default(0) @db.Decimal(18, 4)
  /// The ledger transaction that moved `prepaidAmountApplied` from the
  /// customer's available balance into `CUSTOMER_PREPAID_RESERVED` when this
  /// purchase was opened. Unique, so a purchase has at most one hold; null
  /// when `prepaidAmountApplied` is zero. The hold is *reversed* (never
  /// deleted) when the purchase is cancelled, rejected or expires, and
  /// *settled* — reserved → partner payable — when it is confirmed. See
  /// `CustomerBalanceService.holdForPurchase`.
  prepaidHoldTransactionId String? @unique
  /// Running total of every TuTak-side refund against this purchase's
  /// merchandise value. The guard that stops a purchase being refunded past
  /// its own grossAmount is a conditional UPDATE on this column, exactly the
  /// way `Payment.refundedAmount` guards captured payments — see
  /// `PurchaseIntentRefundService`.
  refundedAmount           Decimal @default(0) @db.Decimal(18, 4)

  /// How the real-money remainder is settled. Fixed when the purchase is
  /// created and never changed: see `PaymentRoute`'s own docblock for why
  /// immutability here is what makes double payment structurally impossible
  /// rather than merely unlikely.
  ///
  /// Defaults to DIRECT_PARTNER so every purchase that existed before this
  /// column did is described correctly — they were all direct, because
  /// nothing else existed.
  paymentRoute PaymentRoute @default(DIRECT_PARTNER)

  /// What the customer handed over on a DIRECT purchase, recorded by the
  /// cashier at confirmation. Null until confirmed, and always null on a
  /// TUTAK_PSP purchase.
  directTender DirectTender?

  /// Quantity sold, for partners who price per unit — 50 litres at 300 AMD.
  /// All three are snapshots: a fuel price that changes tomorrow must not
  /// change what yesterday's receipt says. Null together for a partner who
  /// simply charges a total.
  quantity     Decimal?       @db.Decimal(18, 4)
  quantityUnit UnitOfMeasure?
  unitPrice    Decimal?       @db.Decimal(18, 4)

  /// ── Merchant authorisation ────────────────────────────────────────────
  ///
  /// A payment provider confirms that money moved. It cannot confirm that a
  /// sale happened, what was sold, or for how much — and on this platform the
  /// *customer* supplies all three when they open a purchase.
  ///
  /// Without this, a customer could type 500 litres, pay the resulting bill
  /// through Idram, and have one verified callback credit the partner's
  /// `PARTNER_PAYABLE`, mint their own cashback and pay their referrers on a
  /// sale that never happened. The provider would have done nothing wrong:
  /// the money genuinely moved. The product decision of 15.09.2026 is that
  /// somebody at the business has to agree the economics first.
  ///
  /// So a non-integrated partner's staff approve the snapshot — gross, bonus,
  /// quantity, unit, unit price, and the terms version — **before** a bill
  /// may be opened, and from that moment those columns are immutable at the
  /// database level. What approval *means* then differs by route:
  ///
  ///  - `DIRECT_PARTNER`: the cashier's confirmation is both the approval and
  ///    the statement that the money is in the till. One act, as it always
  ///    was — `confirm()` stamps these columns on the way past.
  ///  - `TUTAK_PSP`: approval only authorises the bill. The purchase is
  ///    completed by the provider's verified callback and by nothing else.
  ///
  /// For an integrated POS or pump this is where an authoritative integration
  /// event will sit instead. `PartnerIntegration` exists as a registry with
  /// no event path yet, so that is deliberately not built.
  merchantApprovedByUserId   String?
  /// The till's credential, when the merchant approval came from the
  /// partner's own POS integration rather than a person (20.09.2026, brief
  /// §20). Exactly one of this and `merchantApprovedByUserId` is set with
  /// `merchantApprovedAt` — `purchase_intents_merchant_approval_is_complete`.
  merchantApprovedByApiKeyId String?
  merchantApprovedAt         DateTime?
  /// What the member of staff actually keyed in to confirm the line item,
  /// kept as evidence that they saw it rather than clicked past it.
  merchantApprovalNote       String?

  /// The commercial terms this purchase was priced under, named exactly.
  ///
  /// Null on every purchase made before 15.09.2026 and on every partner who
  /// has no rule row, which is why `negotiatedRateBps` below is still
  /// written and still read: a percentage partner with no rule behaves
  /// exactly as it did, and nothing about the old rows had to be migrated or
  /// reinterpreted.
  ///
  /// `contributionRuleVersion` and `contributionRuleKind` are duplicated out
  /// of the rule on purpose. The foreign key already reaches the row, but a
  /// receipt should be readable without a join, and a rule that is one day
  /// deleted in a database restore should not take the description of what
  /// was charged with it.
  contributionRuleId      String?
  contributionRuleVersion Int?
  contributionRuleKind    ContributionRuleKind?

  /// The legacy single-number snapshot. Still the source of truth for a
  /// purchase with no rule snapshot; ignored when there is one.
  negotiatedRateBps      Int
  maxBonusPaymentPercent Int

  /// The pool split's actual confirmed amounts — spec §12's `pool` and the
  /// green/deferred/referrer legs `settlePurchase` posted, snapshotted at
  /// confirmation so a later refund reverses the *historical* allocation
  /// rather than recomputing green/deferred/referrer bps from whatever
  /// `purchasePolicy` says today. Null until confirmed (mirrors
  /// `confirmedAt`); a purchase that never confirms has nothing to refund.
  /// `tutakBase` is not stored — it was, and remains, `pool` minus the
  /// other three, by construction.
  ///
  /// `referrerAmount` (singular) is the LEGACY single-level program's own
  /// snapshot — written only by a `PurchaseIntent` confirmed before the
  /// 3-level referral rework shipped (2026-08-22). It is never written
  /// (and never read) by a row whose `programVersion` is `THREE_LEVEL_V2`;
  /// see `referrer1Amount`/`referrer2Amount`/`referrer3Amount` below for
  /// that program's own per-level snapshot. This column is kept, unrenamed
  /// and unbackfilled, purely so historical rows and their refunds stay
  /// reconstructable exactly as they were confirmed — the transition
  /// boundary this repository's referral rework requires never reinterprets
  /// old rows into the new shape.
  poolAmount     Decimal? @db.Decimal(18, 4)
  greenAmount    Decimal? @db.Decimal(18, 4)
  deferredAmount Decimal? @db.Decimal(18, 4)
  referrerAmount Decimal? @db.Decimal(18, 4)

  /// Which referral program priced this purchase — the explicit,
  /// persisted eligibility boundary the 3-level referral rework requires
  /// (2026-08-22): never inferred from `createdAt` vs. a release date.
  /// Null for every row confirmed before this column existed (the legacy
  /// single-level program, `referrerAmount` above); `THREE_LEVEL_V2` for
  /// every row confirmed after. `PurchaseIntentRefundService` branches on
  /// this to decide which snapshot columns to reverse, and never re-walks
  /// the live referral chain for a refund — see that service.
  programVersion ReferralProgramVersion?

  /// The 3-level program's own per-level snapshot (2026-08-22 referral
  /// rework) — who L1/L2/L3 actually were and what each was actually paid,
  /// captured at confirmation exactly like `greenAmount`/`deferredAmount`
  /// above, for the same reason: a later refund reverses the *historical*
  /// allocation, never a recomputed one. Exactly one of
  /// `referrerNUserId`/`referrerNPartnerId` is set per populated level,
  /// matching `referrerNType` — same shape as `ReferralInvite`'s own
  /// `referrerUserId`/`referrerPartnerId` pair. A level with no recipient
  /// (chain shorter than 3) leaves that level's three columns null and its
  /// `Amount` column unset/zero; its share is already folded into
  /// `tutakAmount`, which is TuTak's residual share — `pool - green -
  /// deferred - referrer1Amount - referrer2Amount - referrer3Amount` by
  /// construction, never independently rounded, so all six legs always sum
  /// to exactly `pool`.
  referrer1Type      ReferrerType?
  referrer1UserId    String?
  referrer1PartnerId String?
  referrer1Amount    Decimal?      @db.Decimal(18, 4)
  referrer2Type      ReferrerType?
  referrer2UserId    String?
  referrer2PartnerId String?
  referrer2Amount    Decimal?      @db.Decimal(18, 4)
  referrer3Type      ReferrerType?
  referrer3UserId    String?
  referrer3PartnerId String?
  referrer3Amount    Decimal?      @db.Decimal(18, 4)
  tutakAmount        Decimal?      @db.Decimal(18, 4)

  /// Spec §2.2 — the brand this purchase was actually made under, captured
  /// once at creation and never rewritten. Showing the partner's *current*
  /// logo on an old financial record is not enough: a partner may rebrand,
  /// replace a mistaken file, or have an asset revoked, and a customer
  /// scrolling their history must still recognise where they spent.
  ///
  /// Both nullable, and null on every row that predates this migration —
  /// the resolver falls back to the partner's live display name and the
  /// neutral mark for those, which is exactly the behaviour they have today.
  /// `brandLogoAssetId` may point at a `REPLACED` asset; that is the point.
  brandDisplayName String?
  brandLogoAssetId String?

  bonusReservationId      String?
  sourceTransactionId     String?
  /// Individual staff identity of whoever confirmed this purchase — spec
  /// §25/§33. Confirmation only: this column used to claim it held "whoever
  /// confirmed or rejected", and `reject()` never wrote it, so for every
  /// rejected purchase the row did not say who turned the customer away.
  confirmedByUserId       String?
  /// What kind of event confirmed this purchase, recorded rather than
  /// inferred.
  ///
  /// Three things can move a purchase to CONFIRMED and they are not
  /// interchangeable: a cashier taking money at a till, a partner's own POS
  /// or API integration acting on its key, and a payment provider reporting
  /// that money reached it. Only the last is evidence that anybody paid
  /// TuTak anything.
  ///
  /// It could be guessed from `confirmedByUserId`, `confirmedByApiKeyId` and
  /// `paymentRoute` together, and guessing is exactly what this column
  /// exists to stop: a null actor currently means both "the provider did it"
  /// and "this row predates the column", and a partner reading a statement
  /// cannot be asked to tell those apart. Null here means the second, and
  /// the interface says "not recorded" rather than naming anybody.
  ///
  /// Which of the five columns below may be set is a database rule, not
  /// a convention — `purchase_intents_confirmation_is_consistent`. A union
  /// in TypeScript binds the one writer that uses it; a backfill or a
  /// support fix typed into psql is bound by nothing.
  confirmationSource      PurchaseConfirmationSource?
  /// The person's permanent code at this partner, frozen at confirmation.
  ///
  /// Not derived on read, and this is the whole point of the column.
  /// `PartnerBranchStaffAssignment.employeeDisplayCode` belongs to an
  /// assignment, so moving somebody to another branch would silently change
  /// what last month's receipts appear to say. `PartnerEmployee.code` is
  /// stable, but even that is looked up *here* rather than joined on read,
  /// so the row keeps saying what it said on the day.
  confirmedByEmployeeCode String?
  /// Which branch assignment authorised it, when one did. Null for an
  /// owner or an all-branch manager, who act without being assigned
  /// anywhere — their reach is the role, not a posting.
  confirmedByAssignmentId String?
  /// The role held at that moment, frozen for the same reason as the code:
  /// a promotion must not rewrite who approved what. Set together with the
  /// assignment or not at all — a branch with a blank next to it on the
  /// employee card is what `purchase_intents_confirmation_posting_is_whole`
  /// forbids.
  confirmedByRole         String?
  /// Which integration key acted, when the source is a partner's own POS or
  /// API rather than a person. Distinct from `merchantApprovedByApiKeyId`,
  /// which records a different event entirely — agreeing the terms of a
  /// sale, not confirming it happened.
  confirmedByApiKeyId     String?
  /// And who did. Separate from `confirmedByUserId` rather than shared with
  /// it: a column named "confirmed by" holding the person who refused is the
  /// kind of naming that misleads a year later, when somebody reads a report
  /// instead of this comment. Null on every row rejected before this column
  /// existed — their actor is in `AuditLog` and nowhere else, and inventing
  /// one here would misstate who did what.
  rejectedByUserId        String?
  rejectionReason         String?

  /// Set once, at confirmation. A repeat confirm call with the same key
  /// becomes a lookup rather than a second execution — spec §7's idempotency
  /// requirement, same pattern as `Transaction.idempotencyKey`.
  confirmationIdempotencyKey String? @unique

  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?
  rejectedAt  DateTime?
  /// Set once, by the customer's own cancel action — see
  /// `PurchaseIntentsService.cancel`.
  cancelledAt DateTime?

  brandLogoAsset MediaAsset? @relation("PurchaseIntentBrandLogo", fields: [brandLogoAssetId], references: [id])

  customer                 User                          @relation("PurchaseIntentCustomer", fields: [customerId], references: [id])
  partner                  Partner                       @relation(fields: [partnerId], references: [id])
  contributionRule         PartnerContributionRule?      @relation(fields: [contributionRuleId], references: [id])
  branch                   PartnerBranch?                @relation(fields: [partnerBranchId], references: [id])
  confirmedBy              User?                         @relation("PurchaseIntentConfirmedBy", fields: [confirmedByUserId], references: [id])
  rejectedBy               User?                         @relation("PurchaseIntentRejectedBy", fields: [rejectedByUserId], references: [id])
  prepaidHold              LedgerTransaction?            @relation("PurchaseIntentPrepaidHold", fields: [prepaidHoldTransactionId], references: [id])
  merchantApprovedByApiKey PartnerApiKey?                @relation("PurchaseIntentApprovedByApiKey", fields: [merchantApprovedByApiKeyId], references: [id])
  checkout                 PartnerCheckout?
  refunds                  PurchaseIntentRefund[]
  refundRequests           PurchaseIntentRefundRequest[]
  pspPaymentAttempts       PspPaymentAttempt[]

  @@index([partnerId, status])
  @@index([status, expiresAt])
  @@index([customerId, status])
  /// At most one *unfinished* purchase per customer per business, whatever
  /// route it collects on. A partial unique index created by migration — see
  /// `20260915150000_one_live_purchase_per_customer_partner` for the race it
  /// closes. Prisma cannot express a partial unique index, so it is declared
  /// there and not here; this comment exists so the next reader of this model
  /// knows the constraint is real.
  //   CREATE UNIQUE INDEX purchase_intents_one_live_per_customer_partner
  //     ON purchase_intents (customerId, partnerId)
  //     WHERE status = 'AWAITING_CONFIRMATION';
  @@map("purchase_intents")
}

/// Who is allowed to decide a refund, and who merely asks for one.
///
/// Owner's decision (2026-09-12): a refund moves money back and claws back
/// bonus that referrers may already have spent, so the person at the till
/// may start one but may not settle it. `PENDING` is a request with no
/// financial effect whatsoever; `APPROVED` is the only state that has ever
/// touched the ledger, and it is reached exactly once per request because
/// the engine behind it is keyed on this request's own id.
enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A refund a member of partner staff has asked for and an owner or manager
/// has not yet decided — the "maker" half of the same maker/checker split
/// `PartnerCollection` already uses for bank collections.
///
/// Deliberately a separate record from `PurchaseIntentRefund` rather than a
/// status on it: a refund row means money and bonus have already moved, and
/// nothing that has not been approved may ever appear in that table. The two
/// are linked by `refundId` once, at approval.
model PurchaseIntentRefundRequest {
  id               String   @id @default(uuid())
  purchaseIntentId String
  /// Denormalized from the purchase so an approver's queue is one indexed
  /// read, and so branch isolation filters in SQL rather than by walking
  /// back through the intent — same reasoning as `Transaction.partnerBranchId`.
  partnerId        String
  partnerBranchId  String?
  /// Null means "whatever is still refundable", resolved at approval
  /// against the live `refundedAmount` — never frozen at request time, or a
  /// request written before another refund landed would reverse more than
  /// remains.
  amount           Decimal? @db.Decimal(18, 4)
  reason           String

  status RefundRequestStatus @default(PENDING)

  requestedByUserId String
  requestedAt       DateTime  @default(now())
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?

  /// The refund this request became. Set only on approval, and unique: one
  /// request can never be spent twice, whatever the caller retries.
  refundId String? @unique

  purchaseIntent PurchaseIntent @relation(fields: [purchaseIntentId], references: [id])
  partner        Partner        @relation(fields: [partnerId], references: [id])

  /// `Restrict`, not Prisma's default `SetNull` for an optional relation.
  /// This row is the record of who asked for money to move back and who
  /// agreed; quietly blanking the branch it happened at, or the person who
  /// decided, because some other row was deleted would erase exactly the
  /// part that makes it evidence. Nothing in this codebase hard-deletes a
  /// user, a branch or a refund anyway — users are soft-deleted via
  /// `deletedAt` — so this constrains nothing that happens today and fails
  /// loudly if that ever changes.
  branch      PartnerBranch?        @relation(fields: [partnerBranchId], references: [id], onDelete: Restrict)
  requestedBy User                  @relation("RefundRequestRequestedBy", fields: [requestedByUserId], references: [id])
  decidedBy   User?                 @relation("RefundRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  refund      PurchaseIntentRefund? @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@index([partnerId, status])
  @@index([purchaseIntentId])
  @@map("purchase_intent_refund_requests")
}

/// A TuTak-side refund against a confirmed/completed PurchaseIntent —
/// merchandise-value only. Deliberately not `Refund`/`Payment`: this never
/// touches real money (the partner repays the customer outside TuTak) and
/// never routes through `RefundEngineService`. What it reverses is every
/// loyalty effect the original purchase created, proportional to how much of
/// the merchandise the partner is taking back, tracked immutably against the
/// intent it refunds — see `PurchaseIntentRefundService`.
/// The state of the part of a refund that TuTak cannot move itself — the
/// cash or card the customer paid at the till, or the provider's money.
enum ExternalRefundStatus {
  NOT_REQUIRED
  PENDING_PARTNER
  CONFIRMED
}

model PurchaseIntentRefund {
  id                              String               @id @default(uuid())
  purchaseIntentId                String
  /// The merchandise refund amount the partner entered — always ≤ what
  /// remains of `PurchaseIntent.grossAmount`, enforced by a conditional
  /// UPDATE on `refundedAmount`, the same guard `Payment.refundedAmount` uses.
  amount                          Decimal              @db.Decimal(18, 4)
  /// This refund's own proportional slice of the bonus the customer spent on
  /// the original purchase, restored to their wallet.
  bonusRestored                   Decimal              @default(0) @db.Decimal(18, 4)
  /// This refund's proportional slice of `PurchaseIntent.prepaidAmountApplied`,
  /// credited back to the customer's `CUSTOMER_PREPAID_BALANCE` and debited
  /// from the partner's `PARTNER_PAYABLE` (kind `partner.prepaid_funding_refund`).
  /// Zero on every refund of a purchase that used no stored money.
  prepaidRestored                 Decimal              @default(0) @db.Decimal(18, 4)
  /// What the *partner* owes the customer back outside TuTak for this refund:
  /// `amount - bonusRestored - prepaidRestored`, the slice that was paid in
  /// cash/card at the till or through the provider. TuTak never moves this
  /// money; it only records whether the partner says they returned it.
  externalRefundDue               Decimal              @default(0) @db.Decimal(18, 4)
  /// Where the external slice stands. `NOT_REQUIRED` when `externalRefundDue`
  /// is zero; `PENDING_PARTNER` until somebody at the business confirms they
  /// handed the money back; `CONFIRMED` after. A customer is never told a
  /// refund is complete while this reads `PENDING_PARTNER`.
  externalRefundStatus            ExternalRefundStatus @default(NOT_REQUIRED)
  externalRefundConfirmedAt       DateTime?
  externalRefundConfirmedByUserId String?
  /// Which `splitRefundAcrossComponents` policy computed the three slices.
  /// 1: independent per-component watermarks (could go negative on the
  /// external slice — audit 21.09.2026, D09). 2: cumulative allocator, each
  /// component from the previous one's remainder. Rows written before the
  /// column existed are stamped 1 by the migration.
  roundingPolicyVersion           Int                  @default(2)
  reason                          String
  /// The reversing ledger transaction for the pool-contribution leg.
  /// Postings are immutable, so a refund is a new transaction pointing back
  /// at the original, never an edit.
  ledgerTransactionId             String?              @unique
  actorId                         String
  /// Scoped to the actor, matching `IdempotencyService`'s
  /// `purchase-intent-refund:<actorId>` scope.
  idempotencyKey                  String?
  createdAt                       DateTime             @default(now())

  purchaseIntent    PurchaseIntent               @relation(fields: [purchaseIntentId], references: [id])
  ledgerTransaction LedgerTransaction?           @relation(fields: [ledgerTransactionId], references: [id])
  request           PurchaseIntentRefundRequest?

  @@unique([actorId, idempotencyKey])
  @@index([purchaseIntentId])
  @@map("purchase_intent_refunds")
}

// ─────────────────────────────────────────────────────────────────────────
// Partners
// ─────────────────────────────────────────────────────────────────────────

/// Onboarding lifecycle — spec: docs/CORE_ARCHITECTURE_MIGRATION_2026-08.md §2.
/// `isActive` (below) stays the single field every existing read site checks;
/// `status` is the richer state this drives it from, kept in sync by
/// `PartnersService` on every transition so nothing that already reads
/// `isActive` has to change.
enum PartnerStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

model Partner {
  id                        String        @id @default(uuid())
  legalName                 String
  displayName               String
  /// The Armenian ՀՎՀՀ. Optional, because a self-service applicant is asked
  /// for it before there is any relationship in which to chase it, and a
  /// business that cannot find its number on a Saturday evening should not
  /// be turned away at the door — it can be filled in from the partner's own
  /// panel afterwards.
  ///
  /// Still `@unique`: in PostgreSQL one NULL is not equal to another, so any
  /// number of partners may have none while two partners may never claim the
  /// same number.
  taxId                     String?       @unique
  category                  String
  /// Meaningful only when `category` is `fuel` — whether this station sells
  /// gas. Propane and methane are one customer-facing bucket, not two: a
  /// shopper picking "Газ" on the map does not care which of the two a given
  /// station burns, so this is a single flag rather than a per-gas-type
  /// field: in the gas category propane and methane are one chip for every
  /// station (product decision, 2026-08-26).
  sellsGas                  Boolean       @default(false)
  /// Meaningful only when `category` is `fuel` — whether this station sells
  /// petrol/gasoline. Independent of `sellsGas`: a real station commonly
  /// sells both, so these are two flags rather than one enum choice.
  sellsPetrol               Boolean       @default(false)
  /// Basis points, e.g. 300 = 3%. Restricted to the fixed rate card — 0.5%
  /// steps from 0.5% to 20% (50..2000, step 50) — enforced by
  /// `IsCommissionRateBps` at the API boundary and by
  /// `partners_commission_rate_on_grid` (CHECK) at the database boundary.
  bonusAccrualRateBps       Int           @default(300)
  /// The platform's cut of a captured payment, in basis points. Independent
  /// of bonusAccrualRateBps — one prices what the customer earns, the other
  /// what the platform keeps, and conflating them would make either one
  /// impossible to change without affecting the other.
  paymentCommissionRateBps  Int           @default(250) // 2.5%
  /// Spec §11: the partner's own ceiling on how much of a purchase may be
  /// paid with bonus points, 0-100. Only PARTNER_OWNER may change it — see
  /// `partners.controller.ts`. Defaults to 100 (no cap), which is exactly
  /// today's behaviour before this field existed — see the migration doc's
  /// conflict table for why no lower default or platform-wide ceiling was
  /// invented.
  maxBonusPaymentPercent    Int           @default(100)
  /// Roaming-CPO wholesale-resale integration only (docs/
  /// ROAMING_CPO_INTEGRATION_2026-08-25.md) — the contractual AMD/kWh rate
  /// TuTak owes this partner for wholesale energy, e.g. 75 AMD/kWh.
  /// Configurable by explicit product decision, not a literal in service
  /// code — same discipline as `bonusAccrualRateBps` above. Meaningless (and
  /// never read) for a partner with no `ROAMING_CPO`-provider `EvStation`;
  /// the default matches a typical current rate purely so an unrelated
  /// partner row is not left at a nonsensical 0, exactly the way
  /// `paymentCommissionRateBps`'s default is not "this partner takes
  /// payments" — every read of this field is already gated on the session's
  /// station being a roaming-CPO one.
  evWholesaleRatePerKwh     Decimal       @default(75.00) @db.Decimal(10, 2)
  /// The ceiling (AMD/kWh) on how much of a roaming-CPO session's margin
  /// enters the ordinary green/deferred/L1/L2/L3/TuTak split —
  /// `min(margin, this)`. Margin above it is undivided TuTak revenue. See
  /// `RoamingCpoSettlementService.computeMarginSplit` for the worked
  /// examples this cap was confirmed against (5 / 30 / 45 AMD/kWh margins).
  evMarginReferralCapPerKwh Decimal       @default(20.00) @db.Decimal(10, 2)
  status                    PartnerStatus @default(ACTIVE)
  isActive                  Boolean       @default(true)
  /// Set by reconciliation when this partner's ledger balance disagrees with
  /// the bank statement. Blocks payouts until a human clears it — paying out
  /// against a balance known to be wrong is the one thing worse than not
  /// paying out at all.
  payoutsBlockedAt          DateTime?
  payoutsBlockedReason      String?
  /// The partner's official square logo, or null. Spec §1.1: a business
  /// identity, published only after a platform administrator confirms it —
  /// see `MediaAssetStatus.PENDING_REVIEW`. Nullable forever: every partner
  /// that predates this migration renders the neutral mark.
  logoAssetId               String?
  /// Optional wide cover for the catalogue/detail card. Same approval rule.
  coverAssetId              String?
  /// Free text the partner writes about themselves — the "about" half of the
  /// public profile settled by the product decision of 2026-08-23, shown on
  /// the partner's detail page. Deliberately no approval workflow, unlike
  /// `logoAssetId`/`coverAssetId` above: a string carries no impersonation
  /// risk the way an uploaded image does, so the partner's own write is
  /// live immediately. Capped length enforced at the DTO boundary
  /// (`UpdatePartnerAboutDto`), matching how `displayName`/`legalName` are
  /// capped in this schema — see `ApplyPartnerDto`.
  about                     String?
  /// The start of this partner's *current* settlement cycle — not "the last
  /// time some settlement-shaped event happened", which is what this column
  /// used to mean and why it was wrong (see docs/PARTNER_COLLECTIONS_HARDENING
  /// for the full story). It is set to `now()` only when this partner's
  /// `PARTNER_PAYABLE` balance actually *crosses zero* — either direction:
  ///
  ///  - non-zero → zero: a real, full settlement just happened. The sweep
  ///    below never alerts on a zero balance anyway, so this mostly just
  ///    keeps the clock honest for whenever the balance moves again.
  ///  - zero → non-zero: a fresh debt or credit was just born. The 14-day
  ///    clock for *this* balance starts now, not whenever the partner was
  ///    last settled — otherwise a brand-new balance inherits a stale
  ///    timestamp and looks instantly overdue.
  ///
  /// A balance that stays non-zero through a *partial* collection or payout
  /// does not cross zero, so this column does not move — the sweep keeps
  /// counting from whenever the debt actually started, which is the whole
  /// point: a 1 AMD payment against a 500,000 AMD debt must not buy 14 more
  /// days of silence.
  ///
  /// This is enforced in exactly one place — `LedgerService.post`/`.reverse`,
  /// the sole write path for every `PARTNER_PAYABLE`-affecting posting in the
  /// system (purchases, refunds, referral commissions, EV CDR reconciliation,
  /// payouts, collections) — rather than at each call site, so a future
  /// balance-changing code path cannot forget to keep this clock honest.
  ///
  /// Null for every partner that has never had a `PARTNER_PAYABLE` balance
  /// move at all — including every partner that predates this column — and
  /// the sweep treats null as overdue exactly like a real 14-day-old
  /// timestamp would be, so a partner is never silently skipped just because
  /// they are new.
  lastSettledAt             DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  memberships            PartnerMembership[]
  branches               PartnerBranch[]
  branchStaffAssignments PartnerBranchStaffAssignment[]
  branchQrCodes          PartnerBranchQrCode[]
  checkouts              PartnerCheckout[]
  integrations           PartnerIntegration[]
  transactions           Transaction[]
  qrCodes                QrCode[]
  evStations             EvStation[]
  userRoles              UserRole[]
  payments               Payment[]
  /// How often this partner is settled. Per-partner, not one global period:
  /// a weekly restaurant and a monthly fuel chain are both normal, and
  /// hardcoding one cadence would force the other into it (product decision, 14.09.2026).
  /// Next `EMP-<n>` this partner will issue, bumped atomically.
  ///
  /// Exists because picking a code by reading the highest one already used is
  /// a race: two requests read the same maximum and choose the same code.
  /// `UPDATE ... SET "employeeCodeSeq" = "employeeCodeSeq" + 1 RETURNING` is
  /// one statement, so PostgreSQL serialises concurrent callers on the row
  /// lock and each gets a different number.
  ///
  /// Both allocators use it — the permanent employee code and the older
  /// per-assignment display code — because they share one namespace per
  /// partner. A caller naming a code by hand raises the counter to at least
  /// that number, so a hand-picked `EMP-042` cannot be reached again later.
  employeeCodeSeq        Int                            @default(0)
  settlementPeriodicity  SettlementPeriodicity          @default(MONTHLY)
  /// Day the period is anchored to. 1-7 (Mon-Sun) for WEEKLY/BIWEEKLY, 1-28
  /// for MONTHLY — 28 so a monthly anchor exists in February too.
  settlementAnchorDay    Int                            @default(1)

  settlements          Settlement[]
  payouts              Payout[]
  collections          PartnerCollection[]
  partnerSettlements   PartnerSettlement[]
  bankAccounts         PartnerBankAccount[]
  purchaseIntents      PurchaseIntent[]
  refundRequests       PurchaseIntentRefundRequest[]
  offerings            PartnerOfferingItem[]
  apiKeys              PartnerApiKey[]
  roamingCustomerLinks RoamingCustomerLink[]
  /// Set only when this partner is itself a direct referrer (spec §21) —
  /// distinct from `referralInvitesAsReferrer`'s User-referrer counterpart.
  referralCode         ReferralCode?
  referralInvitesMade  ReferralInvite[]              @relation("PartnerReferrer")

  logoAsset                MediaAsset?               @relation("PartnerLogoAsset", fields: [logoAssetId], references: [id])
  coverAsset               MediaAsset?               @relation("PartnerCoverAsset", fields: [coverAssetId], references: [id])
  mediaAssets              MediaAsset[]              @relation("MediaAssetSubjectPartner")
  partnerContributionRules PartnerContributionRule[]
  promos                   PartnerPromo[]

  employees PartnerEmployee[]

  @@map("partners")
}

/// Where a tap on a Home "Partner Spotlight" card lands. Deliberately not a
/// free URL: a curated placement points into the product, never out of it.
enum PartnerPromoDestination {
  /// The partner's own page in the app.
  PARTNER
  /// The Partners map, so a chain with many branches lands on "nearest".
  PARTNERS_MAP
}

/// One curated placement in the Home "Partner Spotlight" strip.
///
/// This is a featured-partner list, not an advertising platform: a platform
/// administrator writes each card by hand, chooses its artwork, and decides
/// when it runs. A partner cannot create one from their own panel — an
/// owner-account compromise must not be able to put anything on every
/// customer's Home screen (the same reasoning as `MediaAssetStatus`).
///
/// Live = `active` AND the partner trades (`isActive`, `status = ACTIVE`)
/// AND `startAt <= now` (or null) AND `endAt > now` (or null). An expired or
/// inactive placement is never served, whatever `active` says — see
/// `PromosService.featured`.
model PartnerPromo {
  id              String                  @id @default(uuid())
  partnerId       String
  /// The card's words, per interface language:
  /// `{ hy?: { title, subtitle?, benefitLabel }, ru?: {...}, en?: {...} }`.
  /// A locale counts as filled when it has a title and a benefit label.
  /// The app asks for its own language; the API falls back
  /// requested → ru → first filled locale (`promo-translations.ts`), and a
  /// card with no filled locale at all is never served — an Armenian
  /// interface must not show Russian copy just because that is what the
  /// administrator typed first, and an empty translation must never render
  /// as an empty card.
  translations    Json                    @default("{}")
  /// A `PROMO_ARTWORK` asset, or null while the administrator has not yet
  /// uploaded one — the card then renders the partner's cover/logo fallback.
  artworkAssetId  String?
  destination     PartnerPromoDestination @default(PARTNER)
  /// A paid placement carries a small "Promo" mark on the card. Off for an
  /// editorial pick the platform simply wants to show.
  sponsored       Boolean                 @default(false)
  active          Boolean                 @default(false)
  /// Higher first. Ties break on `createdAt` desc.
  priority        Int                     @default(0)
  startAt         DateTime?
  endAt           DateTime?
  /// Counted by the app only when the card was actually on screen — see
  /// `PartnerSpotlight`'s viewability rule — not when the API returned it.
  /// Plain counters, no per-person rows: nothing here identifies anyone.
  impressionCount Int                     @default(0)
  openCount       Int                     @default(0)
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  partner      Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  artworkAsset MediaAsset? @relation("PartnerPromoArtwork", fields: [artworkAssetId], references: [id])

  @@index([active, priority])
  @@index([partnerId])
  @@map("partner_promos")
}

/// Spec §3. What a partner can accept payment/data through. Deliberately
/// generic-typed with a JSON `configuration` blob per spec's own instruction
/// not to fully build every future integration tonight — only the extension
/// point. `WEBSITE` is the one type with fields of its own, because domain
/// trust has a lifecycle (verified or not) that a JSON blob cannot express
/// as a queryable, constrained state — see `websiteVerifiedAt`.
enum PartnerIntegrationType {
  QR_PURCHASE
  WEBSITE
  API
  POS
  EV_CHARGING
  OCPI
}

enum PartnerIntegrationStatus {
  NOT_CONNECTED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model PartnerIntegration {
  id                String                   @id @default(uuid())
  partnerId         String
  partnerBranchId   String?
  type              PartnerIntegrationType
  status            PartnerIntegrationStatus @default(NOT_CONNECTED)
  configuration     Json?
  /// WEBSITE only. TODO: BUSINESS DECISION REQUIRED — the actual
  /// verification method (DNS TXT record, meta tag, file upload...) is not
  /// specified anywhere yet; until it is, a URL here can reach ACTIVE only
  /// through PENDING_VERIFICATION and a manual admin action, never
  /// automatically — see docs/CORE_ARCHITECTURE_MIGRATION_2026-08.md §4.
  websiteUrl        String?
  websiteVerifiedAt DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  partner Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  branch  PartnerBranch?  @relation(fields: [partnerBranchId], references: [id], onDelete: SetNull)
  apiKeys PartnerApiKey[]

  @@index([partnerId])
  @@map("partner_integrations")
}

/// Where a till-opened purchase stands, before and after a customer claims it.
/// After `CLAIMED` the linked `PurchaseIntent` is the truth; this row only
/// says which purchase the till's receipt became.
enum PartnerCheckoutStatus {
  OPEN
  CLAIMED
  CANCELLED
  EXPIRED
}

/// A purchase the partner's till (POS) opened, waiting for a customer to
/// claim it by scanning a dynamic QR — the owner's brief §20–21 (20.09.2026).
///
/// The point of the row: the *amount is partner-originated*. On the QR path
/// the customer types the gross and the cashier approves it; here the till
/// states it, under the partner's own M2M credential, and the customer only
/// chooses how to fund it. Everything after the claim is the same
/// `PurchaseIntent` engine, the same funding split, the same postings — a
/// checkout never produces different economics from a scan (§40, proved by
/// `partner-checkout.int-spec.ts`).
///
/// `token` is the only thing in the QR. Opaque, 24 random bytes, single-use,
/// and worth nothing after `expiresAt` — exactly like `PartnerBranchQrCode
/// .token`, but per purchase rather than per branch.
///
/// `externalReference` is the till's own receipt/order id, unique per
/// partner: a POS that retries a lost response cannot open the same sale
/// twice. `idempotencyKey` is the same idea for a client that has one.
model PartnerCheckout {
  id                String                @id @default(uuid())
  partnerId         String
  partnerBranchId   String?
  /// Which credential opened it — the till, by key, for the audit trail.
  apiKeyId          String
  externalReference String
  idempotencyKey    String?
  status            PartnerCheckoutStatus @default(OPEN)
  grossAmount       Decimal               @db.Decimal(18, 4)
  quantity          Decimal?              @db.Decimal(18, 4)
  quantityUnit      UnitOfMeasure?
  unitPrice         Decimal?              @db.Decimal(18, 4)
  /// The till's own clock for the sale, kept separately from `createdAt`.
  occurredAt        DateTime
  token             String                @unique
  expiresAt         DateTime
  purchaseIntentId  String?               @unique
  claimedByUserId   String?
  claimedAt         DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  partner        Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  branch         PartnerBranch?  @relation(fields: [partnerBranchId], references: [id])
  apiKey         PartnerApiKey   @relation(fields: [apiKeyId], references: [id])
  purchaseIntent PurchaseIntent? @relation(fields: [purchaseIntentId], references: [id])
  claimedBy      User?           @relation("PartnerCheckoutClaimedBy", fields: [claimedByUserId], references: [id])

  @@unique([partnerId, externalReference])
  @@unique([partnerId, idempotencyKey])
  @@index([partnerId, status])
  @@index([status, expiresAt])
  @@map("partner_checkouts")
}

/// One machine-to-machine credential for a `PartnerIntegration` — the "not a
/// human login/password" M2M mechanism requirement 3 of
/// docs/ROAMING_CPO_INTEGRATION_2026-08-25.md asks for, built on top of the
/// existing `PartnerIntegration`/`PartnerIntegrationType.API` extension point
/// rather than a parallel auth system. Only the hash is stored — the actual
/// key is returned once, at creation, by `PartnerApiKeyService.issue`, the
/// same "shown once, never again" discipline any API-key system uses.
model PartnerApiKey {
  id            String    @id @default(uuid())
  partnerId     String
  integrationId String?
  /// The public half of the credential — sent in the `x-api-key` header
  /// alongside the secret half, e.g. `pak_live_<keyId>.<secret>`, so a
  /// lookup never has to scan-and-compare every row's hash.
  keyId         String    @unique
  /// SHA-256 of the secret half. Never the secret itself — see
  /// `PartnerApiKeyService`.
  keyHash       String
  label         String?
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  partner           Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  integration       PartnerIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  checkouts         PartnerCheckout[]
  approvedPurchases PurchaseIntent[]    @relation("PurchaseIntentApprovedByApiKey")

  @@index([partnerId])
  @@map("partner_api_keys")
}

/// TuTak `User` ↔ roaming-CPO customer-id mapping.
///
/// Historically created by an authenticated TuTak user typing in their own
/// external customer id (`RoamingCpoCustomersService.link`, now removed —
/// see docs/ROAMING_CPO_INTEGRATION_2026-08-27-SECURITY.md, Problem 3). That
/// flow let a customer bind an arbitrary self-entered id with no proof it
/// was ever theirs, so every row it created is untrustworthy as an identity
/// claim. `verifiedAt` is the quarantine: null means "created by the old
/// customer-entered flow, or otherwise not yet proven" and
/// `RoamingCpoSettlementService` must refuse to settle money against it;
/// non-null means a TuTak/provider server-to-server handshake independently
/// confirmed the mapping (the only way a mapping may be created going
/// forward). Existing rows are migrated with `verifiedAt = null` — nothing
/// is silently reassigned or promoted to verified.
model RoamingCustomerLink {
  id                 String    @id @default(uuid())
  partnerId          String
  externalCustomerId String
  userId             String
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One external customer id names exactly one TuTak user per partner.
  @@unique([partnerId, externalCustomerId])
  /// A settlement/link lookup by TuTak user id (e.g. "is this user already
  /// linked?") without a table scan.
  @@index([userId])
  @@map("roaming_customer_links")
}

model PartnerMembership {
  id        String   @id @default(uuid())
  partnerId String
  userId    String
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@map("partner_memberships")
}

/// The three products a `fuel`-category branch actually sells. Distinct from
/// `Partner.sellsGas`/`sellsPetrol` — those are the *customer-facing map
/// filter*'s umbrella ("Газ" = propane + methane, one bucket), kept exactly
/// as they are; this is the real, per-branch classification a branch's own
/// staff/QR/pricing needs, which the umbrella was never precise enough to
/// answer. See the migration for how existing fuel branches were classified
/// (never guessed) and `geo.ts#FUEL_TYPES` for the customer-facing mapping.
enum BranchFuelType {
  PETROL
  METHANE_CNG
  PROPANE_LPG
}

/// A person's permanent, readable identity inside one partner organisation.
///
/// `PartnerBranchStaffAssignment.employeeDisplayCode` came first and is a
/// different thing: it names an *assignment to a branch*. Moving somebody to
/// another branch ends one assignment and starts another, so their code
/// changes; working two branches gives them two. That is right for an audit
/// trail of assignments and wrong for "who confirmed this sale" — a partner
/// looking at last month's receipts must see one person, not two identities
/// that happen to be the same human.
///
/// So the person's code lives here, one row per `(partnerId, userId)`,
/// allocated once and never reused for anybody else. Transfers, renames and
/// deactivation do not touch it.
///
/// ## Why not `PartnerMembership`, which already has `(partnerId, userId)`
///
/// Because that model does not mean what its name suggests. In production
/// code a row is created only for a partner's *founding owner*
/// (`PartnersService.create`/`apply`); every other staff member is attached
/// through a partner-scoped `UserRole` and never gets one — `isAffiliated`
/// exists precisely to paper over that, and says so. Worse, `isMember`
/// branches on the row's presence for self-dealing checks, so backfilling
/// memberships for staff would quietly change who is allowed to pay
/// themselves. A registry of employees had to be a new, additive table
/// rather than a redefinition of that one.
///
/// ## Not a credential
///
/// The code identifies; it never authorises. Nothing accepts it as input to
/// act as that person: the server reads the actor from the authenticated
/// session, and this column is only ever an output.
/// What kind of event moved a purchase to CONFIRMED — see
/// `PurchaseIntent.confirmationSource`.
enum PurchaseConfirmationSource {
  /// A person at a till, acting from their own authenticated session.
  STAFF
  /// The partner's own POS or API integration, acting on its key. Proves the
  /// partner's system said the sale happened; proves nothing about money
  /// reaching TuTak.
  PARTNER_INTEGRATION
  /// A payment provider reporting that it collected the money. The only one
  /// of the three that is evidence of a payment to TuTak, and never to be
  /// shown as a cashier's action.
  PROVIDER_CALLBACK
}

model PartnerEmployee {
  id        String @id @default(uuid())
  partnerId String
  userId    String
  /// `EMP-001`, unique within the partner and never handed to a second
  /// person — including after the first one leaves, so a purchase confirmed
  /// in March still resolves to the person who confirmed it.
  code      String

  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@unique([partnerId, code])
  @@map("partner_employees")
}

/// Where a branch stands in its life, as the partner's owner manages it.
///
/// `isActive` came first and answers one question — may a purchase be taken
/// here right now. It stays, it stays in step with this column (the database
/// enforces that, `partner_branches_state_matches_is_active`), and every
/// query that reads it keeps working. What it cannot say is *why* a branch is
/// shut, and the two reasons need different screens: a location closed for
/// refurbishment comes back, and a location that is gone does not.
enum PartnerBranchState {
  /// Open. Purchases may be taken here.
  ACTIVE
  /// Temporarily shut by the owner. No new purchases; returns, disputes and
  /// history all continue to work; the owner may reopen it.
  SUSPENDED
  /// Closed for good. Everything `SUSPENDED` allows, minus reopening in one
  /// click — restoring it is a deliberate act — and it drops out of the
  /// ordinary branch list rather than sitting there forever.
  ARCHIVED
}

model PartnerBranch {
  id        String          @id @default(uuid())
  partnerId String
  name      String
  address   String
  city      String
  latitude  Float
  longitude Float
  /// Whether this branch is currently open and should be shown to
  /// customers. Deactivating rather than deleting: `PurchaseIntent` and
  /// `PartnerIntegration` rows reference a branch by id, and a real
  /// financial/audit history must keep resolving to the branch it happened
  /// at even after that location closes. Defaults true — every branch that
  /// predates this column is, in fact, still open; there is no historical
  /// case where the true value is otherwise.
  isActive  Boolean         @default(true)
  /// Why it is open or shut — see `PartnerBranchState`.
  ///
  /// Kept beside `isActive` rather than replacing it. Replacing it would
  /// have meant rewriting every read in the codebase and every released
  /// client in one step, to answer a question none of them asks: they all
  /// want "may I sell here", and `isActive` is that answer. The database
  /// keeps the two from drifting.
  state     PartnerBranchState @default(ACTIVE)
  /// When the owner last shut or reopened it, and who did. Null on a branch
  /// that has only ever been open.
  stateChangedAt       DateTime?
  stateChangedByUserId String?
  /// Meaningful only when the owning `Partner.category` is `"fuel"` — which
  /// single product this specific branch sells. Null for every non-fuel
  /// branch. Also null for a fuel branch nobody has classified yet: this is
  /// never inferred from `Partner.sellsGas`/`sellsPetrol` (those only say
  /// the *partner* sells "gas" and/or "petrol" somewhere across its
  /// network, not which branch sells which) — see the migration doc for how
  /// the existing fuel partners' branches were left unclassified rather
  /// than guessed at, and `PartnerBranchesService.setFuelType` for the
  /// owner/admin action that fills this in.
  fuelType  BranchFuelType?
  createdAt DateTime        @default(now())

  partner          Partner                        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  integrations     PartnerIntegration[]
  purchaseIntents  PurchaseIntent[]
  checkouts        PartnerCheckout[]
  refundRequests   PurchaseIntentRefundRequest[]
  staffAssignments PartnerBranchStaffAssignment[]
  qrCodes          PartnerBranchQrCode[]
  transactions     Transaction[]

  // Lets `PartnerBranchStaffAssignment`/`PartnerBranchQrCode` declare a
  // composite FK on (partnerId, id) — the DB-level guarantee that an
  // assignment or QR code can never point at a branch belonging to a
  // *different* partner than the one it also names, without a trigger.
  @@unique([partnerId, id])
  // The owner's branch list hides archived rows; the purchase path asks for
  // open ones. Both are per-partner reads.
  @@index([partnerId, state])
  @@map("partner_branches")
}

enum BranchStaffRole {
  /// Ordinary day-to-day access at the assigned branch(es) — confirm/
  /// reject/refund, same as the platform-wide `PARTNER_STAFF` tier already
  /// grants, just narrowed to the branches listed here.
  STAFF
  /// A trusted employee an owner has put in charge of a branch — same
  /// operational reach as STAFF today (this table only ever narrows *which*
  /// branches, never *what* a role may do there; that stays on
  /// `RoleName`/`PermissionName`). Kept as its own value because the
  /// partner portal's staff list needs to say who is "in charge" of a
  /// branch, distinctly from an ordinary cashier, even though both resolve
  /// to the same permission check today.
  MANAGER
}

/// Which of a multi-branch partner's locations a given member of staff may
/// actually act at. `UserRole` (PARTNER_STAFF/PARTNER_MANAGER, scoped to
/// `partnerId`) already answers "can this person confirm a purchase intent
/// for this partner at all" — nothing before this table answered "at which
/// of the partner's branches", so a `PARTNER_STAFF` grant was, in effect,
/// access to every branch a partner had. That is exactly the gap the
/// fuel-station branches task exists to close: branch-A staff must never
/// see branch-B's queue or history.
///
/// `PARTNER_OWNER` and platform admins need no row here — they already see
/// every branch of their own partner (`hasBranchScope`). A `UserRole` with
/// `allBranches: true` (an owner/admin-granted exception for a trusted
/// manager) also needs none, for the same reason.
///
/// A user with zero *active* rows here, who is not covered by either
/// exception above, and whose partner has at least one branch, is
/// deliberately unassigned: every branch-scoped endpoint refuses them
/// rather than defaulting to "every branch" — see the migration doc for how
/// this is what every pre-existing `PARTNER_STAFF`/`PARTNER_MANAGER` role
/// lands in the moment this ships, until an owner/admin explicitly assigns
/// a branch.
model PartnerBranchStaffAssignment {
  id                  String          @id @default(uuid())
  partnerId           String
  partnerBranchId     String
  userId              String
  role                BranchStaffRole @default(STAFF)
  /// Short, partner-unique, human-readable identity for receipts and audit
  /// trails — e.g. "B-014" — so a confirm/reject/refund record stays
  /// legible without exposing a raw user id. Assigned once at creation and
  /// never reused, including after deactivation, so a historical record
  /// naming this code always resolves to the one person who held it.
  employeeDisplayCode String
  /// False once an owner/admin takes this person off the branch. The row
  /// itself is never deleted: every confirm/reject/refund this person made
  /// while active still has to resolve to who they were and which branch
  /// they were assigned to at the time.
  isActive            Boolean         @default(true)
  assignedByUserId    String
  createdAt           DateTime        @default(now())
  deactivatedAt       DateTime?
  deactivatedByUserId String?

  partner       Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  branch        PartnerBranch @relation(fields: [partnerId, partnerBranchId], references: [partnerId, id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy    User          @relation("BranchStaffAssignedBy", fields: [assignedByUserId], references: [id])
  deactivatedBy User?         @relation("BranchStaffDeactivatedBy", fields: [deactivatedByUserId], references: [id])

  // "At most one ACTIVE assignment per (user, branch)" is a partial unique
  // index added by hand in the migration — Prisma has no `@@unique` syntax
  // for a `WHERE` clause. A deactivated row is intentionally left in place
  // (history), so a plain unique constraint here would block reassigning
  // the same person to the same branch later.
  @@unique([partnerId, employeeDisplayCode])
  @@index([userId])
  @@index([partnerBranchId, isActive])
  @@map("partner_branch_staff_assignments")
}

enum PartnerBranchQrStatus {
  ACTIVE
  REVOKED
}

/// A branch's own scan-to-pay identity. Extends the existing QR
/// infrastructure's own pattern — a random, unique, server-resolved
/// `token`, exactly like `QrCode.token` — rather than building a second QR
/// system next to it; this is a separate model only because `QrCode` itself
/// is the *legacy* `POST /qr/redeem` flow (see the model's own docblock),
/// permanently refuses `STATIC_MERCHANT` redemption
/// (`QrPaymentsService.redeem`), and answers a different question (a
/// reusable, fixed-amount invoice) than a branch code needs to (an identity
/// that always lands on `PurchaseIntentsService.create()`, with no amount
/// ever encoded in the code itself). See `partnerPayQr.ts` for the
/// plaintext `TUTAK-PAY:<partnerId>:<branchId>` payload this replaces for
/// fuel-category branches, and why that payload could never be revoked,
/// rotated, or verified server-side — anyone who read it off a photo could
/// reconstruct the exact same string forever.
///
/// At most one ACTIVE row per branch, enforced by a partial unique index in
/// the migration. Rotating a branch's code is revoke-then-issue, wrapped in
/// one transaction by `PartnerBranchQrService.rotate()` — never an update
/// of an existing token, so a revoked token can never become valid again by
/// accident.
model PartnerBranchQrCode {
  id              String                @id @default(uuid())
  partnerId       String
  partnerBranchId String
  token           String                @unique
  status          PartnerBranchQrStatus @default(ACTIVE)
  issuedByUserId  String
  createdAt       DateTime              @default(now())
  revokedAt       DateTime?
  revokedByUserId String?

  partner   Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  branch    PartnerBranch @relation(fields: [partnerId, partnerBranchId], references: [partnerId, id], onDelete: Cascade)
  issuedBy  User          @relation("BranchQrIssuedBy", fields: [issuedByUserId], references: [id])
  revokedBy User?         @relation("BranchQrRevokedBy", fields: [revokedByUserId], references: [id])

  @@index([partnerBranchId, status])
  @@map("partner_branch_qr_codes")
}

/// One row of the partner's optional public product/service list — the
/// "список из своих товаров/услуг с ценами" half of the public profile
/// Confirmed by the product decision of 2026-08-23. Deliberately partner-level, not per-branch,
/// same reasoning as `logoAssetId`/`coverAssetId`: a chain's offering is one
/// identity, not one per shop front.
///
/// This is explicitly NOT a marketplace: there is no `PurchaseIntent` or
/// `Transaction` reference to a row here, no stock/inventory, no cart. It is
/// a read-only listing the customer sees on the partner's page. The shape
/// (its own table, one row per item, a stable id, a price in the platform's
/// own money precision) is chosen so that a real "order this" flow could be
/// layered on top later — e.g. a future `PurchaseIntent.offeringId` — without
/// reshaping this table: the schema is required to make that later addition
/// cheap rather than a migration of every existing row.
model PartnerOfferingItem {
  id           String   @id @default(uuid())
  partnerId    String
  name         String
  description  String?
  /// AMD, implicit — same as every other money column in this schema; see
  /// the file header note. No currency field for the same reason none of the
  /// transaction/payment tables carry one.
  price        Decimal  @db.Decimal(18, 4)
  /// Explicit rather than `createdAt` ordering: a partner reordering their
  /// own list (moving their best seller to the top) is an expected edit, and
  /// `createdAt` cannot express "move item 3 first" without rewriting
  /// timestamps. Written by `PartnersService.replaceOfferings` as the
  /// submitted array's own index — see that method's doc comment for why a
  /// bulk replace rather than per-item reordering.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_offering_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Referral Engine
// ─────────────────────────────────────────────────────────────────────────

/// A code belongs to exactly one of a User or a Partner (spec §21: a partner
/// may be a direct referrer too) — enforced in `ReferralService`, not by a DB
/// check constraint, to avoid depending on a Prisma preview feature this
/// project has not otherwise opted into.
model ReferralCode {
  id        String   @id @default(uuid())
  userId    String?  @unique
  partnerId String?  @unique
  code      String   @unique
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

enum ReferralInviteStatus {
  PENDING
  QUALIFIED
  REWARDED
  EXPIRED
  FRAUD_BLOCKED
}

enum ReferrerType {
  USER
  PARTNER
}

/// Explicit, persisted eligibility boundary between the referral engine's
/// two economic models (2026-08-22 rework) — deliberately a stored value
/// on each priced money operation, never inferred by comparing a row's
/// `createdAt`/`confirmedAt` to a release date. `PurchaseIntent`/`EvSession`
/// rows with this column null are LEGACY (confirmed before this enum
/// existed, single-level referrer share only); `THREE_LEVEL_V2` rows are
/// priced by the new six-leg pool split (`ReferralService.computePoolSplit`)
/// and carry the new `referrer1Amount`/`referrer2Amount`/`referrer3Amount`/
/// `tutakAmount` snapshot columns instead of the legacy `referrerAmount`.
/// Nothing here retroactively reprices a legacy row, and no code path walks
/// a legacy row's referral chain as though it were 3 levels deep.
enum ReferralProgramVersion {
  LEGACY_SINGLE_LEVEL
  THREE_LEVEL_V2
}

/// Attribution record — who referred whom, set once at registration and
/// never changed (spec §5: immutable). This is *not* where either reward
/// mechanic is computed or paid: the recurring 20%-of-pool share (spec §6)
/// happens per purchase in `PurchaseIntentService`, reading this row only to
/// know who to pay; the Referral Challenge (spec §18) tracks its own
/// progress entirely on `ReferralChallengeParticipant`. `status` /
/// `qualifyingAction` / `rewardAmount` / `qualifiedAt` / `rewardedAt` below
/// are what this model used *before* the Challenge got its own table — a
/// flat one-time reward tracked right here. Current code never writes them;
/// they are read-only history for rows created before this migration. See
/// docs/CORE_ARCHITECTURE_MIGRATION_2026-08.md §3.
model ReferralInvite {
  id                String               @id @default(uuid())
  referrerType      ReferrerType         @default(USER)
  /// Exactly one of these two is set, matching `referrerType`.
  referrerUserId    String?
  referrerPartnerId String?
  refereeUserId     String               @unique
  /// @deprecated Legacy pre-Challenge reward tracking — see the model
  /// docblock. Left in place rather than dropped so historical rows stay
  /// readable; not written by any current code path.
  status            ReferralInviteStatus @default(PENDING)
  qualifyingAction  String?
  rewardAmount      Decimal?             @db.Decimal(18, 4)
  createdAt         DateTime             @default(now())
  qualifiedAt       DateTime?
  rewardedAt        DateTime?

  referrer        User?    @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referrerPartner Partner? @relation("PartnerReferrer", fields: [referrerPartnerId], references: [id], onDelete: Cascade)
  referee         User     @relation("Referee", fields: [refereeUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([referrerPartnerId])
  @@map("referral_invites")
}

enum DeferredBonusLotStatus {
  DEFERRED
  AVAILABLE
  EXPIRED
}

/// Spec §13-16. The "black"/deferred 30% pool share. Deliberately does
/// **not** touch `Wallet`/`BonusLot` at creation — see the migration doc §3
/// for why reusing `BonusLot`'s time-based PENDING→AVAILABLE sweep would be
/// wrong for a turnover-gated unlock. A real, spendable `BonusLot` is only
/// created (via `BonusEngineService.accrue`) at the moment this unlocks.
model DeferredBonusLot {
  id                       String                 @id @default(uuid())
  userId                   String
  sourceTransactionId      String
  /// The original, immutable grant — `amounts_sane` requires this stay
  /// strictly positive for as long as the row exists, so a
  /// `PurchaseIntentRefundService` refund reduces `refundedAmount` instead
  /// of this column, the same way `PurchaseIntent` tracks its own refunds
  /// separately from `grossAmount`.
  amount                   Decimal                @db.Decimal(18, 4)
  status                   DeferredBonusLotStatus @default(DEFERRED)
  requiredTurnover         Decimal                @db.Decimal(18, 4)
  /// Cumulative eligible gross purchases applied to this lot so far. Spec
  /// §14: no monthly minimum, purely cumulative within the window.
  progressTurnover         Decimal                @default(0) @db.Decimal(18, 4)
  /// Running total reversed by TuTak refunds against *this lot's own*
  /// originating purchase (`sourceTransactionId`) — never more than
  /// `amount`, and untouched by an *external* contributing purchase's
  /// refund (see `forfeitedAmount` and `reverseUnlock`).
  refundedAmount           Decimal                @default(0) @db.Decimal(18, 4)
  /// Running total permanently forfeited because a *previous* unlock's
  /// grant was already partly spent by the time an external contributing
  /// purchase's refund invalidated it — that spent slice can never be
  /// re-granted (independent audit, GitHub issue #28: `reverseUnlock` must
  /// not conflate an external-contribution clawback with this lot's own
  /// purchase being refunded, or a still-valid entitlement is destroyed
  /// forever instead of remaining re-qualifiable). The *un*spent, actually
  /// reclaimed portion of an invalidated grant is deliberately not tracked
  /// here or anywhere else — it simply returns to being ordinary
  /// outstanding `BONUS_LIABILITY`, exactly as if it had never vested,
  /// available to grant again in full if this lot re-qualifies. Together
  /// with `refundedAmount`, what remains ever-grantable is always
  /// `amount - refundedAmount - forfeitedAmount`.
  forfeitedAmount          Decimal                @default(0) @db.Decimal(18, 4)
  createdAt                DateTime               @default(now())
  deadline                 DateTime
  unlockedAt               DateTime?
  expiredAt                DateTime?
  /// The BonusLot backing this lot's *currently live* grant, for
  /// traceability — null while `DEFERRED` (never unlocked, or reverted to
  /// re-accumulate after `reverseUnlock` clawed an invalid grant back).
  grantedBonusLotId        String?
  /// How much of the *currently live* grant (`grantedBonusLotId`) has
  /// already been clawed back and accounted for by `reverseForRefund` (this
  /// lot's own originating purchase being partially refunded while the lot
  /// is `AVAILABLE`), since that grant was created. Scoped to one grant
  /// episode: reset to 0 every time a new grant is issued or the live grant
  /// is cleared. `reverseUnlock` subtracts this from what it claws back to
  /// find how much of the grant was actually spent by the customer — without
  /// it, a grant partly reclaimed by `reverseForRefund` and *then*
  /// invalidated by an external contributor's refund gets that same slice
  /// double-counted as newly-discovered "spent" value: forfeited a second
  /// time and a phantom `BONUS_LIABILITY`/`PLATFORM_REVENUE` posting made for
  /// money that was never actually lost, while permanently destroying an
  /// amount of this lot's still-valid entitlement that was never refunded
  /// (independent audit, GitHub issue #28 — found by a second audit pass
  /// against the `forfeitedAmount` fix itself, before this field existed).
  liveGrantReclaimedAmount Decimal                @default(0) @db.Decimal(18, 4)

  user          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions DeferredBonusLotContribution[]

  @@index([userId, status])
  @@index([status, deadline])
  @@index([sourceTransactionId])
  @@map("deferred_bonus_lots")
}

/// Records exactly how much turnover one purchase (`sourceTransactionId`)
/// contributed to an *existing* lot via `advanceExistingLots` — the
/// traceability `DeferredBonusLotService.reverseForRefund` used to lack for
/// any lot other than the one the refunded purchase itself created (that
/// method's own docblock called this out: "nothing records which lot
/// received how much turnover from which purchase"). A refund reverses
/// exactly this recorded amount, never more, and only ever from a lot that
/// has not yet unlocked (independent audit, GitHub issue #28).
model DeferredBonusLotContribution {
  id                  String   @id @default(uuid())
  lotId               String
  sourceTransactionId String
  /// This purchase's turnover contribution, as originally applied.
  amount              Decimal  @db.Decimal(18, 4)
  /// Running total already reversed by refunds of this same purchase —
  /// mirrors `DeferredBonusLot.refundedAmount`'s own separate-running-total
  /// pattern rather than decrementing `amount` itself.
  reversedAmount      Decimal  @default(0) @db.Decimal(18, 4)
  createdAt           DateTime @default(now())

  lot DeferredBonusLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, sourceTransactionId])
  @@index([sourceTransactionId])
  @@map("deferred_bonus_lot_contributions")
}

enum ReferralChallengeParticipantStatus {
  IN_PROGRESS
  QUALIFIED
  REWARDED
}

/// Spec §18-20, "first 3 qualified friends". One row per (referrer, referee)
/// pair, created alongside the `ReferralInvite` for that referee and tracking
/// its own cumulative-turnover progress independently of the recurring
/// referral share. `rewardedAt` is only ever set for a referrer's first
/// three participants to reach QUALIFIED — enforced with a count check inside
/// a Serializable transaction (see `ReferralService.tryClaimChallengeSlot`),
/// the same concurrency idiom `BonusEngineService.reserve` already uses,
/// rather than a new primitive.
model ReferralChallengeParticipant {
  id                 String                             @id @default(uuid())
  referrerUserId     String
  refereeUserId      String                             @unique
  status             ReferralChallengeParticipantStatus @default(IN_PROGRESS)
  requiredAmount     Decimal                            @db.Decimal(18, 4)
  progressAmount     Decimal                            @default(0) @db.Decimal(18, 4)
  qualifiedAt        DateTime?
  rewardedAt         DateTime?
  /// The two `BonusLot`s `tryRewardChallengeSlot` granted on REWARDED — one
  /// per side — so a later refund that drops `progressAmount` back below
  /// `requiredAmount` can find and claw them back precisely, the same
  /// traceability `DeferredBonusLot.grantedBonusLotId` already gives the
  /// deferred-lot unlock (independent audit, GitHub issue #28). Null until
  /// (and unless) REWARDED.
  referrerBonusLotId String?
  refereeBonusLotId  String?
  createdAt          DateTime                           @default(now())

  referrer      User                            @relation("ChallengeReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referee       User                            @relation("ChallengeReferee", fields: [refereeUserId], references: [id], onDelete: Cascade)
  contributions ReferralChallengeContribution[]

  @@index([referrerUserId, status])
  @@map("referral_challenge_participants")
}

/// Records exactly how much one transaction contributed to a participant's
/// `progressAmount` in `ReferralService.advanceChallengeProgress` — a
/// transaction only ever contributes while the participant is still
/// IN_PROGRESS (the method early-exits otherwise), so this is the only
/// reliable way to know, at refund time, whether a given purchase's amount
/// is actually part of the current tally. A refund reverses exactly this
/// recorded amount, and only while the participant has not yet been
/// REWARDED — a paid-out reward is a real, already-spendable wallet credit
/// this refund does not attempt to claw back (independent audit, GitHub
/// issue #28).
model ReferralChallengeContribution {
  id             String   @id @default(uuid())
  participantId  String
  transactionId  String   @unique
  amount         Decimal  @db.Decimal(18, 4)
  reversedAmount Decimal  @default(0) @db.Decimal(18, 4)
  createdAt      DateTime @default(now())

  participant ReferralChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("referral_challenge_contributions")
}

// ─────────────────────────────────────────────────────────────────────────
// EV Charging (OCPI-oriented — modeled to map cleanly onto OCPI 2.2.1
// Location/EVSE/Session/CDR modules so a roaming CPO adapter can be plugged
// in without a schema change)
// ─────────────────────────────────────────────────────────────────────────

enum EvConnectorType {
  TYPE_2
  CCS2
  CHADEMO
  GBT_DC
}

enum EvConnectorStatus {
  AVAILABLE
  BLOCKED
  CHARGING
  INOPERATIVE
  OUTOFORDER
  PLANNED
  REMOVED
  RESERVED
  UNKNOWN
}

/// A station's control/tariff model. `INTERNAL` (the default, every station
/// that predates this column) is a TuTak-owned charger, billed at
/// `EvConnector.pricePerKwh` and started/stopped by TuTak directly.
/// `ROAMING_CPO` marks a station that belongs to a roaming-CPO
/// wholesale-resale integration (docs/ROAMING_CPO_INTEGRATION_2026-08-25.md,
/// docs/ROAMING_CPO_INTEGRATION_2026-08-27-SECURITY.md): the customer still
/// starts/monitors/stops entirely through the TuTak app, exactly like an
/// `INTERNAL` station — TuTak sends the CPO an authenticated remote
/// Start/Stop command via `OcpiAdapter` (keyed off `EvConnector.ocpiEvseUid`)
/// and bills from the CPO's own trusted CDR, never a customer-reported
/// meter value. Whether a given `ROAMING_CPO` station is actually reachable
/// this way is `EvStation.customerChargingEnabled`, not this enum value —
/// see that column's docblock. `RoamingCpoSettlementService` (the older
/// walk-in-at-the-CPO settlement path) still exists for a partner that
/// settles a session outside the app entirely, but that path is no longer
/// how an ordinary TuTak customer charges.
enum EvStationProvider {
  INTERNAL
  ROAMING_CPO
}

model EvStation {
  id                        String            @id @default(uuid())
  partnerId                 String
  name                      String
  address                   String
  city                      String
  latitude                  Float
  longitude                 Float
  ocpiLocationId            String?           @unique
  /// See `EvStationProvider`. Default `INTERNAL` is a no-op backfill for
  /// every station that predates the roaming-CPO integration — this
  /// migration changes nothing about how any existing station behaves.
  provider                  EvStationProvider @default(INTERNAL)
  /// The roaming-CPO partner's own stable id for this location, synced by
  /// `RoamingCpoStationsService.sync` — the "each station/EVSE/connector
  /// needs its own stable external ID from the partner" requirement. Null
  /// for every `INTERNAL` station.
  externalStationId         String?           @unique
  /// The roaming-CPO partner's current standard/walk-in tariff at this
  /// station — for display/audit only. A specific session almost never
  /// settles at this rate; see `EvSession.appliedCustomerRatePerKwh`, which
  /// is what a session actually bills, and `EvSession.stationRetailRatePerKwh`,
  /// the frozen copy of *this* column at the moment that session settled. A
  /// later edit here (a station raising its posted price) never touches a
  /// past session's own snapshot — same immutability discipline as
  /// `PurchaseIntent.negotiatedRateBps`.
  standardRetailRatePerKwh  Decimal?          @db.Decimal(10, 2)
  /// Explicit safety gate — docs/ROAMING_CPO_INTEGRATION_2026-08-27-SECURITY.md.
  /// A station is discoverable by `EvStationsService.listNearby` and
  /// startable by `EvSessionsService.start` only when this is true. Never
  /// inferred from `provider` or from the mere presence of
  /// `EvConnector.ocpiEvseUid` — a wired adapter can still be unhealthy, and
  /// the governing rule is "missing/No-op adapter must reject, never
  /// simulate success," so this is a second, independent, explicitly-set
  /// gate on top of the adapter's own real-time answer, not a replacement
  /// for it. `INTERNAL` stations are backfilled `true` (TuTak's own
  /// hardware; this is a no-op for every station that predates the
  /// capability model). Every `ROAMING_CPO` station starts `false` — it must
  /// be turned on deliberately, per station, once its remote Start/Stop and
  /// trusted-CDR path is proven working end to end.
  customerChargingEnabled   Boolean           @default(false)
  /// Whether this station's wired adapter has been confirmed to accept an
  /// authenticated remote Start command. Distinct from
  /// `customerChargingEnabled`: a partner may be synced and its remote-start
  /// path verified before anyone flips the customer-facing switch.
  remoteStartSupported      Boolean           @default(false)
  /// Same for Stop.
  remoteStopSupported       Boolean           @default(false)
  /// Whether this station's completed sessions are billed from a CPO-issued,
  /// server-to-server-trusted CDR (`OcpiAdapter.fetchCdr`) rather than a
  /// customer-reported meter value. A station may have this false even with
  /// remote start/stop wired — trusted billing is a separate capability, and
  /// a session on such a station must never be billed from
  /// `EvSessionsService.reportMeterValue`.
  trustedTelemetrySupported Boolean           @default(false)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  partner    Partner       @relation(fields: [partnerId], references: [id])
  connectors EvConnector[]

  @@index([partnerId, provider])
  @@index([customerChargingEnabled])
  @@map("ev_stations")
}

model EvConnector {
  id                  String            @id @default(uuid())
  stationId           String
  ocpiEvseUid         String?           @unique
  connectorType       EvConnectorType
  status              EvConnectorStatus @default(AVAILABLE)
  powerKw             Decimal           @db.Decimal(8, 2)
  pricePerKwh         Decimal           @db.Decimal(10, 2)
  /// The roaming-CPO partner's own stable id for this connector/EVSE — the
  /// connector-level half of `EvStation.externalStationId`. Null for every
  /// `INTERNAL` connector. Deliberately separate from `ocpiEvseUid`: that
  /// column is the *roaming OCPI* identity TuTak uses to command a remote CPO
  /// (`OcpiAdapter.startRemoteSession`), which a roaming-CPO session never
  /// goes through (requirement 1 — TuTak never starts/stops one of its
  /// chargers) — conflating the two would wire a webhook-only integration
  /// into the OCPI command path by accident.
  externalConnectorId String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  station      EvStation       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  sessions     EvSession[]
  reservations EvReservation[]

  @@index([status])
  @@map("ev_connectors")
}

enum EvSessionStatus {
  RESERVED
  AUTHORIZED
  CHARGING
  SUSPENDED
  /// The customer has stopped an app-initiated `ROAMING_CPO` session (the
  /// remote stop command was already sent, the connector is already back to
  /// `AVAILABLE`) but it has not been billed yet — this session's own
  /// `reportMeterValue` has always been refused, so nothing here knows how
  /// much energy was actually delivered until the CPO's own trusted CDR
  /// arrives. `EvCdrReconciliationService` polls for it and completes the
  /// session (bills the frozen retail rate, splits the frozen wholesale
  /// margin, accrues bonus) the first time it succeeds — see that service's
  /// `completeAppInitiatedSession`. A session never reaches `COMPLETED`
  /// from here without going through that one path.
  AWAITING_SETTLEMENT
  COMPLETED
  INVALID
  CANCELLED
}

model EvSession {
  id                          String                  @id @default(uuid())
  connectorId                 String
  userId                      String
  reservationId               String?                 @unique
  status                      EvSessionStatus         @default(AUTHORIZED)
  startedAt                   DateTime?
  stoppedAt                   DateTime?
  energyKwh                   Decimal?                @db.Decimal(10, 3)
  cost                        Decimal?                @db.Decimal(18, 4)
  bonusEarnedAmount           Decimal?                @db.Decimal(18, 4)
  transactionId               String?                 @unique
  ocpiCdrId                   String?                 @unique
  /// The pool split's actual settled amounts — the 2026-08-18 business
  /// decision's `evTutakUpfrontBps` cut plus the green/deferred/referrer
  /// legs `EvSessionsService.stopOnce` posted, snapshotted at settlement so
  /// a later CDR correction (`EvCdrReconciliationService.correctOvercharge`)
  /// reverses the *historical* allocation rather than recomputing bps from
  /// whatever `purchasePolicy` says today — same reasoning as
  /// `PurchaseIntent`'s own snapshot columns. Null for a session that never
  /// reached the earning-eligible branch (no partner rate, unverified
  /// phone, or self-dealing) — nothing was ever split, so there is nothing
  /// to snapshot. `tutakBaseOfRemainder` is not stored — it is, and
  /// remains, `poolAmount - tutakUpfrontAmount - greenAmount -
  /// deferredAmount - referrerAmount`, by construction.
  poolAmount                  Decimal?                @db.Decimal(18, 4)
  /// @deprecated LEGACY single-level program only — the extra TuTak cut
  /// taken off the top before the old green/deferred/referrer/tutak split.
  /// The 3-level program (`programVersion = THREE_LEVEL_V2`) does not use
  /// this: its whole pool splits directly by the six-leg rule, with no
  /// separate upfront cut (`docs/REFERRAL_3_LEVEL_REWORK_2026-08-22.md`, 2026-08-22 rework,
  /// requirement 4 — a duplicate TuTak cut on top of the six-leg split is
  /// explicitly forbidden). Null for any row settled under the new program.
  tutakUpfrontAmount          Decimal?                @db.Decimal(18, 4)
  greenAmount                 Decimal?                @db.Decimal(18, 4)
  deferredAmount              Decimal?                @db.Decimal(18, 4)
  /// @deprecated LEGACY single-level program's own referrer snapshot — see
  /// `PurchaseIntent.referrerAmount`'s docblock for why this is kept
  /// unrenamed rather than reused by the new program.
  referrerAmount              Decimal?                @db.Decimal(18, 4)
  /// Explicit, persisted eligibility boundary — same meaning as
  /// `PurchaseIntent.programVersion`. Null for every session settled before
  /// the 3-level referral rework; `THREE_LEVEL_V2` after.
  programVersion              ReferralProgramVersion?
  /// The 3-level program's own per-level snapshot — same shape and same
  /// reasoning as `PurchaseIntent`'s own `referrer1Type`/etc. columns; see
  /// that model's docblock.
  referrer1Type               ReferrerType?
  referrer1UserId             String?
  referrer1PartnerId          String?
  referrer1Amount             Decimal?                @db.Decimal(18, 4)
  referrer2Type               ReferrerType?
  referrer2UserId             String?
  referrer2PartnerId          String?
  referrer2Amount             Decimal?                @db.Decimal(18, 4)
  referrer3Type               ReferrerType?
  referrer3UserId             String?
  referrer3PartnerId          String?
  referrer3Amount             Decimal?                @db.Decimal(18, 4)
  tutakAmount                 Decimal?                @db.Decimal(18, 4)
  /// The roaming-CPO wholesale-resale integration's own snapshot columns
  /// (docs/ROAMING_CPO_INTEGRATION_2026-08-25.md). Null for every
  /// `INTERNAL`-provider session. Written by one of two places, never both:
  ///
  ///  - The walk-in path (`RoamingCpoSettlementService.settle`) writes every
  ///    one of them in the same transaction as the row's creation — the
  ///    partner already knows the final energy/cost at report time, so
  ///    there is no reason to split the write.
  ///  - The app-initiated path (docs/ROAMING_CPO_FINANCIAL_ACCOUNTING_2026-08-29.md)
  ///    genuinely cannot: `start()` freezes `stationRetailRatePerKwh`/
  ///    `wholesaleRatePerKwh`/`marginReferralCapPerKwh` the moment the
  ///    session opens (before any energy has flowed), and
  ///    `EvCdrReconciliationService.completeAppInitiatedSession` fills in
  ///    `appliedCustomerRatePerKwh`/`marginPerKwh`/
  ///    `uncappedMarginRevenueAmount`/`poolAmount`/the referrer legs once
  ///    the CPO's trusted CDR finally arrives — a session sits with the
  ///    first three populated and the rest null throughout
  ///    `AWAITING_SETTLEMENT`, which is exactly what that status means.
  ///
  /// `externalSessionId` is the idempotency backstop: the partner's own
  /// session id, globally unique here, so a duplicate webhook delivery
  /// for the same session can never create a second row — see that
  /// service's docblock for why a unique index and not only
  /// `IdempotencyService` is the guarantee.
  externalSessionId           String?                 @unique
  /// The roaming-CPO partner's own customer id for this session — kept here
  /// too (in addition to `RoamingCustomerLink`, the durable mapping) purely
  /// as an audit trail of exactly what the partner reported for *this*
  /// session, which a later change to the link must not retroactively alter.
  externalCustomerId          String?
  /// `EvStation.standardRetailRatePerKwh` *as it was* when this session
  /// settled — display/audit only, never what this session was billed at.
  stationRetailRatePerKwh     Decimal?                @db.Decimal(10, 2)
  /// The tariff this specific session actually settled at, exactly as the
  /// roaming-CPO partner reported it — never inferred, never a station
  /// default. `cost` (already on this row) is
  /// `energyKwh * appliedCustomerRatePerKwh`, the partner's own reported
  /// final amount, sanity-checked against that product at settlement time.
  appliedCustomerRatePerKwh   Decimal?                @db.Decimal(10, 2)
  /// `Partner.evWholesaleRatePerKwh` *as it was* when this session settled —
  /// the contractual per-kWh rate TuTak owed the roaming-CPO partner for
  /// this session, frozen here so a later change to the partner's contract
  /// terms never alters a historical session's own figures.
  wholesaleRatePerKwh         Decimal?                @db.Decimal(10, 2)
  /// `Partner.evMarginReferralCapPerKwh` *as it was* when this session
  /// settled — same freezing reasoning as `wholesaleRatePerKwh`.
  marginReferralCapPerKwh     Decimal?                @db.Decimal(10, 2)
  /// `appliedCustomerRatePerKwh - wholesaleRatePerKwh`, floored at 0 and
  /// stored for audit even though it is fully derivable from the two columns
  /// above — the same "store the number that was actually used" discipline
  /// `PurchaseIntent`'s other snapshot columns already follow.
  marginPerKwh                Decimal?                @db.Decimal(10, 2)
  /// The slice of this session's margin *above* `marginReferralCapPerKwh`,
  /// times `energyKwh` — pure, undivided TuTak revenue that never enters
  /// `poolAmount`/`computePoolSplit` at all, not even TuTak's own residual
  /// share of it. `poolAmount` (already on this row, reused unchanged from
  /// the internal-station program) holds the *capped* margin pool that does
  /// go through the ordinary six-leg split; this column is the separate,
  /// simpler remainder — see `RoamingCpoSettlementService` for the worked
  /// examples (5 / 30 / 45 AMD/kWh margin cases).
  uncappedMarginRevenueAmount Decimal?                @db.Decimal(18, 4)
  /// Claim timestamp for `EvCdrReconciliationService.completeAppInitiatedSession`
  /// — same stale-reclaim pattern as `EvCdr.reconcilingAt`: a sweep sets
  /// this when it starts working an `AWAITING_SETTLEMENT` session, clears it
  /// on a transient failure (so the next pass retries), and a claim older
  /// than the lock window is treated as abandoned rather than in progress.
  /// Meaningless outside `AWAITING_SETTLEMENT`.
  settlingAt                  DateTime?
  /// How many times `OcpiAdapter.fetchCdr` has been asked for this session's
  /// CDR and returned nothing yet — same accounting as `EvCdr.fetchAttempts`,
  /// kept on the session because there is no `EvCdr` row yet to hold it: one
  /// is only ever created once real energy/cost figures exist to put in it.
  settlementAttempts          Int                     @default(0)
  /// Set once `settlementAttempts` exhausts the same ceiling
  /// `EvCdrReconciliationService` uses elsewhere, meaning the CPO never
  /// answered — real energy was very likely delivered and TuTak has no
  /// trustworthy figure to bill it at. The sweep stops retrying a session
  /// once this is set (mirrors `EvCdr.UNAVAILABLE`) and a human is alerted;
  /// the session is left `AWAITING_SETTLEMENT` rather than guessed into
  /// `COMPLETED`/`CANCELLED`, because neither is true.
  settlementGivenUpAt         DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  connector   EvConnector    @relation(fields: [connectorId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  reservation EvReservation? @relation(fields: [reservationId], references: [id])
  transaction Transaction?   @relation(fields: [transactionId], references: [id])
  cdr         EvCdr?

  @@index([userId, createdAt])
  @@index([connectorId, status])
  /// What `EvCdrReconciliationService`'s sweep actually scans by: every
  /// session still waiting on a CPO's CDR to complete billing.
  @@index([status, settlementGivenUpAt])
  @@map("ev_sessions")
}

enum EvReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  FULFILLED
}

model EvReservation {
  id          String              @id @default(uuid())
  connectorId String
  userId      String
  status      EvReservationStatus @default(PENDING)
  startAt     DateTime
  expiresAt   DateTime
  createdAt   DateTime            @default(now())

  connector EvConnector @relation(fields: [connectorId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  session   EvSession?

  @@index([connectorId, status])
  /// `listMine` filters by user and sorts by recency, and the table grows
  /// with every hold anybody ever places. Composite rather than a bare
  /// `userId` so the sort is served by the index too — the same shape
  /// `transactions` and `ev_sessions` already use.
  @@index([userId, createdAt])
  /// The expiry sweep asks for confirmed holds past their window, once a
  /// minute, forever. Without this it reads every reservation ever made.
  @@index([status, expiresAt])
  @@map("ev_reservations")
}

/// Charge Detail Record — placeholder for OCPI CDR ingestion once a real
/// CPO/eMSP roaming partner is connected. `raw` retains
/// the untouched upstream payload for reconciliation/dispute handling.
/// How a roaming session's own figures compare with the charge-point
/// operator's settled ones.
///
/// On TuTak's own stations our meter is the only meter and there is nothing
/// to reconcile. On a roaming station the CPO's CDR is the authoritative
/// record of what was delivered — they own the hardware — and billing from
/// a client-reported reading without ever checking it against theirs is how
/// a platform ends up owing a network money it cannot account for.
enum EvCdrReconciliation {
  /// Our own station. Our meter is authoritative; nothing to compare.
  NOT_APPLICABLE
  /// Roaming, and the CPO has not settled the CDR yet. They take minutes to
  /// hours, so this is the normal state immediately after a session.
  PENDING
  /// The CPO agrees with what we billed, within tolerance.
  MATCHED
  /// The CPO delivered less than we billed. The difference was returned.
  CORRECTED
  /// The CPO delivered more than we billed. Deliberately not corrected
  /// automatically — see `EvCdrReconciliationService`.
  UNDERBILLED
  /// The CPO never produced a CDR. A human has to ask them why.
  UNAVAILABLE
}

model EvCdr {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  ocpiCdrId    String?  @unique
  totalEnergy  Decimal  @db.Decimal(10, 3)
  totalCost    Decimal  @db.Decimal(18, 4)
  totalTimeSec Int
  raw          Json?
  createdAt    DateTime @default(now())

  reconciliation EvCdrReconciliation @default(NOT_APPLICABLE)
  /// What the CPO said was delivered, once they have said it. Kept beside
  /// our own figures rather than overwriting them: the disagreement is the
  /// thing worth being able to look at afterwards.
  cpoEnergyKwh   Decimal?            @db.Decimal(10, 3)
  cpoCost        Decimal?            @db.Decimal(18, 4)
  reconciledAt   DateTime?
  /// How many times we have asked. A CDR that never arrives must stop being
  /// polled and start being somebody's problem.
  fetchAttempts  Int                 @default(0)
  /// The claim before doing anything that costs money — same idiom as
  /// `EvSession.stoppedAt`. `EvCdrReconciliationService`'s only concurrency
  /// guard is the sweep's advisory Redis lock, which is explicitly *not*
  /// authoritative: a run stalled past the lock's TTL by a slow/unreachable
  /// CPO can overlap with the next scheduled run, and `correctOvercharge`'s
  /// wallet-crediting step has no dedupe of its own — without a per-row
  /// claim, two overlapping runs reconciling the same still-PENDING CDR can
  /// double-credit a customer's overcharge refund. Cleared back to null
  /// whenever the CDR is left PENDING for a later pass (still awaiting the
  /// CPO); stale claims (a process that died mid-reconcile) are reclaimable
  /// after `RECONCILE_CLAIM_STALE_AFTER_MS` (independent audit, GitHub issue
  /// #28).
  reconcilingAt  DateTime?

  session EvSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// The sweep asks for roaming CDRs still awaiting the CPO, oldest first.
  @@index([reconciliation, createdAt])
  @@map("ev_cdrs")
}

// ─────────────────────────────────────────────────────────────────────────
// Double-entry ledger (see docs/FINANCIAL_CORE_DESIGN.md)
//
// Separate from BonusLedgerEntry on purpose. That ledger tracks one asset for
// one party and is correct at what it does; this one records real money from
// both sides, which is what makes an error detectable rather than merely
// undesirable. The two agree through a BONUS_LIABILITY account, which is a
// reconciliation check — one rewritten ledger would be a rewrite of the only
// part of the money path currently known to be correct.
// ─────────────────────────────────────────────────────────────────────────

enum LedgerAccountType {
  CUSTOMER_PAYABLE
  PARTNER_PAYABLE
  PSP_RECEIVABLE
  PLATFORM_REVENUE
  BONUS_LIABILITY
  /// Money that has left PARTNER_PAYABLE for the bank but is not yet
  /// confirmed settled. A payout sits here between request and confirmation,
  /// so an in-flight transfer is never invisible: it is out of the partner's
  /// payable balance (they cannot request it twice) without yet being
  /// claimed as gone. Confirmation drains it into PLATFORM_BANK; a failure
  /// reverses the original posting. Either way it returns to zero, so a
  /// non-zero balance here means exactly one thing: transfers are in flight
  /// right now.
  BANK_CLEARING
  /// The platform's own bank account. A confirmed payout leaves it.
  ///
  /// Its balance is negative and will stay negative until the other side of
  /// the platform's cash cycle is modelled — the acquirer settling
  /// PSP_RECEIVABLE into this account. Until then it reads as "paid out this
  /// much more than we have recorded receiving", which is true, rather than
  /// being hidden inside BANK_CLEARING, which was not.
  PLATFORM_BANK
  /// What customers owe TuTak, in aggregate, for completed app-initiated
  /// `ROAMING_CPO` charging sessions — see
  /// `EvCdrReconciliationService.completeAppInitiatedSession` and
  /// docs/ROAMING_CPO_FINANCIAL_ACCOUNTING_2026-08-29.md. Unlike every other
  /// purchase path in this codebase (QR, PurchaseIntent, internal EV
  /// charging, the walk-in roaming settlement), this is the one case where
  /// TuTak — not the partner, not an external terminal — is the party the
  /// customer owes money to: TuTak buys the energy wholesale and resells it
  /// at retail, so the ledger has to record that receivable somewhere. This
  /// account's balance grows for any customer with no funded
  /// `CUSTOMER_PREPAID_BALANCE` — see that account type's own docblock for
  /// the collection mechanism that now exists, and
  /// docs/ROAMING_CPO_PREPAID_BALANCE_2026-08-29.md for what still has to
  /// happen (a real bank adapter) before a customer can fund one. A single
  /// global account, not per-customer: nothing reads an individual
  /// customer's *unpaid* share on it, only the aggregate outstanding
  /// exposure.
  EV_ROAMING_RECEIVABLE
  /// A customer's own stored-value balance — money TuTak has actually
  /// received (via `CustomerBalanceService`/`BankTopUpAdapter`) and holds on
  /// their behalf, to be spent automatically the moment an app-initiated
  /// `ROAMING_CPO` session settles (`EvCdrReconciliationService
  /// .completeAppInitiatedSession`), since that is the one purchase path in
  /// this codebase where nothing else pays for the customer's share at the
  /// moment it becomes known. Per-customer (`userId` set, `partnerId` null),
  /// unlike every other account here — this is the first ledger account
  /// that is fundamentally about one person's own money, not a partner's or
  /// the platform's.
  ///
  /// Funded by `BalanceTopUp`: DEBIT `PSP_RECEIVABLE` / CREDIT this account,
  /// the same shape `PaymentEngineService.capture` already posts for a
  /// partner payment, reusing the existing acquirer-settlement pipeline
  /// (`docs/FINANCIAL_CORE_DESIGN.md`) rather than inventing a second one —
  /// which means its raw balance reads exactly like `PARTNER_PAYABLE`'s own
  /// "credited, so negative, even though it's money owed out" (see that
  /// account's own test comment): zero when empty, more negative the more
  /// TuTak owes this customer back. `CustomerBalanceService.getBalance` and
  /// `.collectFromBalance` negate it before a customer or a `gte`/`lte`
  /// comparison ever sees it, precisely because this is the one account in
  /// this ledger whose raw number is also meant to read as "how much money
  /// do I have" to someone outside the ledger.
  /// Spent by DEBITing this account (moves it back toward zero) / CREDITing
  /// `EV_ROAMING_RECEIVABLE` (pays that down) for the full amount owed, only
  /// when the balance can cover it in full — see `collectFromBalance`'s own
  /// docblock for why a partial collection is deliberately not attempted.
  ///
  /// Spent two ways, and only two. (1) `CustomerBalanceService
  /// .collectFromBalance` — roaming-CPO charging, the original 2026-08-29
  /// closed-loop decision. (2) Since 20.09.2026, by the owner's explicit
  /// decision ("canonical hybrid payment system"), as a funding component of
  /// an ordinary `PurchaseIntent`: `holdForPurchase` DEBITs this account and
  /// CREDITs `CUSTOMER_PREPAID_RESERVED` when the purchase opens, and the
  /// reservation is either reversed (cancel/reject/expiry) or turned into a
  /// `PARTNER_PAYABLE` credit at confirmation. That is the whole list. There
  /// is still deliberately no conversion into `BonusEntryType` wallet points
  /// or any other spendable form — money and bonus stay separate ledgers,
  /// separate balances, separate lines on every screen.
  ///
  /// The "available" figure a customer sees is this account's balance,
  /// negated. The "reserved" figure is `CUSTOMER_PREPAID_RESERVED`'s balance,
  /// negated. Book balance is their sum. See `CustomerBalanceService
  /// .getBalanceDetail`.
  CUSTOMER_PREPAID_BALANCE
  /// The part of a customer's stored money that an open `PurchaseIntent` has
  /// spoken for but that has not yet been paid to anyone. Per-customer, like
  /// `CUSTOMER_PREPAID_BALANCE`, and credit-normal like it: a hold moves
  /// money *out* of the available account and *into* this one (DEBIT
  /// available / CREDIT reserved), so its raw balance is negative-or-zero
  /// and reads "how much of my money is spoken for" when negated.
  ///
  /// Why a second account and not a column on the purchase: a column is a
  /// second source of truth that has to be reconciled against the ledger by
  /// hand. An account is reconstructable from its own postings, balances by
  /// construction (`ledger_transaction_balanced`), and lets the two
  /// concurrent-hold guards this design needs be a single conditional
  /// `UPDATE` on the *available* account — the same `balance <= -amount`
  /// claim `collectFromBalance` already uses. Two customers' holds never
  /// touch each other's rows; two holds by one customer serialise on their
  /// own row, and the second one sees the first one's debit.
  ///
  /// Every hold leaves this account by exactly one of two transactions:
  /// `customer.prepaid.hold_released` (the mirror image, via
  /// `LedgerService.reverse`, exactly-once by `reversesId`) or
  /// `partner.prepaid_funding` (DEBIT reserved / CREDIT `PARTNER_PAYABLE`,
  /// inside the same transaction as the purchase's confirmation). A non-zero
  /// balance here therefore means one thing: purchases are open right now.
  CUSTOMER_PREPAID_RESERVED
}

enum PostingDirection {
  DEBIT
  CREDIT
}

/// One account in the chart of accounts. Platform accounts leave both owner
/// columns null; customer and partner accounts set exactly one.
model LedgerAccount {
  id        String            @id @default(uuid())
  type      LedgerAccountType
  userId    String?
  partnerId String?
  currency  Currency          @default(AMD)
  /// Materialized for reads, always rewritten in the same transaction as the
  /// postings that move it — the same discipline Wallet already follows.
  balance   Decimal           @default(0) @db.Decimal(18, 4)
  version   Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  postings LedgerPosting[]

  @@unique([type, userId, partnerId, currency])
  @@index([partnerId])
  @@index([userId])
  @@map("ledger_accounts")
}

/// A financial event. Its postings must sum to zero — enforced by a deferred
/// constraint trigger, because postings are inserted one at a time and an
/// intermediate state is legitimately unbalanced.
model LedgerTransaction {
  id         String   @id @default(uuid())
  kind       String
  /// The domain row that caused this, so accounting can be traced back to
  /// the thing that happened.
  sourceType String
  sourceId   String
  /// A correction is a new transaction pointing at the original, never an
  /// edit — postings are immutable.
  reversesId String?  @unique
  postedAt   DateTime @default(now())

  postings             LedgerPosting[]
  payment              Payment?
  refund               Refund?
  purchaseIntentRefund PurchaseIntentRefund?
  payoutRequested      Payout?               @relation("PayoutRequested")
  payoutSettled        Payout?               @relation("PayoutSettled")
  acquirerSettlement   AcquirerSettlement?
  partnerCollection    PartnerCollection?
  balanceTopUp         BalanceTopUp?
  partnerSettlement    PartnerSettlement?
  pspPaymentAttempt    PspPaymentAttempt?
  prepaidHoldFor       PurchaseIntent?       @relation("PurchaseIntentPrepaidHold")

  @@index([sourceType, sourceId])
  @@index([postedAt])
  @@map("ledger_transactions")
}

model LedgerPosting {
  id            String           @id @default(uuid())
  transactionId String
  accountId     String
  direction     PostingDirection
  /// Always strictly positive; the direction carries the sign.
  amount        Decimal          @db.Decimal(18, 4)
  currency      Currency         @default(AMD)
  createdAt     DateTime         @default(now())

  transaction     LedgerTransaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account         LedgerAccount           @relation(fields: [accountId], references: [id])
  /// Set once this posting has been claimed by a partner settlement. Its
  /// absence is what makes a posting "unsettled".
  settlementEntry PartnerSettlementEntry?

  @@index([accountId, id])
  @@index([transactionId])
  @@map("ledger_postings")
}

/// Written in the same transaction as the postings it describes. That is the
/// whole point: an event exists if and only if the money moved.
model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  processedAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([processedAt, nextAttemptAt])
  @@map("outbox_events")
}

/// Idempotency for financial operations.
///
/// IN_FLIGHT is what makes this correct under concurrency: a second caller
/// finds the row, sees the first is still running, and refuses rather than
/// starting a parallel execution of the same money movement.
model IdempotencyRecord {
  id           String    @id @default(uuid())
  /// Scoped per actor. A global key let one account replay another's — the
  /// mistake already made once on Transaction.idempotencyKey.
  scope        String
  key          String
  /// A repeat with the same key and a different body is a client bug and must
  /// be refused, not silently answered with the first result.
  requestHash  String
  status       String
  responseBody Json?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@unique([scope, key])
  @@map("idempotency_records")
}

// ─────────────────────────────────────────────────────────────────────────
// Payments (financial core, phase 3)
//
// A record of one PSP charge attempt. Deliberately separate from
// `Transaction`, which is the QR/EV/bonus domain record of "the customer did
// something" — this is the money side of a card charge specifically:
// whether the acquirer captured it, for how much, and what it cost in
// commission. A CAPTURED payment always has exactly one LedgerTransaction; a
// DECLINED payment has none, because nothing moved.
// ─────────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  CAPTURED
  DECLINED
}

model Payment {
  id                  String        @id @default(uuid())
  userId              String
  partnerId           String
  amount              Decimal       @db.Decimal(18, 4)
  currency            Currency      @default(AMD)
  /// The platform's cut, already deducted from what the partner is owed.
  /// Zero on a declined payment — nothing was captured to take a cut of.
  commissionAmount    Decimal       @db.Decimal(18, 4)
  status              PaymentStatus
  pspReference        String?
  declineReason       String?
  /// Null on a declined payment.
  ledgerTransactionId String?       @unique
  /// Running total of every refund against this payment. The guard that stops
  /// a payment being refunded past what was captured is a conditional UPDATE
  /// on this column, not a read-then-write in application code — two
  /// concurrent refunds must not each read the same stale total.
  refundedAmount      Decimal       @default(0) @db.Decimal(18, 4)
  /// Set when the nightly settlement batch has claimed this payment. Also the
  /// claim itself: a payment moves into exactly one settlement, once.
  settlementId        String?
  settledAt           DateTime?
  /// The bonus lot settlement issued for this payment, if any. A direct link
  /// rather than a metadata lookup, because a refund has to find exactly the
  /// points this payment created in order to claw back the right ones.
  accruedLotId        String?       @unique
  /// The caller's idempotency key, carried on the payment itself.
  ///
  /// `IdempotencyRecord` already tracks these, but it is a separate table
  /// written in a separate transaction, and a crash between the two leaves a
  /// committed payment whose record is gone — after which a retry with the
  /// same key charges the customer again. That is not hypothetical: killing
  /// Postgres mid-capture produced exactly one such payment, and replaying
  /// its key produced a second charge.
  ///
  /// Storing the key here makes the record an optimisation and the database
  /// the guarantee. Nullable because payments written before this column
  /// existed have no key, and Postgres permits many NULLs in a unique index.
  idempotencyKey      String?
  createdAt           DateTime      @default(now())

  user              User               @relation(fields: [userId], references: [id])
  partner           Partner            @relation(fields: [partnerId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])
  settlement        Settlement?        @relation(fields: [settlementId], references: [id])
  refunds           Refund[]

  /// Scoped to the user, matching `IdempotencyRecord`'s `payment:<userId>`
  /// scope: two different customers may legitimately send the same key, and
  /// a key is only ever a promise about one caller's own retries.
  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([partnerId])
  @@index([settlementId])
  /// Metrics group payments from the last hour by status on every scrape.
  /// Without this the plan was a sequential scan of the whole table — fine
  /// while it is small, and at a million rows it makes monitoring the
  /// heaviest recurring load on the database, which is a bad way to find out.
  /// Status leads because the grouping is by status within a time window.
  @@index([status, createdAt])
  @@map("payments")
}

enum BalanceTopUpStatus {
  PENDING
  COMPLETED
  DECLINED
  /// The bank never answered (timeout, unreachable) rather than explicitly
  /// declining — distinct from DECLINED because a caller might reasonably
  /// retry a FAILED attempt with a fresh idempotency key, while a DECLINED
  /// one (insufficient funds, card refused) will not succeed by retrying.
  FAILED
  /// A top-up the provider was asked to take and has not reported on for
  /// longer than `customerBalance.topUpStaleAfterMs`. Not DECLINED and not
  /// FAILED: the customer may have paid. Raised by the
  /// `balance.escalate-stale-topups` sweep, which then alerts on it every
  /// `topUpEscalateEveryMs` and never resolves it by itself — the
  /// provider's authoritative answer (a late webhook still credits exactly
  /// once from this state) or an operator with the provider's statement
  /// does. Shown to the customer as "we are checking with the provider",
  /// never as zero, never as declined.
  UNRESOLVED
}

/// One attempt to fund a customer's `CUSTOMER_PREPAID_BALANCE` ledger
/// account — see that account type's own docblock and
/// docs/ROAMING_CPO_PREPAID_BALANCE_2026-08-29.md. Mirrors `Payment`'s own
/// shape deliberately: same claim-then-confirm lifecycle, same reasoning for
/// storing `idempotencyKey` on the row itself rather than trusting
/// `IdempotencyRecord` alone to survive a crash between the two writes.
///
/// `providerReference` is how a bank's asynchronous webhook confirmation is
/// matched back to the attempt that started it — unique, so a replayed or
/// duplicated webhook call is a no-op rather than a second credit.
model BalanceTopUp {
  id                  String             @id @default(uuid())
  userId              String
  amount              Decimal            @db.Decimal(18, 4)
  currency            Currency           @default(AMD)
  status              BalanceTopUpStatus @default(PENDING)
  providerReference   String?            @unique
  declineReason       String?
  /// Null until COMPLETED — nothing has moved yet before then.
  ledgerTransactionId String?            @unique
  idempotencyKey      String?
  /// When the provider's answer (or an operator's) closed this row. Null
  /// while PENDING or UNRESOLVED.
  resolvedAt          DateTime?
  /// Ageing, same shape as `PspPaymentAttempt`: when the sweep first found
  /// this top-up stale, when it last raised an alert, and how many times.
  /// None of these ever decide the outcome.
  unresolvedAt        DateTime?
  escalatedAt         DateTime?
  escalationCount     Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Restrict, not Cascade — same landmine `Wallet.user` was fixed for
  // (GitHub issue #28): a hard user delete must never silently wipe a
  // financial record of what money moved.
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status, createdAt])
  @@map("balance_top_ups")
}

// ─────────────────────────────────────────────────────────────────────────
// Settlement, refunds, payouts, reconciliation (financial core, phases 4-5)
// ─────────────────────────────────────────────────────────────────────────

/// One partner's captured payments for one day.
///
/// Settlement does not move money between the platform and the partner —
/// capture already did that. What settlement adds is the point at which
/// bonus is accrued: points earned on a payment that is later charged back
/// must never have been issued, rather than issued and clawed back, so
/// accrual waits until the payment has survived to settlement.
model Settlement {
  id               String   @id @default(uuid())
  partnerId        String
  /// UTC midnight of the day being settled.
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal  @default(0) @db.Decimal(18, 4)
  commissionAmount Decimal  @default(0) @db.Decimal(18, 4)
  netAmount        Decimal  @default(0) @db.Decimal(18, 4)
  bonusAccrued     Decimal  @default(0) @db.Decimal(18, 4)
  paymentCount     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partner  Partner   @relation(fields: [partnerId], references: [id])
  payments Payment[]

  /// One settlement per partner per day — the find-or-create races on this.
  @@unique([partnerId, periodStart])
  @@index([periodStart])
  @@map("settlements")
}

/// The acquirer paying the platform what it has been holding.
///
/// The inbound half of the platform's cash cycle, and the counterpart to
/// `Payout`. Capture puts money into PSP_RECEIVABLE, which is a claim on the
/// acquirer rather than cash; this is the day that claim becomes cash in the
/// platform's own bank. Without it PSP_RECEIVABLE grows for the life of the
/// platform and PLATFORM_BANK only ever goes down, so neither can be
/// reconciled against a real statement.
///
/// Recorded by an operator from the acquirer's remittance advice — there is
/// no webhook to trust here, because a fabricated inbound settlement is a
/// claim that money arrived when it did not.
model AcquirerSettlement {
  id                  String   @id @default(uuid())
  amount              Decimal  @db.Decimal(18, 4)
  currency            Currency @default(AMD)
  /// The acquirer's own reference for this transfer, as it appears on the
  /// statement. Unique so the same remittance cannot be entered twice by two
  /// operators looking at the same email.
  reference           String   @unique
  /// The day the money landed, per the statement — not when it was keyed in.
  settledOn           DateTime
  ledgerTransactionId String?  @unique
  recordedByUserId    String?
  createdAt           DateTime @default(now())

  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@index([settledOn])
  @@map("acquirer_settlements")
}

/// Whether the acquirer has actually accepted a refund, distinct from the
/// row's mere existence. P0 finding (2026-08-19 hardening pass): a `Refund`
/// row, `Payment.refundedAmount`, the reversing ledger postings and any
/// bonus clawback used to all get written the moment this engine *decided*
/// to refund, with no PSP call in between — the PSP boundary had `charge()`
/// but no `refund()` at all, so "the customer was refunded" was recorded
/// with no acquirer ever having moved the money. `PENDING` is the state
/// between "we asked the acquirer" and "the acquirer answered" — a refund
/// must never be reported financially complete while it is PENDING, and the
/// ledger/clawback effects below are only ever posted once it reaches
/// CONFIRMED.
enum RefundPspStatus {
  /// Submitted to the acquirer; outcome not yet known (in flight, timed out,
  /// or an explicit "processing" response). Reconciled by
  /// `RefundEngineService.reconcilePendingRefunds()`.
  PENDING
  /// The acquirer has confirmed the money moved. Only past this point are
  /// the reversing ledger postings and any bonus clawback applied.
  CONFIRMED
  /// The acquirer declined or the refund otherwise definitively failed.
  /// `Payment.refundedAmount`'s claim for this refund has been released.
  FAILED
}

/// A refund of some or all of a captured payment.
model Refund {
  id                  String          @id @default(uuid())
  paymentId           String
  amount              Decimal         @db.Decimal(18, 4)
  reason              String
  /// The reversing ledger transaction. Postings are immutable, so a refund is
  /// a new transaction pointing back at the original, never an edit. Null
  /// until `pspStatus` reaches CONFIRMED — see `RefundPspStatus`.
  ledgerTransactionId String?         @unique
  /// Points reclaimed from the customer, if the payment had already settled
  /// and accrued. Zero when it had not, and zero while `pspStatus` is not
  /// yet CONFIRMED.
  bonusClawedBack     Decimal         @default(0) @db.Decimal(18, 4)
  /// Who authorised this refund. Recorded on the row the money moved through
  /// rather than only in the audit log, for the reason `Payout` gives about
  /// `confirmedByUserId`: an audit log can be argued with, a column cannot.
  actorId             String?
  /// The caller's idempotency key.
  ///
  /// `IdempotencyRecord` tracks these in a separate table written in a
  /// separate transaction, and a crash between the two leaves a committed
  /// refund whose key is gone. A retry then refunds again — bounded by what
  /// remains refundable, which is not the same as safe: an operator who
  /// authorised one 500 refund and got two has given away 1,000, and every
  /// part of it was "within bounds". Demonstrated, not theorised: see
  /// `refund-payout-key-durability.int-spec.ts`.
  idempotencyKey      String?
  /// See `RefundPspStatus`. Defaults to PENDING — a row only exists once the
  /// claim against `Payment.refundedAmount` has been taken, which happens
  /// before the PSP is ever called.
  pspStatus           RefundPspStatus @default(PENDING)
  /// The acquirer's own reference for this refund, set once CONFIRMED.
  pspRefundReference  String?
  /// The stable, deterministic key sent to the PSP as *its* idempotency key
  /// — derived from (paymentId, actorId, idempotencyKey) rather than a fresh
  /// UUID, so a retry after this process crashes mid-refund recomputes the
  /// exact same external key without needing anything to have been
  /// persisted first, and the acquirer's own idempotency guarantee is what
  /// stops a retried external call from refunding twice.
  pspIdempotencyKey   String?
  /// Why the acquirer declined, when pspStatus is FAILED.
  pspDeclineReason    String?
  createdAt           DateTime        @default(now())

  payment           Payment            @relation(fields: [paymentId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  /// Scoped to the actor, matching `IdempotencyService`'s `refund:<actorId>`
  /// scope — two operators may legitimately choose the same key.
  @@unique([actorId, idempotencyKey])
  @@index([paymentId])
  /// What `reconcilePendingRefunds()` sweeps.
  @@index([pspStatus])
  @@map("refunds")
}

enum PayoutStatus {
  REQUESTED
  PAID
  FAILED
}

/// A transfer of a partner's payable balance to their bank.
model Payout {
  id                            String       @id @default(uuid())
  partnerId                     String
  amount                        Decimal      @db.Decimal(18, 4)
  status                        PayoutStatus
  bankReference                 String?
  failureReason                 String?
  ledgerTransactionId           String?      @unique
  /// The posting that drained BANK_CLEARING when the bank confirmed. Kept
  /// separate from `ledgerTransactionId` because a payout moves money twice
  /// — out of the partner's balance, then out of the platform's — and both
  /// halves need to be traceable to the row that caused them.
  settlementLedgerTransactionId String?      @unique
  requestedByUserId             String?
  /// Who confirmed the bank actually sent it. Recorded separately from the
  /// requester so the two-person rule is auditable after the fact rather than
  /// merely enforced at the time — an audit log can be argued with, a column
  /// on the row the money moved through cannot.
  confirmedByUserId             String?
  /// The requester's idempotency key, for the same reason it is on `Refund`
  /// and `Payment`: the record that tracks it lives in another table written
  /// in another transaction, and a crash between the two loses it. A replayed
  /// payout is bounded by what the partner is owed and still pays them twice.
  idempotencyKey                String?
  createdAt                     DateTime     @default(now())
  completedAt                   DateTime?

  partner                     Partner            @relation(fields: [partnerId], references: [id])
  ledgerTransaction           LedgerTransaction? @relation("PayoutRequested", fields: [ledgerTransactionId], references: [id])
  settlementLedgerTransaction LedgerTransaction? @relation("PayoutSettled", fields: [settlementLedgerTransactionId], references: [id])

  /// Matches `IdempotencyService`'s `payout:<actorId>` scope.
  @@unique([requestedByUserId, idempotencyKey])
  @@index([partnerId, status])
  @@map("payouts")
}

enum CollectionStatus {
  /// Recorded by one admin (the "maker"). Nothing has posted yet: no ledger
  /// transaction, no balance change. Only reached when `payouts.dualControl`
  /// is on — see `PartnerCollectionService`'s docblock.
  PENDING
  /// A different admin (the "checker") confirmed it, or dual control was off
  /// and the single-step path posted it immediately. Either way,
  /// `ledgerTransactionId` is set and the posting has happened.
  CONFIRMED
}

/// The other direction of settlement: a partner wiring money to TuTak to pay
/// down a `PARTNER_PAYABLE` balance that has gone against them (they owe more
/// commission than the discount compensation they are owed — doc §2/§7).
///
/// Two-step (`PENDING` → `CONFIRMED`) when `payouts.dualControl` is on, the
/// same shape as `Payout.requestPayout`/`confirmPaid` — see
/// `PartnerCollectionService`'s own docblock for why a collection also earns
/// a second pair of eyes now, even though nothing here moves money out of
/// the platform: a fabricated or duplicated collection still misstates what
/// a partner owes, silently and in the partner's favor. Single-step when
/// dual control is off, matching this model's original design: an operator
/// reading a bank statement that already shows the transfer landed has only
/// one moment to record, the same "already happened" shape as
/// `AcquirerSettlement`. Either way there is nothing to *fail* after the
/// fact the way a `Payout` can — if a transfer bounces, that shows up as a
/// fresh debit against the partner, not a status flip on this row.
model PartnerCollection {
  id                  String           @id @default(uuid())
  partnerId           String
  amount              Decimal          @db.Decimal(18, 4)
  currency            Currency         @default(AMD)
  /// The partner's own bank transfer reference, as it appears on the
  /// statement — a free-text label, the collection-side counterpart to
  /// `Payout.bankReference`. Not the uniqueness key — see
  /// `bankTransactionId`.
  bankReference       String
  /// The bank statement's own external transaction id — the unique key a
  /// real transfer can only ever appear under once. Normalized by
  /// `normalizeBankTransactionId` (trim + strip internal whitespace +
  /// uppercase) before it reaches this column, so the same real transfer
  /// collides no matter which admin typed it in or how they spaced it.
  /// Nullable only for rows that predate this column (see the migration's
  /// own comment) — every row created through `PartnerCollectionService`
  /// going forward has one; enforced at the DTO/service boundary, not by a
  /// database NOT NULL, because a NOT NULL cannot be added retroactively
  /// without fabricating a value for pre-existing rows. Immutable: nothing
  /// in this codebase ever updates it after creation.
  bankTransactionId   String?
  /// The invoice/фактура number this transfer was billed against, if the
  /// admin entering it had one to hand — free text, purely for
  /// reconciliation against the accountant's own paper trail. Never the
  /// uniqueness key (that stays `bankTransactionId`, tied to the bank
  /// statement itself) and never required: TuTak does not generate or store
  /// invoices, so not every collection has one to reference.
  invoiceReference    String?
  status              CollectionStatus @default(PENDING)
  ledgerTransactionId String?          @unique
  /// The admin who keyed this in from the statement (the "maker"). Nullable
  /// only for the same reason `Payout.requestedByUserId` is:
  /// forward-compatible with a system-recorded row that has no human maker,
  /// never used to make a real admin action anonymous.
  recordedByUserId    String?
  /// Who confirmed it (the "checker") — set on the `PENDING` → `CONFIRMED`
  /// transition when dual control is on. Left null for a single-step
  /// collection (dual control off): there was no separate confirming admin
  /// to name, and inventing one would misstate who did what, the same
  /// reasoning `Payout.confirmedByUserId` documents for its own legacy rows.
  confirmedByUserId   String?
  confirmedAt         DateTime?
  /// Same durability role as `Payout.idempotencyKey`: `IdempotencyService`'s
  /// own record is the primary guard, this is the fallback lookup for the
  /// crash-between-two-transactions case — see `PartnerCollectionService`.
  idempotencyKey      String?
  createdAt           DateTime         @default(now())

  partner           Partner            @relation(fields: [partnerId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  /// Matches `IdempotencyService`'s `partner-collection:<actorId>` scope.
  @@unique([recordedByUserId, idempotencyKey])
  /// The database-level control Problem 1 exists for: the *same real bank
  /// transfer* can never be recorded twice, no matter which admin enters it
  /// or what idempotency key they use — that pair is only ever a proxy for
  /// "this admin's own retry", not for "this transfer hasn't been claimed by
  /// anyone yet". Scoped by currency for the same reason
  /// `LedgerAccount`'s own per-type-per-currency uniqueness is: there is one
  /// `PLATFORM_BANK` account per currency, and a transaction id is only
  /// unique within the statement of the account it landed in. Postgres does
  /// not consider two NULLs equal in a unique index, so the legacy rows
  /// above with no `bankTransactionId` never collide with each other or with
  /// anything else.
  @@unique([currency, bankTransactionId])
  @@index([partnerId, createdAt])
  @@index([status])
  @@map("partner_collections")
}

enum ReconciliationStatus {
  CLEAN
  DRIFT_DETECTED
}

/// One night's comparison of the ledger against external statements.
///
/// Drift is recorded and escalated, never auto-corrected: a reconciliation
/// engine that silently adjusts balances hides exactly the bug it exists to
/// find.
/// How often a partner is settled. Per-partner — see `Partner.settlementPeriodicity`.
enum SettlementPeriodicity {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Where a partner's bank transfer goes.
///
/// Rows are never edited. Changing a partner's details deactivates the old
/// row and inserts a new one, so "what were the details when we paid them in
/// March" is answerable from the table itself rather than from an audit log
/// that might have been pruned. A settlement additionally snapshots the
/// details it was approved against (`PartnerSettlement.beneficiarySnapshot`),
/// because the answer has to survive even this table being corrected later.
model PartnerBankAccount {
  id               String    @id @default(uuid())
  partnerId        String
  beneficiaryName  String
  /// Free-form on purpose: IBAN in some banks, a domestic account number in
  /// others. Validation belongs to whoever knows the banking rules, not here.
  accountNumber    String
  bankName         String
  swiftBic         String?
  isActive         Boolean   @default(true)
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  /// Set when a newer row replaced this one. Never deleted.
  replacedAt       DateTime?
  replacedByUserId String?

  partner     Partner             @relation(fields: [partnerId], references: [id])
  settlements PartnerSettlement[]

  /// At most one live destination per partner. A partial index, so the
  /// history rows (isActive = false) are unconstrained.
  @@index([partnerId, isActive])
  @@map("partner_bank_accounts")
}

/// Who raised the doubt about a bank transfer.
///
/// The product decision of 15.09.2026: a partner may *report* that a transfer did
/// not arrive, and may not *confirm* whether money moved. The two are
/// different acts and this column is what keeps them apart — a settlement
/// flagged by a partner's report reads differently from one flagged by
/// finance, and only finance can resolve either.
enum ReconciliationSource {
  /// Finance noticed it: a timeout, a reference the bank cannot find.
  FINANCE
  /// The partner said the money never arrived. A report, not a finding.
  PARTNER_REPORT
}

/// What a human established the ambiguous transfer actually did.
enum ReconciliationOutcome {
  /// The statement shows the debit. The settlement closes as paid.
  MONEY_MOVED
  /// The statement shows no debit. The settlement becomes retryable.
  MONEY_DID_NOT_MOVE
}

enum PartnerSettlementStatus {
  /// Being assembled. Entries are already claimed (so nothing else can take
  /// them) but no money is promised.
  DRAFT
  /// The figures are final and the document is attached. Awaiting approval.
  READY
  /// A second admin approved it — the "checker" half of maker/checker.
  APPROVED
  /// The bank transfer has been initiated by hand and we are waiting for it
  /// to land. Nothing is posted yet.
  PAYMENT_PENDING
  /// The transfer landed. This is the only status that posts to the ledger,
  /// and the row is immutable from here on.
  PAID
  /// A transfer attempt was rejected or returned. **Not terminal.** The
  /// settlement keeps its entries and a new transfer may be attempted against
  /// the same figure: the settlement is the statement of what is owed, and a
  /// bank refusing one transfer does not change what is owed.
  ///
  /// Making this terminal was a real bug — it stranded the claimed postings
  /// for ever, so a partner whose transfer bounced could never be paid for
  /// those sales at all. Found by the product review.
  FAILED
  /// The bank's answer is ambiguous — a timeout, a reference that cannot be
  /// found, a partial. Never retried automatically: a retry on an ambiguous
  /// result is how a partner gets paid twice.
  REQUIRES_RECONCILIATION
  /// Abandoned before payment. Releases its entries back to unsettled.
  CANCELLED
}

/// One period's worth of a partner's payable, frozen.
///
/// The unit of settlement is deliberately the existing `LedgerPosting` on the
/// partner's `PARTNER_PAYABLE` account, not a second parallel partner ledger:
/// this codebase already keeps immutable double-entry postings, and a rollup
/// table maintained alongside them would be a second source of truth that can
/// disagree with the first. `PartnerSettlementEntry` claims postings; a
/// partner's *unsettled* payable is exactly the postings with no claim.
///
/// That one decision gives most of what the brief asks for:
///
/// - **A frozen amount.** Once entries are claimed the figure cannot drift,
///   because a later purchase produces a *new* posting, which by definition
///   is not in this settlement.
/// - **No double payment.** Enforced by a unique index on
///   `PartnerSettlementEntry.ledgerPostingId`, in the database, not in code.
/// - **Refund after payout.** The reversing postings a refund writes are
///   simply unclaimed postings, so the next settlement picks them up as
///   negatives. The PAID settlement is never touched.
/// - **Explainable debt.** Every claimed posting keeps its own `kind` and
///   source, so a negative balance can always be itemised back to the
///   purchases and refunds that produced it.
model PartnerSettlement {
  id          String                  @id @default(uuid())
  partnerId   String
  periodStart DateTime
  periodEnd   DateTime
  status      PartnerSettlementStatus @default(DRAFT)
  currency    Currency                @default(AMD)

  /// Sum of the claimed CREDIT postings — what the platform owes for.
  accruedAmount    Decimal @default(0) @db.Decimal(18, 4)
  /// Sum of the claimed DEBIT postings — commission, refund reversals, and
  /// the debt carried in from earlier periods.
  deductionAmount  Decimal @default(0) @db.Decimal(18, 4)
  /// accrued - deduction. Always > 0 for a settlement that can be paid; a
  /// non-positive balance is not settled at all, it stays unclaimed and
  /// carries forward.
  netPayableAmount Decimal @default(0) @db.Decimal(18, 4)
  entryCount       Int     @default(0)

  /// The tax/accounting document this payment is made against. Deliberately
  /// free-form: the Armenian form is a legal question that is not settled,
  /// and inventing a shape here would be inventing a tax rule.
  documentNumber    String?
  documentDate      DateTime?
  documentReference String?

  /// The bank's own reference for the transfer. Unique per currency, so one
  /// transfer cannot be used to close two settlements — the same guarantee
  /// `PartnerCollection` already has for money coming the other way.
  bankTransferReference String?

  /// Where the money was sent, as it read at approval time. Kept even if the
  /// partner's details change afterwards.
  bankAccountId       String?
  beneficiarySnapshot Json?

  /// ── Reconciliation, when the bank's answer was ambiguous ──────────────
  ///
  /// Every column here exists because the product decision of 15.09.2026 requires
  /// that resolving an ambiguous transfer carry evidence and two different
  /// people. The proposal and the confirmation are separate acts by separate
  /// actors, exactly as `approve` is separate from `markReady`: one person
  /// deciding alone that money moved is one person deciding alone to pay a
  /// partner twice.
  reconciliationSource            ReconciliationSource?
  /// Who said something was wrong. May be a partner — that is a report.
  reconciliationReportedByUserId  String?
  reconciliationReportedAt        DateTime?
  /// The proposed answer, and what it rests on. `reconciliationEvidence` is
  /// free-form on purpose: it is a bank statement line, a reference number, a
  /// case id from the bank's own support. Requiring a shape would mean
  /// guessing what the bank provides.
  reconciliationOutcome           ReconciliationOutcome?
  reconciliationEvidence          String?
  reconciliationProposedByUserId  String?
  reconciliationProposedAt        DateTime?
  /// The second pair of eyes. Never the proposer, and never the partner.
  reconciliationConfirmedByUserId String?
  reconciliationConfirmedAt       DateTime?

  createdByUserId   String?
  createdAt         DateTime  @default(now())
  approvedByUserId  String?
  approvedAt        DateTime?
  paidByUserId      String?
  paidAt            DateTime?
  failedReason      String?
  cancelledByUserId String?
  cancelledAt       DateTime?
  cancelledReason   String?

  /// The payout posting, written only when the status becomes PAID.
  ledgerTransactionId String? @unique

  updatedAt DateTime @updatedAt

  partner           Partner                            @relation(fields: [partnerId], references: [id])
  bankAccount       PartnerBankAccount?                @relation(fields: [bankAccountId], references: [id])
  ledgerTransaction LedgerTransaction?                 @relation(fields: [ledgerTransactionId], references: [id])
  entries           PartnerSettlementEntry[]
  transferAttempts  PartnerSettlementTransferAttempt[]

  @@unique([currency, bankTransferReference])
  @@index([partnerId, periodStart])
  @@index([status])
  @@map("partner_settlements")
}

/// A single ledger posting claimed by one settlement, for ever.
///
/// The unique index on `ledgerPostingId` is the hard invariant the whole
/// design rests on: a posting the platform has already paid for cannot be
/// paid for again, whatever a retried job or a second admin does.
model PartnerSettlementEntry {
  id              String           @id @default(uuid())
  settlementId    String
  ledgerPostingId String           @unique
  partnerId       String
  amount          Decimal          @db.Decimal(18, 4)
  direction       PostingDirection
  /// `LedgerTransaction.kind`, copied so a settlement can be itemised
  /// without walking back through the ledger.
  kind            String
  sourceType      String
  sourceId        String
  occurredAt      DateTime

  settlement PartnerSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  posting    LedgerPosting     @relation(fields: [ledgerPostingId], references: [id])

  @@index([settlementId])
  @@index([partnerId, occurredAt])
  @@map("partner_settlement_entries")
}

/// How the real-money part of a purchase is settled.
///
/// Chosen when the purchase is created and never changed afterwards. That
/// immutability is the whole defence against the double-payment hazard: a
/// customer cannot start paying through the provider, have the callback
/// arrive late, and meanwhile hand the cashier cash for the same purchase.
/// Changing your mind means cancelling and starting again — and cancelling is
/// refused while a provider attempt might still take the money.
enum PaymentRoute {
  /// The customer pays the partner directly, outside TuTak. The original
  /// model, still fully supported.
  DIRECT_PARTNER
  /// The customer pays TuTak through a payment provider.
  TUTAK_PSP
}

/// What the customer physically handed the partner on a DIRECT purchase.
///
/// Recorded because "who actually received the cash" has to be answerable
/// from history, and because a partner's own card terminal and a banknote
/// are different facts even though TuTak sees neither.
enum DirectTender {
  CASH
  PARTNER_CARD
  OTHER
}

/// Where a provider payment attempt has got to.
///
/// The ordering matters more than the names: everything from `INITIATED`
/// onwards is a state in which the provider **may already have taken the
/// customer's money**, and while a purchase sits in one of them no cash may
/// be collected for it by any other route.
/// Why a provider attempt was resolved the way it was.
///
/// The product decision of 15.09.2026: **time never resolves an attempt.** A
/// timeout is the absence of an answer, not the answer "no", and letting the
/// clock write `FAILED` is how a purchase the provider already charged for is
/// declared safe to collect again. So an attempt may only leave the unsafe
/// set on one of the bases below — and `TIMEOUT` is deliberately not one of
/// them, because there is nothing to put in this column for "we waited".
///
/// Ageing still does something: it raises alerts and escalates, so a human
/// looks. It just never decides.
enum PspResolutionBasis {
  /// The provider's own signed callback said so.
  PROVIDER_CALLBACK
  /// The provider's status API was asked and answered. Requires the adapter
  /// to declare `statusQuery`, which Idram's does not today.
  PROVIDER_STATUS_QUERY
  /// Two people read the provider's statement and agreed what it shows. The
  /// manual counterpart of a settlement's maker/checker reconciliation, and
  /// subject to the same rule: never one person alone.
  MANUAL_RECONCILIATION
}

enum PspAttemptStatus {
  /// A bill exists at the provider. The customer may be paying right now.
  INITIATED
  /// The customer came back, or a pre-check arrived, but the authoritative
  /// server confirmation has not. Deliberately not "paid": a customer
  /// returning to a success URL proves nothing.
  PENDING_CONFIRMATION
  /// A verified server-side confirmation arrived. Only here does money move
  /// in the ledger.
  SUCCEEDED
  /// The provider said, authoritatively, that no payment happened. The only
  /// state from which another route may be attempted.
  FAILED
  /// Nothing conclusive arrived in time. **Not** a synonym for failed:
  /// until the provider confirms otherwise the money may have moved, so this
  /// is as unsafe as INITIATED.
  EXPIRED
  /// The provider and this platform disagree, or a confirmation arrived that
  /// cannot be matched. A human has to look; nothing is settled meanwhile.
  REQUIRES_RECONCILIATION
}

/// One attempt to collect the real-money remainder through a provider.
///
/// Separate from `PurchaseIntent` because a purchase has one economic
/// identity but may legitimately be attempted more than once — a declined
/// card, an abandoned redirect. The purchase's snapshot never changes; each
/// attempt is its own row with its own provider references.
///
/// ## Why the unique indexes are the real design
///
/// `@@unique([purchaseIntentId, liveKey])` with `liveKey` set only while an
/// attempt is unresolved allows **at most one live attempt per purchase**.
/// Two taps on "pay" cannot open two bills at the provider, and that is
/// enforced by the database rather than by a disabled button.
///
/// `@@unique([provider, providerTransactionId])` makes a replayed callback a
/// no-op: the second one cannot create a second payment record.
/// What a provider callback was asking for.
enum PspCallbackKind {
  /// "Does this bill exist and may it be paid?" Answered synchronously and
  /// never touches the ledger.
  PRECHECK
  /// "This bill was paid." The only kind that can move money.
  FINAL
}

/// Where an inbound callback is in its durable processing.
enum PspInboxStatus {
  /// Written down, provider acknowledged, not yet acted on.
  RECEIVED
  /// A worker holds a lease on it.
  PROCESSING
  /// Its financial effect has happened, or was found to have happened
  /// already. Terminal and successful.
  PROCESSED
  /// A duplicate of a callback already recorded. Terminal, and not a
  /// failure: the provider retrying is normal.
  DUPLICATE
  /// Verification failed — bad checksum, wrong merchant, unknown bill. Kept
  /// rather than discarded, because a forged callback is evidence.
  REJECTED
  /// Retried to exhaustion. Alerted on, never retried again silently.
  DEAD
}

/// Every callback a payment provider has sent us, written down before
/// anything is done about it.
///
/// ## Why this exists
///
/// A verified callback used to be processed inside the HTTP request that
/// delivered it. That meant one settlement transaction per callback, held for
/// the whole of a heavy write, and a burst of twenty duplicate retries took
/// twenty connections from a pool of five. Measured, not theorised: ten
/// concurrent callbacks for one bill all failed with "Unable to start a
/// transaction in the given time", and the provider — seeing errors — would
/// have retried harder. Nothing was double-counted, because nothing happened
/// at all, which is its own kind of wrong: the customer had paid.
///
/// Raising the pool would have moved the cliff, not removed it. So the HTTP
/// boundary now does the one thing it must do synchronously — prove the
/// callback genuine and write it down — and answers. The money moves later,
/// once, in a worker.
///
/// ## What makes it safe
///
/// `dedupeKey` is the provider's own identity for the event, so a retry
/// collides with the row it is a retry of and is recorded as DUPLICATE
/// instead of becoming a second unit of work. Processing is claimed with a
/// lease, so a worker that dies mid-flight releases its claim rather than
/// stranding the row; and because the financial step is itself idempotent, a
/// crash between committing the ledger and marking the row processed costs a
/// repeat that finds the work already done.
model PspCallbackInbox {
  id       String          @id @default(uuid())
  provider String
  kind     PspCallbackKind
  status   PspInboxStatus  @default(RECEIVED)

  /// The provider's identity for this event: provider, bill, and its own
  /// transaction id. Unique, and that uniqueness is the whole duplicate
  /// defence — a retry cannot become a second unit of work.
  dedupeKey String @unique

  billId                String?
  providerTransactionId String?
  /// What the provider said the amount was. Never trusted on its own; the
  /// attempt's own amount is what settlement checks against.
  reportedAmount        Decimal? @db.Decimal(18, 4)

  /// Whether the signature/checksum proved genuine. A false here is why the
  /// row is REJECTED, and the row is kept: a forged callback is evidence.
  verified       Boolean @default(false)
  rejectedReason String?

  /// Everything the provider sent, verbatim, for disputes.
  ///
  /// Kept whole rather than filtered: a dispute is argued on what arrived,
  /// and a redacted copy proves nothing. It contains no secret — Idram's
  /// `EDP_CHECKSUM` is a digest, and the key that produced it lives only in
  /// the environment and is never written here or logged.
  rawPayload Json

  /// Set while unprocessed and nulled once terminal, so "one live inbox row
  /// per dedupe key" needs no coordination. Same trick as
  /// `PspPaymentAttempt.liveKey`.
  pendingKey String?

  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  leaseUntil    DateTime?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  /// The attempt this callback settled, once it has.
  pspPaymentAttemptId String?

  @@index([status, nextAttemptAt])
  @@index([billId])
  @@index([receivedAt])
  @@map("psp_callback_inbox")
}

model PspPaymentAttempt {
  id               String           @id @default(uuid())
  purchaseIntentId String
  provider         String
  status           PspAttemptStatus @default(INITIATED)
  amount           Decimal          @db.Decimal(18, 4)
  currency         Currency         @default(AMD)

  /// The bill/order identifier this platform gave the provider.
  providerBillId        String?
  /// The provider's own transaction identifier, known once it confirms.
  providerTransactionId String?
  /// Provider fee for this attempt, when the provider tells us. Null means
  /// "not known yet", never "zero".
  providerFeeAmount     Decimal? @db.Decimal(18, 4)
  /// Which fee rule was in force, so the figure can be re-derived.
  feeRuleId             String?

  /// Set to a constant while the attempt is unresolved and nulled once it
  /// reaches a terminal state — the trick that makes "one live attempt per
  /// purchase" expressible as a unique index. See the docblock above.
  liveKey String?

  /// The ledger transaction written when this attempt succeeded.
  ledgerTransactionId String? @unique

  failureReason   String?
  /// Everything the provider sent, kept verbatim for disputes.
  providerPayload Json?

  /// ── How this attempt stopped being unsafe ─────────────────────────────
  ///
  /// Null while unresolved, and null for ever on an attempt that timed out
  /// and was never answered — `EXPIRED` is a state of not knowing, not a
  /// resolution. A database trigger refuses `FAILED` without one of these,
  /// which is what makes "time never releases a purchase" a property of the
  /// table rather than a habit of the code.
  resolutionBasis               PspResolutionBasis?
  /// MANUAL_RECONCILIATION only: two different people, and what they read.
  ///
  /// Filled in two separate authenticated calls, never one. A single caller
  /// passing both user ids is one person asserting who the second person
  /// was, which is not dual control — it is dual control's paperwork.
  reconciledByUserId            String?
  reconciliationCheckedByUserId String?
  reconciliationEvidence        String?
  /// Set when the first person proposes, cleared when the second confirms or
  /// the proposal is withdrawn. While it is set the attempt is unchanged:
  /// a proposal moves no money and resolves nothing.
  reconciliationProposedAt      DateTime?

  /// Ageing. Raised by the sweep so an unresolved attempt gets louder rather
  /// than being quietly decided; neither column ever changes `status`.
  escalatedAt     DateTime?
  escalationCount Int       @default(0)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  purchaseIntent    PurchaseIntent     @relation(fields: [purchaseIntentId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])
  feeRule           PspFeeRule?        @relation(fields: [feeRuleId], references: [id])

  @@unique([purchaseIntentId, liveKey])
  @@unique([provider, providerTransactionId])
  @@index([status])
  @@index([purchaseIntentId])
  @@index([purchaseIntentId, status])
  @@map("psp_payment_attempts")
}

/// Who bears a provider's fee. Contractual, so configurable rather than
/// assumed — the brief is explicit that nobody may decide this in code.
enum FeePayer {
  PLATFORM
  PARTNER
  SPLIT
}

/// A provider's fee, as it stood over a period of time.
///
/// Versioned rather than edited: a purchase made in March must still be
/// explainable by March's rate after the contract changes in June. Rules are
/// never updated in place — a change closes the old row and opens a new one.
/// How a partner's contribution to TuTak is priced.
///
/// The platform started with one answer — a percentage of the sale, in basis
/// points on a 50-point grid — and the product decision of 15.09.2026 is that
/// this stays for the partners it fits and stops being the only answer.
///
/// The forcing case is fuel. HAZE's terms are 10 AMD of every 300 AMD litre,
/// which is one thirtieth: 333.33 basis points. Not an integer, and not on
/// the grid. Rounding it to 3 % or 3.5 % changes real money on every tank —
/// 50 AMD either way on a 15,000 AMD fill — and loosening the grid for
/// everyone to accommodate one pricing shape would be fixing the wrong thing.
/// A per-litre margin is not a percentage that happens to be awkward; it is a
/// different kind of number.
/// The units a per-unit commercial term may be priced in.
///
/// Closed on purpose, and the product decision of 15.09.2026 says why: `unit` was
/// a free string, and a free string in a financial identifier means "L", "l",
/// "л", "litre" and "liter" are five different units as far as the equality
/// check is concerned. That check decides whether 10 AMD per litre may be
/// multiplied by a quantity, so a partner whose till sends "л" while their
/// contract says "L" is a partner whose purchases are silently refused — or,
/// worse, a mismatch that some later "helpful" normalisation resolves the
/// wrong way.
///
/// Two values are required by the decision (LITER, KWH); the rest are here
/// because refusing to record a purchase measured in kilograms would push
/// somebody towards abusing LITER. Adding a value is a migration, which is
/// the point: a new unit is a commercial decision, not a typo.
///
/// Display names are **not** here. "литр" is a label, and a label belongs in
/// the client's own translations, not in the identifier the arithmetic
/// compares.
enum UnitOfMeasure {
  LITER
  KWH
  KILOGRAM
  ITEM
  HOUR
}

/// Where a version of a partner's commercial terms is in its approval.
///
/// The product decision of 15.09.2026: production changes to commercial terms go
/// through maker/checker. Before this, `open()` wrote a live rule in one call
/// and retried on conflict — so two administrators editing at once produced
/// two versions applied one after the other, each looking deliberate, with
/// nobody having agreed to the combination.
enum ContributionRuleStatus {
  /// Written down, agreed by nobody. Prices nothing.
  PROPOSED
  /// In force. At most one per partner, held by a partial unique index.
  ACTIVE
  /// Was in force, replaced by a later version. Still prices the purchases
  /// that named it.
  SUPERSEDED
  /// Turned down before it ever priced anything. Kept, because "who proposed
  /// what and who said no" is exactly what an audit wants.
  REJECTED
}

enum ContributionRuleKind {
  /// A share of the sale, in basis points. What every partner used before
  /// 15.09.2026 and what most will keep using.
  PERCENT_BPS
  /// A fixed amount per unit sold — 10 AMD per litre. Requires the purchase
  /// to carry `quantity`/`quantityUnit`, because there is nothing to multiply
  /// otherwise.
  FIXED_PER_UNIT
  /// Both, added. Exists because a supplier contract that has a per-unit
  /// margin *and* a percentage on top is an ordinary thing to sign, and
  /// modelling it as two rules would mean two snapshots on one purchase.
  HYBRID
}

/// A partner's commercial terms, versioned and immutable.
///
/// ## Why a row and not a column
///
/// `Partner.bonusAccrualRateBps` is a single mutable number, which makes two
/// true statements impossible to hold at once: "this is what we charge" and
/// "this is what we charged for that sale in March". Changing the rate
/// silently rewrites the second. A purchase snapshots
/// `negotiatedRateBps`, which fixed the percentage case, but a snapshot of a
/// number cannot record *which kind* of term it was, nor let anyone answer
/// "what were HAZE's terms in March" without reading a purchase from March.
///
/// So terms become rows: one per version, never edited, only closed. A
/// contract change opens the next version and closes the previous one, and
/// every purchase names the exact version it was priced under.
///
/// ## What is deliberately not here
///
/// No approval workflow, and no per-branch terms. Both are real questions and
/// neither has been decided; inventing either now would be guessing about the
/// commercial process rather than recording it.
model PartnerContributionRule {
  id        String                 @id @default(uuid())
  partnerId String
  status    ContributionRuleStatus @default(PROPOSED)

  /// 1, 2, 3 — per partner, and the number a purchase's snapshot names.
  ///
  /// **Allocated at approval, not at proposal.** That is the fix for the
  /// concurrency complaint: while the number was handed out when a rule was
  /// written, two administrators racing produced versions 4 and 5, and the
  /// loser's retry quietly became a second real change rather than a
  /// conflict somebody had to look at. A proposal nobody approved has no
  /// number because it is not a version of anything.
  version Int?
  kind    ContributionRuleKind

  /// PERCENT_BPS and HYBRID: the share of the sale. Unlike
  /// `Partner.bonusAccrualRateBps` this is **not** on the 50-point grid:
  /// the grid exists to keep a human-negotiated headline rate tidy, and a
  /// rule row is the negotiated contract itself.
  percentBps   Int?
  /// FIXED_PER_UNIT and HYBRID: the amount per unit. 10.0000 for HAZE.
  fixedPerUnit Decimal?       @db.Decimal(18, 4)
  /// The unit that amount is per. Must match the purchase's own
  /// `quantityUnit`, or the multiplication is meaningless: 10 AMD per litre
  /// against a quantity measured in kilograms is not a rounding problem, it
  /// is a wrong invoice. Typed rather than free text since 15.09.2026 — see
  /// `UnitOfMeasure`.
  unit         UnitOfMeasure?

  currency Currency @default(AMD)

  effectiveFrom  DateTime  @default(now())
  /// Null means live. Closing the window is the only edit the database
  /// permits on this row.
  effectiveUntil DateTime?

  /// Set to a constant while the rule is live and nulled when it is closed,
  /// so "one live rule per partner" is a partial unique index rather than a
  /// convention. Same trick as `PspPaymentAttempt.liveKey`.
  liveKey String?

  /// Maker and checker. `approvedByUserId` is never the proposer — the
  /// database refuses that, not just this codebase.
  proposedByUserId String?
  approvedByUserId String?
  approvedAt       DateTime?
  rejectedByUserId String?
  rejectedAt       DateTime?
  decisionNote     String?

  /// Kept for the rows written before approval existed. New rows set
  /// `proposedByUserId`; this stays so nothing had to be back-filled.
  createdByUserId String?
  createdAt       DateTime @default(now())
  note            String?

  partner   Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  purchases PurchaseIntent[]

  @@unique([partnerId, version])
  @@unique([partnerId, liveKey])
  @@index([partnerId, effectiveFrom])
  @@index([partnerId, status])
  @@map("partner_contribution_rules")
}

model PspFeeRule {
  id              String    @id @default(uuid())
  provider        String
  /// Null matches any method; a more specific row wins.
  paymentMethod   String?
  percentBps      Int       @default(0)
  fixedAmount     Decimal   @default(0) @db.Decimal(18, 4)
  currency        Currency  @default(AMD)
  payer           FeePayer  @default(PLATFORM)
  effectiveFrom   DateTime
  effectiveUntil  DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  note            String?

  attempts PspPaymentAttempt[]

  @@index([provider, effectiveFrom])
  @@map("psp_fee_rules")
}

/// One attempt to move a settlement's money to the partner's bank.
///
/// Separate from the settlement because they are different facts. The
/// settlement says what is owed and is frozen once approved; a transfer is a
/// thing somebody does in a banking app, which can fail and be repeated. One
/// settlement therefore has many attempts and at most one that succeeded.
///
/// The partial unique index is what makes "at most one succeeded" true in the
/// database rather than in a service: a second successful attempt on the same
/// settlement cannot be inserted.
model PartnerSettlementTransferAttempt {
  id           String   @id @default(uuid())
  settlementId String
  amount       Decimal  @db.Decimal(18, 4)
  currency     Currency @default(AMD)

  /// The bank's reference for this attempt. Unique per currency across all
  /// attempts, so one real transfer cannot be recorded twice.
  bankTransferReference String?
  succeeded             Boolean @default(false)
  failureReason         String?
  /// Set only on the attempt that worked, so the partial unique index below
  /// can hold "one success per settlement".
  successKey            String?

  attemptedByUserId String?
  attemptedAt       DateTime  @default(now())
  resolvedAt        DateTime?

  settlement PartnerSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, successKey])
  @@unique([currency, bankTransferReference])
  @@index([settlementId, attemptedAt])
  @@map("partner_settlement_transfer_attempts")
}

model ReconciliationRun {
  id          String               @id @default(uuid())
  /// UTC midnight of the day reconciled.
  periodStart DateTime             @unique
  status      ReconciliationStatus
  /// Per-account expected (ledger) vs reported (statement) comparison.
  findings    Json
  createdAt   DateTime             @default(now())

  @@map("reconciliation_runs")
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel
  titleKey  String
  bodyKey   String
  params    Json?
  isRead    Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────
// Security: Audit Trail & Fraud Detection
// ─────────────────────────────────────────────────────────────────────────

enum AuditAction {
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  TOKEN_REFRESHED
  TOKEN_REVOKED
  BONUS_ACCRUED
  BONUS_RESERVED
  BONUS_SETTLED
  BONUS_EXPIRED
  BONUS_REVERSED
  BONUS_MANUAL_ADJUSTMENT
  QR_ISSUED
  QR_REDEEMED
  EV_SESSION_STARTED
  EV_SESSION_STOPPED
  PARTNER_CREATED
  PARTNER_UPDATED
  /// Home "Partner Spotlight" placements — written by a platform
  /// administrator only, so every change is somebody's decision on record.
  PARTNER_PROMO_CREATED
  PARTNER_PROMO_UPDATED
  ADMIN_ROLE_CHANGED
  FRAUD_FLAGGED
  ACCOUNT_LOCKED
  PAYMENT_REFUNDED
  PAYOUT_REQUESTED
  PAYOUT_RESOLVED
  PAYOUT_BLOCK_CLEARED
  /// An operator recorded the acquirer paying the platform. Audited because
  /// it is the one entry point through which cash appears in the books
  /// without a customer transaction behind it.
  ACQUIRER_SETTLEMENT_RECORDED
  /// An operator recorded a partner's bank transfer settling a debt to
  /// TuTak. Same reasoning as ACQUIRER_SETTLEMENT_RECORDED: it is an
  /// operator's unverified assertion that money arrived, so who entered it
  /// and when has to be on the record. Written whether the row lands
  /// `PENDING` or, dual control off, straight to `CONFIRMED`.
  PARTNER_COLLECTION_RECORDED
  /// A second admin confirmed a `PENDING` collection, posting it. Written
  /// inside the same database transaction as the claim and the ledger
  /// posting — never afterwards — so a controller-level failure can never
  /// leave a posted collection with no audit trail, and a retried
  /// confirmation can never produce two of these for one collection.
  PARTNER_COLLECTION_CONFIRMED
  RECONCILIATION_RUN
  /// A customer deleted their own account. Recorded because access ends at
  /// that instant and every subsequent refusal for that user needs an
  /// explanation that is not "the account vanished".
  ACCOUNT_DELETION_REQUESTED
  /// The grace window elapsed and the personal fields were scrubbed. This
  /// entry, and the userId in it, are what remain of the person: enough to
  /// answer "did we delete them, and when", and nothing else.
  ACCOUNT_ANONYMIZED
  /// Spec §33: every step of a PurchaseIntent's life is independently
  /// auditable — who confirmed it, from which branch, against which
  /// commercial snapshot.
  PURCHASE_INTENT_CREATED
  PURCHASE_INTENT_CONFIRMED
  PURCHASE_INTENT_REJECTED
  PURCHASE_INTENT_EXPIRED
  /// The customer withdrew their own purchase before staff acted on it.
  PURCHASE_INTENT_CANCELLED
  /// A partner refunded merchandise value against a confirmed purchase —
  /// see `PurchaseIntentRefundService`. Written by the *approval*, never by
  /// the request: only an approved refund has moved anything.
  PURCHASE_INTENT_REFUNDED
  /// A member of partner staff asked for a refund. No financial effect —
  /// see `PurchaseIntentRefundRequestService`.
  PURCHASE_INTENT_REFUND_REQUESTED
  /// An owner or manager turned a refund request down.
  PURCHASE_INTENT_REFUND_REJECTED
  /// Media system (spec §3.3): every mutation of a brand asset or an avatar
  /// writes one of these, with the actor, the target and the asset id. A
  /// partner's public identity is exactly the kind of thing that must be
  /// reconstructable after the fact — who submitted it, who let it through.
  MEDIA_ASSET_UPLOADED
  MEDIA_ASSET_APPROVED
  MEDIA_ASSET_REPLACED
  MEDIA_ASSET_REVOKED
  /// A customer changed whether their avatar may appear in their direct
  /// referrer's Level-1 list. Audited because it is a consent decision.
  MEDIA_AVATAR_CONSENT_CHANGED
  /// A customer turned personalised nearby-partner recommendations on or
  /// off. Audited for the same reason as the avatar consent above.
  PERSONALIZATION_CONSENT_CHANGED
  /// Fuel-station branches task: an owner/admin put a user in charge of one
  /// of a partner's branches, or took them off it. Deactivation is audited
  /// exactly like assignment — both are the moment access changed.
  BRANCH_STAFF_ASSIGNED
  BRANCH_STAFF_DEACTIVATED
  /// A branch's own scan-to-pay QR was issued, revoked, or rotated
  /// (revoke + issue, recorded as both). See `PartnerBranchQrCode`.
  BRANCH_QR_ISSUED
  BRANCH_QR_REVOKED
}

/// Immutable, append-only system-wide audit trail. Never updated/deleted.
model AuditLog {
  id          String      @id @default(uuid())
  actorUserId String?
  action      AuditAction
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum FraudSignalType {
  VELOCITY_LIMIT_EXCEEDED
  IMPOSSIBLE_TRAVEL
  DEVICE_MISMATCH
  QR_REPLAY_ATTEMPT
  BONUS_ABUSE_PATTERN
  REFERRAL_RING_DETECTED
  /// The ledger and an external statement disagree. Not necessarily fraud —
  /// but never benign, and it blocks payouts until someone has looked.
  SETTLEMENT_DRIFT
}

enum FraudSignalSeverity {
  LOW
  MEDIUM
  HIGH
}

model FraudSignal {
  id                   String              @id @default(uuid())
  userId               String?
  type                 FraudSignalType
  severity             FraudSignalSeverity
  relatedTransactionId String?
  metadata             Json?
  createdAt            DateTime            @default(now())
  resolvedAt           DateTime?
  resolvedByUserId     String?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("fraud_signals")
}

/// When each recurring sweep last completed.
///
/// Deliberately in Postgres rather than Redis. The failure this exists to
/// detect *is* Redis losing state: BullMQ keeps repeatable-job definitions
/// there, so a restart, an eviction or a failover silently removes the whole
/// schedule. Recording the evidence in the same store that can lose it would
/// make the outage invisible in exactly the case that matters.
model SweepRun {
  /// The sweep's name from SWEEPS — one row per definition, upserted.
  name           String   @id
  lastSuccessAt  DateTime
  lastDurationMs Int
  /// False when the run found another worker holding the lock. Still counts
  /// as the schedule being alive, which is what is being watched here.
  didWork        Boolean  @default(true)

  @@map("sweep_runs")
}

// ─────────────────────────────────────────────────────────────────────────
// Media — partner brand assets and customer avatars
// (TUTAK_V2_MEDIA_SYSTEM_SPEC.md §2, 2026-08-23)
// ─────────────────────────────────────────────────────────────────────────

enum MediaAssetKind {
  USER_AVATAR
  PARTNER_LOGO
  PARTNER_COVER
  /// Artwork for one Home "Partner Spotlight" placement (`PartnerPromo`).
  /// Uploaded only by a platform administrator and published on upload:
  /// the two-party rule for logos exists because a partner uploads them;
  /// nobody but an administrator can reach this kind at all.
  PROMO_ARTWORK
}

enum MediaAssetStatus {
  /// Submitted by a partner OWNER, not yet confirmed by a platform
  /// administrator. Never public — spec §1: an owner-account compromise must
  /// not be able to change a public business identity on its own.
  PENDING_REVIEW
  /// The live asset. At most one ACTIVE asset per (owner, kind) is pointed at
  /// by `User.avatarAssetId` / `Partner.logoAssetId` / `Partner.coverAssetId`.
  ACTIVE
  /// Superseded by a newer asset. Deliberately still deliverable: spec §2.2
  /// requires an old operation to keep rendering the brand it was created
  /// under, and that brand is exactly this row.
  REPLACED
  /// Taken down by a platform administrator — the file itself was wrong.
  /// Unlike REPLACED this is NOT publicly deliverable: revocation exists for
  /// the case where the image must stop being shown at all, so a historical
  /// operation falls back to the neutral mark while keeping its snapshotted
  /// display name.
  REVOKED
}

/// An immutable record of one processed, validated image plus its derivatives.
///
/// The bytes are never in PostgreSQL and the source of truth is never a
/// caller-supplied URL — spec §2. What is stored here is metadata plus opaque
/// storage keys the API owns; `MediaStorage` resolves those keys to bytes.
///
/// Rows are never mutated except to move `status` forward
/// (PENDING_REVIEW → ACTIVE → REPLACED/REVOKED) and to stamp the
/// corresponding timestamp. Nothing rewrites `storageKey`, `sha256`, or the
/// dimensions: an operation that snapshotted this asset must be able to
/// render exactly what it snapshotted, for the financial-record retention
/// period.
model MediaAsset {
  id     String           @id @default(uuid())
  kind   MediaAssetKind
  status MediaAssetStatus @default(PENDING_REVIEW)

  /// Set for USER_AVATAR. Null for partner media.
  userId    String?
  /// Set for PARTNER_LOGO / PARTNER_COVER. Null for a user avatar.
  partnerId String?

  /// Opaque key for the processed original inside `MediaStorage`. Never
  /// returned to any client — spec §3.3.
  storageKey   String @unique
  /// 1024px long-edge derivative, spec §3.1.
  displayKey   String @unique
  /// 128px square-ish thumbnail, spec §3.1.
  thumbnailKey String @unique

  /// Dimensions of the *display* derivative, so a client can reserve space.
  width  Int
  height Int

  /// The format actually produced by the server after re-encoding — one of
  /// image/webp or image/png. Never the caller's declared content type; that
  /// is not evidence of anything.
  mimeType String
  /// Byte size of the display derivative.
  byteSize Int
  /// SHA-256 of the accepted original bytes. Deduplication and forensics.
  sha256   String

  uploadedByUserId String?
  approvedByUserId String?

  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  replacedAt DateTime?
  revokedAt  DateTime?

  user       User?    @relation("MediaAssetSubjectUser", fields: [userId], references: [id], onDelete: Cascade)
  partner    Partner? @relation("MediaAssetSubjectPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("MediaAssetUploader", fields: [uploadedByUserId], references: [id])
  approvedBy User?    @relation("MediaAssetApprover", fields: [approvedByUserId], references: [id])

  avatarOfUsers   User[]           @relation("UserAvatarAsset")
  logoOfPartners  Partner[]        @relation("PartnerLogoAsset")
  coverOfPartners Partner[]        @relation("PartnerCoverAsset")
  artworkOfPromos PartnerPromo[]   @relation("PartnerPromoArtwork")
  brandedIntents  PurchaseIntent[] @relation("PurchaseIntentBrandLogo")
  brandedTxns     Transaction[]    @relation("TransactionBrandLogo")

  @@index([partnerId, kind, status])
  @@index([userId, kind, status])
  @@index([status, createdAt])
  @@map("media_assets")
}

/// One alert, kept until a human channel has accepted it.
///
/// Shortening the Redis suppression window after a failed send (audit
/// 21.09.2026, D05) allows the *next* `fire()` through — and for an alert
/// that only ever fires once there is no next one. A dead-lettered outbox
/// event and a dead PSP callback are both terminal states: the row leaves
/// the claim query, nothing looks at it again, and if the channel was down
/// for that one second the alert is gone. The audit of 22.09.2026 confirmed
/// no other mechanism re-detects them.
///
/// So the alert itself is written down before it is sent, and a sweep
/// retries it until the channel answers. Delivery is only ever recorded from
/// the channel's own answer, never from "we tried".
model AlertOutboxEvent {
  id       String @id @default(uuid())
  /// The `Alert.key` — stable per *kind* of alert, not unique here: an alert
  /// suppressed by the Redis window never reaches this table, and one that
  /// legitimately fires again later is a second thing to deliver.
  key      String
  severity String
  title    String
  body     String
  /// `Alert.context`, already scrubbed by the caller.
  context  Json?

  status        AlertDeliveryStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  /// Held by the worker currently sending this one, so two replicas draining
  /// the table do not both deliver it.
  leaseUntil    DateTime?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([key])
  @@map("alert_outbox_events")
}

enum AlertDeliveryStatus {
  /// Not yet accepted by a channel. Retried by `alerts.redeliver` for as long
  /// as it takes — an undelivered critical alert is never dropped on a
  /// schedule.
  PENDING
  /// A channel answered that it accepted the alert.
  DELIVERED
  /// The deployment has no channel that can deliver (the console fallback),
  /// so retrying would be a loop with no receiver. Kept, and visible, rather
  /// than retried.
  UNDELIVERABLE
}

// ─────────────────────────────────────────────────────────────────────────
// Legal documents & consent evidence (package 2026-09-22)
// ─────────────────────────────────────────────────────────────────────────

/// One language of one legal document at one revision, frozen.
///
/// The text itself lives in the repository under
/// `public/legal/documents/<revision>/<language>/<key>.md`; this table is the
/// archive that makes "open exactly the edition you accepted" true rather
/// than intended. A row is written once from the file and never rewritten:
/// `LegalDocumentsService.sync()` refuses to change the content of an
/// existing (document, revision, language) and reports a mismatch instead,
/// because changing a published text is a new revision, not an edit of an
/// old one. That is also what keeps a consent record's `contentHash`
/// resolvable years later — the file may move, the row may not change.
model LegalDocumentRevision {
  id          String    @id @default(uuid())
  documentKey String
  /// Revision id of the whole package, e.g. `0.9-draft-2026-09-22`.
  revision    String
  language    String
  title       String
  /// SHA-256 of `content`, lowercase hex. Quoted back by the client when it
  /// accepts, and checked here — a client cannot invent a hash for a text
  /// that was never published.
  contentHash String
  content     String
  /// True until the owner approves the revision and the publication gate
  /// passes. A draft is never served to the public app.
  isDraft     Boolean   @default(true)
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([documentKey, revision, language])
  @@index([revision])
  @@map("legal_document_revisions")
}

/// What the person was asked, what they chose, and against which exact text.
///
/// Append-only: a revocation is a new row, never an update of the row that
/// records the grant — "отзыв добровольного согласия не изменяет
/// историческую запись о его выдаче" (package §3). Nothing here may carry an
/// OTP, a password, a PIN or a token; `registrationChallengeId` links the
/// choice to the phone confirmation without storing anything secret about
/// it.
model LegalConsentRecord {
  id                      String              @id @default(uuid())
  userId                  String
  purpose                 LegalConsentPurpose
  action                  LegalConsentAction
  /// `[{ documentKey, revision, contentHash, language }]` — every document
  /// whose text this choice was made against, as it was shown.
  documents               Json
  /// Package revision shown at the moment of the choice.
  revision                String
  /// Language the person read, which is not necessarily the interface
  /// language: the app lets them choose when the interface is English.
  language                String
  /// Where the choice was made: `registration`, `settings`, `deletion`, …
  context                 String
  /// Client build that showed the text, when it identified itself.
  appVersion              String?
  /// The confirmed registration challenge this choice belongs to. An opaque
  /// id of the OTP token row — never the code, never a hash of the code.
  registrationChallengeId String?
  /// Set only where a lawful reason for keeping it exists; otherwise null.
  /// Never filled "just in case" — package §3.
  ipAddress               String?
  /// Server time. The only time this table trusts.
  recordedAt              DateTime            @default(now())
  /// Makes a repeated submit idempotent: the same choice from the same
  /// registration or the same settings action collapses to one row instead
  /// of two contradictory ones.
  idempotencyKey          String?             @unique

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, recordedAt])
  @@index([revision])
  @@map("legal_consent_records")
}

enum LegalConsentPurpose {
  /// Mandatory. Terms of use + bonus/cancellation/refund rules.
  TERMS_AND_BONUS_RULES
  /// Mandatory. The necessary processing of personal data described in the
  /// consent text and the privacy policy.
  PERSONAL_DATA_REQUIRED
  /// Voluntary, per channel, offered separately and never bundled.
  MARKETING_SMS
  MARKETING_PUSH
  MARKETING_EMAIL
  /// Voluntary. Mirrors `User.personalizedRecommendationsConsent`.
  PERSONALIZED_RECOMMENDATIONS
  /// Voluntary. Mirrors `User.avatarConsentReferralList`.
  AVATAR_IN_REFERRAL_LIST
  /// Only once the owner approves an 18+ rule. A statement by the person,
  /// not proof of age.
  AGE_CONFIRMATION_18
}

enum LegalConsentAction {
  ACCEPT
  REVOKE
}
