{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@tutak/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ],
      "@tutak/i18n": [
        "../../packages/i18n/src/index.ts"
      ],
      "@tutak/design": [
        "../../packages/design/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
