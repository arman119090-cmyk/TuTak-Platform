# ---------------------------------------------------------------------------
# Demo furniture store — environment template. Copy to .env and adjust.
# Never commit a real .env: it is git-ignored on purpose.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (migrations, seed and runtime).
DATABASE_URL="postgresql://shop:shop@localhost:5432/furniture_shop?schema=public"

# Secret used to sign the session cookie (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to start in production with the demo value below.
# `npm run setup` replaces this placeholder with a unique random value.
AUTH_SECRET="demo-only-secret-change-me-before-any-real-deployment"

# Absolute public origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
# On a hosting provider the real address is only known after the first deploy,
# and NEXT_PUBLIC_* values are baked into the build. SITE_URL is read at run
# time instead (canonical links, robots.txt, sitemap, JSON-LD), so setting it
# needs a restart, not a rebuild. Leave it empty locally.
SITE_URL=""

# ------------------------------- white-label -------------------------------
# The storefront brand is configuration, not code: change these to rebrand the
# whole demo (header, footer, e-mails, metadata, JSON-LD) without touching src/.
NEXT_PUBLIC_BRAND_NAME="Hoviki Mebel"
# The shop name per language. Armenian shops usually write the name in Armenian
# letters for local customers and in Latin for everyone else. Leave a variable
# empty to use NEXT_PUBLIC_BRAND_NAME — that keeps one Latin wordmark everywhere.
NEXT_PUBLIC_BRAND_NAME_HY="Հովիկի Մեբել"
NEXT_PUBLIC_BRAND_NAME_RU="Ховики Мебель"
NEXT_PUBLIC_BRAND_NAME_EN="Hoviki Mebel"
NEXT_PUBLIC_BRAND_TAGLINE_RU="Мебель для настоящей жизни"
# Phone numbers may be written as 091200009, +37491200009 or +374 91 200009 —
# the app normalises them for display and for tel:/WhatsApp links.
NEXT_PUBLIC_BRAND_PHONE="091200009"
NEXT_PUBLIC_BRAND_PHONE_SECONDARY="095200003"
NEXT_PUBLIC_BRAND_EMAIL="info@hoviki-mebel.demo"
NEXT_PUBLIC_BRAND_ADDRESS_RU="Ереван, пр. Маштоца 42"
NEXT_PUBLIC_BRAND_WHATSAPP="+37491200009"
NEXT_PUBLIC_BRAND_TELEGRAM="hoviki_mebel"

# Default currency and locale. Other currencies are supported by the money
# module (see src/lib/money.ts); AMD is the launch currency.
NEXT_PUBLIC_DEFAULT_CURRENCY="AMD"
NEXT_PUBLIC_DEFAULT_LOCALE="ru"

# Demo switches -------------------------------------------------------------
# Enables the demo-only OTP login (fixed code 111111) and the demo credential
# hints in the UI. MUST be 0 for anything resembling production.
NEXT_PUBLIC_DEMO_MODE="1"
# Demo passwords created by the seed. Change them or the seed refuses when
# DEMO_MODE is off.
DEMO_CUSTOMER_PASSWORD="demo1234"
DEMO_ADMIN_PASSWORD="admin1234"

# Failed sign-in attempts allowed per IP per 5 minutes (default 10). The E2E
# suite raises this for its own server; leave it unset in production.
# AUTH_RATE_LIMIT_MAX="10"
