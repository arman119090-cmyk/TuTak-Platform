{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:3000" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "internal": {
      "distribution": "internal",
      "channel": "internal",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://api.staging.cashout.example" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://api.cashout.example" },
      "android": { "buildType": "app-bundle" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
