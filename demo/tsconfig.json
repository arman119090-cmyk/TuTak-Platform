{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@tutak/design": ["vendor/design"],
      "@tutak/i18n": ["vendor/i18n"],
      "@tutak/shared-types": ["vendor/shared-types"],
      "@tutak/observability": ["vendor/observability"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
