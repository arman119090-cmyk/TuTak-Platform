# ─── Required ───
DATABASE_URL="postgresql://lj:lj@localhost:5432/lj"
# ≥32 random chars. Keys every session/token hash — rotating it signs everyone out.
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# Public base URL (canonical URLs, sitemap, payment return URLs).
# On Render it defaults to RENDER_EXTERNAL_URL.
APP_URL="http://localhost:3000"

# ─── Store ───
STORE_NAME="Little Joe Armenia"
# Only set to true once brand authorisation from Drive Int. AG is documented
# AND confirmed in /admin/settings (both are required for "authorised" wording).
BRAND_AUTHORIZED="false"

# Demo mode shows demo products (isDemo), a demo banner, and blocks indexing.
DEMO_MODE="true"
# Seed the demo catalog (pnpm db:seed reads this).
SEED_DEMO="true"

# ─── First admin (created by the seed if missing) ───
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="use-at-least-12-characters"

# ─── Customer sign-in codes ───
# console: printed to server log (dev) · screen: shown on page (DEMO_MODE only)
# resend: emailed via Resend (needs RESEND_API_KEY + EMAIL_FROM). No SMS gateway yet.
AUTH_CODE_DELIVERY="console"
RESEND_API_KEY=""
EMAIL_FROM=""

# ─── Payments ───
# mock: Idram/Telcell/card are simulated by the in-app sandbox (DEMO only in production)
# live: only adapters with credentials AND an implementation are offered.
PAYMENTS_MODE="mock"
MOCK_PAYMENT_SECRET=""
IDRAM_REC_ACCOUNT=""
IDRAM_SECRET_KEY=""
IDRAM_PAYMENT_URL="https://banking.idram.am/Payment/GetPayment"
TELCELL_SHOP_ID=""
TELCELL_SHOP_KEY=""
TELCELL_API_URL=""
CARD_ACQUIRER_API_URL=""
CARD_ACQUIRER_USERNAME=""
CARD_ACQUIRER_PASSWORD=""
# Minutes an unpaid online order holds stock.
RESERVATION_TTL_MINUTES="30"
# Bearer secret for POST /api/cron/expire
CRON_SECRET=""

# ─── Media storage ───
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ─── SEO ───
GOOGLE_SITE_VERIFICATION=""
# GA4 / Meta Pixel / TikTok Pixel IDs are set in /admin/settings (analytics).
