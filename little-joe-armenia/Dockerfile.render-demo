# Self-contained DEMO image for Render's free plan when no free Postgres slot
# is available: PostgreSQL runs inside the same container as the app.
#
# !! Data is EPHEMERAL: the free instance sleeps after ~15 min idle and every
# restart starts from a freshly seeded demo database. Never use for real
# orders — use render.yaml (managed Postgres) for that. docs/DEPLOYMENT.md.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

ENV NODE_ENV=production
CMD ["sh", "scripts/render-demo-start.sh"]
