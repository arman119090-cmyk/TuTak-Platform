{
  "name": "tutak-platform",
  "version": "0.1.0",
  "private": true,
  "description": "TuTak — loyalty ecosystem for Armenia (QR payments, bonuses, EV charging, partner network).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "prisma:generate": "pnpm --filter @tutak/api prisma:generate",
    "prisma:migrate": "pnpm --filter @tutak/api prisma:migrate",
    "prisma:seed": "pnpm --filter @tutak/api prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright": "1.56.1",
    "prettier": "^3.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-web": "^0.21.2",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
