{
  "name": "@tutak/design",
  "version": "0.1.0",
  "private": true,
  "description": "TuTak design system — tokens, brand assets and the shared visual language for the mobile app and both dashboards.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts",
    "./security-headers": "./security-headers.mjs",
    "./tutak.css": "./tutak.css",
    "./theme.css": "./src/web/theme.css",
    "./brand/*": "./src/brand/*"
  },
  "scripts": {
    "build:css": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test security-headers.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tutak/shared-types": "workspace:*",
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "@types/react": "~19.2.2",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
