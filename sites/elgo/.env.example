# Скопируйте в .env для локального запуска. В репозиторий .env НЕ коммитится.
# На Render/Railway эти переменные задаются в панели сервиса.

# Публичный адрес сайта (canonical, hreflang, sitemap, OG).
SITE_URL=https://elgo.am

# Telegram-бот, в который приходят заявки. Токен — от @BotFather.
TELEGRAM_BOT_TOKEN=
# ID чата/группы, куда бот пишет. Бот должен быть добавлен в этот чат.
TELEGRAM_CHAT_ID=

# 1 — не отправлять в Telegram, только печатать заявку в лог сервера.
# Только для локальной разработки. В проде не включать.
LEAD_DRY_RUN=0

# Имя заголовка, в который платформа кладёт реальный IP клиента (для лимита
# частоты). Пусто — последний адрес X-Forwarded-For.
CLIENT_IP_HEADER=
