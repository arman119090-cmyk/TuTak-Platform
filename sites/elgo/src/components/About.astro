---
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos';
import { company } from '../config';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const aboutImage = photo('about');
const isPlaceholder = (s: string) => /^\[.*\]$/.test(s.trim());

// Реквизиты. ՀՎՀՀ и лицензия — только когда подтверждены (не null).
// Номер банковского счёта сюда НЕ добавлять (BRIEF.md, п. 2).
const rows = [
  { label: d.about.legalName, value: company.legalName[locale] },
  { label: d.about.director, value: company.director[locale] },
  {
    label: d.about.registration,
    value: d.about.registrationValue
      .replace('{number}', company.registration.number)
      .replace('{date}', company.registration.date),
  },
  ...(company.taxId ? [{ label: d.about.taxId, value: company.taxId }] : []),
  ...(company.license ? [{ label: d.about.license, value: company.license }] : []),
];
---

<section class="section section--dark" id="about" aria-labelledby="about-title">
  <div class:list={['container grid', { 'grid--text': !aboutImage }]}>
    {aboutImage ? (
      <div class="media" data-reveal>
        <Picture
          src={aboutImage}
          alt={d.about.imageAlt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          class="img"
        />
      </div>
    ) : (
      <div class="lead-col" data-reveal>
        <span class="eyebrow">{d.about.eyebrow}</span>
        <h2 class="h2" id="about-title">{d.about.title}</h2>
        <p class:list={['text', { placeholder: isPlaceholder(d.about.text) }]}>{d.about.text}</p>
      </div>
    )}
    <div class="body" data-reveal>
      {aboutImage && (
        <>
          <span class="eyebrow">{d.about.eyebrow}</span>
          <h2 class="h2" id="about-title">{d.about.title}</h2>
          <p class:list={['text', { placeholder: isPlaceholder(d.about.text) }]}>{d.about.text}</p>
        </>
      )}

      <h3 class="req-title">{d.about.requisites}</h3>
      <dl class="req">
        {rows.map((r) => (
          <div class="row">
            <dt class="muted">{r.label}</dt>
            <dd>{r.value}</dd>
          </div>
        ))}
      </dl>
      <p class="note muted">{d.about.paymentNote}</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 96px;
    align-items: start;
  }

  .media :global(.img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .text {
    margin-top: 32px;
    font-size: 19px;
    color: var(--muted-dark);
    max-width: 560px;
  }

  .grid--text .body {
    padding-top: 8px;
  }

  .grid--text .req-title {
    margin-top: 0;
  }

  .req-title {
    margin-top: 64px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--brass);
  }

  .req {
    margin: 20px 0 0;
    border-top: 1px solid var(--line-dark);
  }

  .row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: 15px;
  }

  .row dd {
    margin: 0;
  }

  .note {
    margin-top: 24px;
    font-size: 14px;
    max-width: 560px;
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .media :global(.img) {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 767px) {
    .row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
