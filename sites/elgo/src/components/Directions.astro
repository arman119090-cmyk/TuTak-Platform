---
import { Picture } from 'astro:assets';
import { photo, type PhotoSlot } from '../lib/photos';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
// Порядок совпадает с d.directions.items и BRIEF.md, п. 3.
const slots: PhotoSlot[] = [
  'direction-residential',
  'direction-commercial',
  'direction-renovation',
  'direction-infrastructure',
];
const images = slots.map((s) => photo(s));
// Фото показываем, только если есть все четыре: ряд из фото и пустот смотрится хуже, чем ряд без фото.
const withPhotos = images.every(Boolean);
---

<section class="section section--dark" id="directions" aria-labelledby="directions-title">
  <div class="container">
    <div class="head" data-reveal>
      <div>
        <span class="eyebrow">{d.directions.eyebrow}</span>
        <h2 class="h2" id="directions-title">{d.directions.title}</h2>
      </div>
      <p class="intro muted">{d.directions.intro}</p>
    </div>

    <ol class:list={['grid', { 'grid--photos': withPhotos }]}>
      {d.directions.items.map((item, i) => (
        <li class="item" data-reveal style={`transition-delay: ${i * 90}ms`}>
          {withPhotos && (
            <div class="media">
              <Picture
                src={images[i]!}
                alt={item.alt}
                formats={['avif', 'webp']}
                widths={[360, 540, 720, 960]}
                sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                class="img"
              />
            </div>
          )}
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="title">{item.title}</h3>
          <p class="text muted">{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 64px;
    align-items: end;
    margin-bottom: 96px;
  }

  .intro {
    max-width: 440px;
    justify-self: end;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    position: relative;
    padding: 40px 28px 8px;
    border-top: 1px solid var(--line-dark);
    border-left: 1px solid var(--line-dark);
  }

  .item:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .item:last-child {
    padding-right: 0;
  }

  /* Латунная линия по верхней границе при наведении. */
  .item::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    height: 1px;
    width: 0;
    background: var(--brass);
    transition: width 0.6s var(--ease);
  }

  .item:hover::before {
    width: 100%;
  }

  .media {
    overflow: hidden;
    margin-bottom: 32px;
  }

  .media :global(.img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }

  .item:hover .media :global(.img) {
    transform: scale(1.04);
  }

  .num {
    display: block;
    font-family: var(--font-head);
    font-size: 88px;
    font-weight: 500;
    line-height: 0.9;
    color: var(--brass);
    margin-bottom: 48px;
  }

  .grid--photos .num {
    font-size: 15px;
    font-family: var(--font-body);
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .title {
    font-size: 28px;
    line-height: 1.15;
    margin-bottom: 16px;
  }

  :global(:lang(hy)) .title {
    font-size: 21px;
    line-height: 1.35;
  }

  .text {
    font-size: 15px;
    line-height: 1.65;
  }

  @media (prefers-reduced-motion: reduce) {
    .item::before,
    .media :global(.img) {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    .head {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 56px;
    }
    .intro {
      justify-self: start;
    }
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .item:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .item:nth-child(2) {
      padding-right: 0;
    }
    .item {
      padding-bottom: 48px;
    }
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .item,
    .item:nth-child(n) {
      border-left: 0;
      padding: 32px 0 40px;
    }
    .num {
      font-size: 64px;
      margin-bottom: 28px;
    }
    .media :global(.img) {
      aspect-ratio: 3 / 2;
    }
  }
</style>
