---
import { Picture } from 'astro:assets';
import heroImage from '../assets/photos/placeholder-hero.jpg';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section class="hero" id="top">
  <Picture
    src={heroImage}
    alt={d.hero.imageAlt}
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1920, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-img"
  />
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container hero-content">
    <span class="eyebrow">{d.hero.eyebrow}</span>
    <h1 class="hero-title">{d.hero.title}</h1>
    <p class="hero-lead">{d.hero.lead}</p>
  </div>

  <div class="container hero-strip-wrap">
    <ol class="hero-strip">
      {d.directions.items.map((item, i) => (
        <li>
          <a href="#directions">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="label">{item.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--stone);
    background: var(--graphite);
    overflow: hidden;
  }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero :global(picture) {
    position: absolute;
    inset: 0;
  }

  /* Затемнение — ровным слоем, не градиентом. */
  .hero-shade {
    position: absolute;
    inset: 0;
    background: rgba(15, 15, 18, 0.55);
  }

  .hero-content {
    position: relative;
    padding-top: calc(var(--header-h) + 96px);
    padding-bottom: 72px;
  }

  .hero-title {
    max-width: 14ch;
    font-size: clamp(48px, 7.2vw, 104px);
    font-weight: 500;
    line-height: 0.98;
  }

  :global(:lang(hy)) .hero-title {
    max-width: 18ch;
    font-size: clamp(36px, 5.2vw, 76px);
    line-height: 1.12;
  }

  .hero-lead {
    margin-top: 32px;
    max-width: 560px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted-dark);
  }

  .hero-strip-wrap {
    position: relative;
  }

  .hero-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(207, 201, 190, 0.3);
  }

  .hero-strip li + li {
    border-left: 1px solid rgba(207, 201, 190, 0.3);
  }

  .hero-strip a {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 28px 24px 36px;
    text-decoration: none;
    color: var(--stone);
    transition: color 0.2s var(--ease);
  }

  .hero-strip li:first-child a {
    padding-left: 0;
  }

  .hero-strip a:hover .label {
    color: var(--brass);
  }

  .num {
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--brass);
  }

  .label {
    font-size: 15px;
    line-height: 1.4;
  }

  @media (max-width: 1023px) {
    .hero-strip {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-strip li:nth-child(3) {
      border-left: 0;
    }
    .hero-strip li:nth-child(n + 3) {
      border-top: 1px solid rgba(207, 201, 190, 0.3);
    }
    .hero-strip li:nth-child(3) a {
      padding-left: 0;
    }
  }

  @media (max-width: 767px) {
    .hero-content {
      padding-top: calc(var(--header-h) + 64px);
      padding-bottom: 48px;
    }
    .hero-lead {
      font-size: 17px;
    }
    .hero-strip a {
      padding: 18px 12px 22px;
      gap: 10px;
    }
    .label {
      font-size: 14px;
    }
  }
</style>
