---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { t } from '../i18n';

// Язык 404 угадываем по пути, иначе армянский.
const seg = Astro.url.pathname.split('/')[1];
const locale = seg === 'ru' || seg === 'en' ? seg : 'hy';
const d = t(locale);
---

<Base locale={locale} path="/" title={`${d.notFound.title} — ElGo`} description={d.meta.description} noindex>
  <Header locale={locale} path="/" />
  <main id="main" class="nf">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>{d.notFound.title}</h1>
      <a class="btn" href={`/${locale}/`}>{d.notFound.back}</a>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: var(--header-h);
  }
  h1 {
    font-size: clamp(40px, 6vw, 88px);
    margin-bottom: 40px;
  }
</style>
