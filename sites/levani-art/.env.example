# Public origin, no trailing slash. Used for canonical URLs, hreflang,
# sitemap.xml and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where enquiries go (src/lib/enquiry-transport.ts).
#   webhook  POST JSON to ENQUIRY_WEBHOOK_URL (Zapier / Make / CRM / email relay)
#   log      print to the server log — ignored in production
# Leave empty and the form tells visitors online enquiries are not connected.
ENQUIRY_TRANSPORT=
ENQUIRY_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" to the webhook.
ENQUIRY_WEBHOOK_SECRET=

# Captcha hook (src/lib/enquiry-transport.ts → verifyCaptcha). Setting this
# without wiring a provider makes every enquiry fail — on purpose.
CAPTCHA_SECRET=
