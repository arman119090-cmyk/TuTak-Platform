# Public origin, no trailing slash. Read at BUILD time for canonical URLs,
# hreflang, sitemap.xml and Open Graph images — rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://levani-art.onrender.com

# Optional. Any URL that accepts the enquiry as a JSON POST (Formspree, CRM
# hook, serverless function). Unset = enquiries go to Instagram, no form.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
