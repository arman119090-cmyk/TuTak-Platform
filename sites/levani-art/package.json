{
  "name": "levani-art",
  "version": "0.1.0",
  "private": true,
  "description": "LEVANI ART — private art gallery website (Next.js App Router, six locales).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "images": "node scripts/build-images.mjs",
    "dev": "node scripts/build-images.mjs && next dev",
    "build": "node scripts/build-images.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-armenian": "5.3.0",
    "@fontsource-variable/noto-serif-armenian": "5.3.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "5.0.1"
  }
}
